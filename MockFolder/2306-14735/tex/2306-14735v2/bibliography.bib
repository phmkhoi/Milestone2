journal = {Nature Human Behaviour},
mendeley-groups = {antoinio},
number = {1},
pages = {82--91},
pmid = {30932052},
publisher = {Nature Publishing Group},
title = {{The universal decay of collective memory and attention}},
volume = {3},
year = {2019}
}
