	date-modified = {2021-12-01 21:42:22 +0100},
	eprint = {1405.6730},
	journal = {\mnras},
	keywords = {accretion, accretion discs, dense matter, hydrodynamics, neutrinos, stars: neutron},
	month = oct,
	owner = {ojust},
	pages = {3134-3156},
	primaryclass = {astro-ph.HE},
	timestamp = {2014.08.20},
