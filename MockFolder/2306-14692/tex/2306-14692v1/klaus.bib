@incollection{bartels2006relaxation,
	abstract = {We address the numerical analysis of relaxed formulations for scalar
	and vectorial nonconvex variational problems originating from models
	for solid-solid phase transitions and crystal plasticity.We discuss
	algorithms for the approximation of the quasiconvex envelope using
	laminates, rank-one convexity, and polyconvexity, and present some
	numerical applications to benchmarks problems, and to a model for
	single-slip crystal plasticity.},
	address = {Berlin, Heidelberg},
	author = {Bartels, S�ren and Carstensen, Carsten and Conti, Sergio and Hackl, Klaus and Hoppe, Ulrich and Orlando, Antonio},
	booktitle = {Analysis, modeling and simulation of multiscale problems},
	doi = {10.1007/3-540-35657-6},
