	keywords = {Polycrystalline shape memory alloys, Functional fatigue, Combined Voigt/Reu{\ss} energy bound},
	pages = {110 - 121},
	title = {A coupled dissipation functional for modeling the functional fatigue in polycrystalline shape memory alloys},
	url = {http://www.sciencedirect.com/science/article/pii/S0997753815001011},
