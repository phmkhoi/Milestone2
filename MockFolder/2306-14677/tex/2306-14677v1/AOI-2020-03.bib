	journal = IT,
	keywords = {information theory;queueing theory;M-M-? queue;M-M-1 queue;M-M-2 queue;analytical status age;dynamic network;message transmission path diversity;multihop path;Delays;Monitoring;Out of order;Receivers;Servers;Silicon;Status age;dynamic networks;monitoring},
	month = mar,
