	issn = {1550-3607},
	keywords = {channel estimation;Markov processes;radio links;finite-state Markov model;outdated channel information;nonreciprocal wireless link;finite-state Markov channel;channel estimation error;periodic feedback;utility function;Rayleigh fading;channel adaptation functions;feedback protocols;Signal to noise ratio;Channel estimation;Markov processes;Fading;Tin;Channel models;Steady-state},
	month = {June},
