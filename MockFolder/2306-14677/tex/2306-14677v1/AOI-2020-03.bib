	keywords = {game theory;probability;wireless LAN;DSRC network;WiFi network;Wireless fidelity;Games;Throughput;Conferences;Wireless communication;FCC;Safety},
	month = {April},
	pages = {565-570},
	title = {A game theoretic approach to {DSRC} and {WiFi} coexistence},
	year = {2018},
	bdsk-url-1 = {https://doi.org/10.1109/INFCOMW.2018.8406967}}

@inproceedings{He-YE-wiopt2016,
	abstract = {There is a growing interest in age of information, which is a newly introduced metric that measures the freshness of information in communication systems. We investigate the age of information in wireless networks and propose the novel approach of optimizing the scheduling strategy to deliver the information as timely as possible. We consider a set of links that share a common channel, each containing a number of packets with time stamps, and address the scheduling problem with the objective of minimizing the overall information age. We model this problem mathematically and prove it is NP-hard in general. Fundamental insights including tractable cases and optimality conditions are presented. An integer linear programming formulation is provided for performance benchmarking. Moreover, a steepest age decent algorithm with better scalability is developed. Numerical study shows that, by employing the optimal schedule, the overall information age is significantly reduced in comparison to other scheduling strategies.},
	author = {Q. He and D. Yuan and A. Ephremides},
	booktitle = {2016 14th International Symposium on Modeling and Optimization in Mobile, Ad Hoc, and Wireless Networks (WiOpt)},
	date-added = {2018-08-13 16:53:08 -0400},
	date-modified = {2018-08-13 16:54:12 -0400},
	doi = {10.1109/WIOPT.2016.7492912},
	keywords = {integer programming;linear programming;radio networks;telecommunication scheduling;minimum age link scheduling;wireless networks;NP-hard problem;integer linear programming formulation;steepest age decent algorithm;Transmitters;Optimal scheduling;Schedules;Wireless networks;Scheduling;Age of information;link scheduling;optimization;wireless networks},
	month = {May},
	pages = {1-8},
	title = {Optimizing freshness of information: On minimum age link scheduling in wireless systems},
	year = {2016},
	bdsk-url-1 = {https://doi.org/10.1109/WIOPT.2016.7492912}}

@inproceedings{Hsu-MD-isit2017,
	abstract = {Age of information is a newly proposed metric that captures delay from an application layer perspective. The age measures the amount of time that elapsed from the moment the mostly recently received update was generated until the present time. In this paper, we study an age minimization problem over a wireless broadcast network with many users, where only one user can be served at a time. We formulate a Markov decision process (MDP) to find dynamic transmission scheduling schemes, with the purpose of minimizing the long-run average age. While showing that an optimal scheduling algorithm for the MDP is a simple stationary switch-type, we propose a sequence of finite-state approximations for our infinite-state MDP and prove its convergence. We then propose both optimal off-line and online scheduling algorithms for the finite-approximate MDPs, depending on knowledge of time-varying arrivals.
},
	author = {Y. Hsu and E. Modiano and L. Duan},
	booktitle = {2017 IEEE International Symposium on Information Theory (ISIT)},
	date-added = {2018-08-13 16:09:59 -0400},
	date-modified = {2018-08-13 16:10:43 -0400},
	doi = {10.1109/ISIT.2017.8006590},
	issn = {2157-8117},
	keywords = {Markov processes;radio networks;scheduling;telecommunication network management;optimal scheduling algorithms;information age measure;application layer perspective;wireless broadcast network;Markov decision process;transmission scheduling scheme;infinite-state MDP;finite-approximate MDP;Scheduling algorithms;Optimal scheduling;Algorithm design and analysis;Delays;Markov processes;Wireless communication;Information theory},
