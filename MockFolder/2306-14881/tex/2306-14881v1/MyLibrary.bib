}

@article{gronke_lyman-alpha_2020,
	title = {Lyman-alpha transmission properties of the intergalactic medium in the {CoDaII} simulation},
	url = {http://arxiv.org/abs/2004.14496},
	abstract = {The decline in abundance of Lyman-α (Lyα) emitting galaxies at z 6 is a powerful and commonly used probe to constrain the progress of cosmic reionization. We use the CoDaII simulation, which is a radiation hydrodynamic simulation featuring a box of ∼ 94 comoving Mpc side length, to compute the Lyα transmission properties of the intergalactic medium (IGM) at z ∼ 5.8 to 7. Our results mainly conﬁrm previous studies, i.e., we ﬁnd a declining Lyα transmission with redshift and a large sightlineto-sightline variation. However, motivated by the recent discovery of blue Lyα peaks at high redshift, we also analyze the IGM transmission on the blue side, which shows a rapid decline at z 6 of the blue transmission. This low transmission can be attributed not only to the presence of neutral regions but also to the residual neutral hydrogen within ionized regions, for which a density even as low as nHI ∼ 10−9 cm−3 (sometimes combined with kinematic eﬀects) leads to a signiﬁcantly reduced visibility. Still, we ﬁnd that ∼ 5\% of sightlines towards M1600AB ∼ −21 galaxies at z ∼ 7 are transparent enough to allow a transmission of a blue Lyα peak. We discuss our results in the context of the interpretation of observations.},
	language = {en},
	urldate = {2020-05-01},
	journal = {arXiv:2004.14496 [astro-ph]},
	author = {Gronke, Max and Ocvirk, Pierre and Mason, Charlotte and Matthee, Jorryt and Bosman, Sarah E. I. and Sorce, Jenny G. and Lewis, Joseph and Ahn, Kyungjin and Aubert, Dominique and Dawoodbhoy, Taha and Iliev, Ilian T. and Shapiro, Paul R. and Yepes, Gustavo},
	month = apr,
	year = {2020},
	note = {arXiv: 2004.14496},
	keywords = {Astrophysics - Astrophysics of Galaxies},
	file = {Gronke et al. - 2020 - Lyman-alpha transmission properties of the interga.pdf:/local/home/lramambason/Zotero/storage/EUMY3PU6/Gronke et al. - 2020 - Lyman-alpha transmission properties of the interga.pdf:application/pdf}
}

@article{puschnig_lyman_2020,
	title = {The {Lyman} {Alpha} {Reference} {Sample} {XI}: {Efficient} {Turbulence} {Driven} {Ly}\{{\textbackslash}alpha\} {Escape} and the {Analysis} of {IR}, {CO} and [{C} {II}]158 \{{\textbackslash}mu\}m},
	shorttitle = {The {Lyman} {Alpha} {Reference} {Sample} {XI}},
	url = {http://arxiv.org/abs/2004.09142},
	abstract = {We study the global dust and (molecular) gas content in the Lyman Alpha Reference Sample (LARS), i.e. 14 local star-forming galaxies. We characterize their interstellar medium and relate newly derived properties to quantities relevant for Ly\${\textbackslash}alpha\$ escape. We observed LARS galaxies with Herschel/PACS, SOFIA/FIFI-LS, the IRAM 30m telescope and APEX, targeting far-infrared (FIR) continuum and emission lines of [C II]158\${\textbackslash}mu\$m, [O I]63\${\textbackslash}mu\$m, [O III]88\${\textbackslash}mu\$m and low-J CO lines. Using Bayesian methods we derive dust model parameters and estimate total gas masses for all LARS galaxies, taking into account a metallicity-dependent gas-to-dust ratio. Star formation rates were estimated from FIR, [C II]158\${\textbackslash}mu\$m and [O I]63\${\textbackslash}mu\$m luminosities. LARS covers a wide dynamic range in the derived properties, with FIR-based star formation rates from \${\textbackslash}sim\$0.5-100 \$M\_\{{\textbackslash}odot\}{\textbackslash} yr{\textasciicircum}\{-1\}\$, gas fractions between \${\textbackslash}sim\$15-80\% and gas depletion times ranging from a few hundred Myr up to more than 10 Gyr. The distribution of LARS galaxies in the \${\textbackslash}Sigma\_\{gas\}\$ vs. \${\textbackslash}Sigma\_\{SFR\}\$ (Kennicutt-Schmidt plane) is thus quite heterogeneous. However, we find that LARS galaxies with the longest gas depletion times, i.e. relatively high gas surface densities (\${\textbackslash}Sigma\_\{gas\}\$) and low star formation rate densities (\${\textbackslash}Sigma\_\{SFR\}\$), have by far the highest Ly\${\textbackslash}alpha\$ escape fraction. A strong \${\textbackslash}sim\$linear relation is found between Ly\${\textbackslash}alpha\$ escape fraction and the total gas (HI+H\$\_2\$) depletion time. We argue that the Ly\${\textbackslash}alpha\$ escape in those galaxies is driven by turbulence in the star-forming gas that shifts the Ly\${\textbackslash}alpha\$ photons out of resonance close to the places where they originate. We further report on an extreme [C II]158\${\textbackslash}mu\$m excess in LARS 5, corresponding to \${\textbackslash}sim\$14\${\textbackslash}pm\$3\% of the FIR luminosity, i.e. the most extreme [C II]-to-FIR ratio observed in a non-AGN galaxy to date.},
	language = {en},
	urldate = {2020-05-01},
	journal = {arXiv:2004.09142 [astro-ph]},
	author = {Puschnig, J. and Hayes, M. and Östlin, G. and Cannon, J. and Smirnova-Pinchukova, I. and Husemann, B. and Kunth, D. and Bridge, J. and Herenz, E. C. and Messa, M. and Oteo, I.},
	month = apr,
	year = {2020},
	note = {arXiv: 2004.09142},
	keywords = {Astrophysics - Astrophysics of Galaxies, [CII]158um, [OIII]88um, Lyman alpha, [OI]63um, CO lines},
	file = {Puschnig et al. - 2020 - The Lyman Alpha Reference Sample XI Efficient Tur.pdf:/local/home/lramambason/Zotero/storage/EP52JDX7/Puschnig et al. - 2020 - The Lyman Alpha Reference Sample XI Efficient Tur.pdf:application/pdf}
}
