	file = {Anders and Grevesse - 1989 - Abundances of the elements Meteoritic and solar.pdf:/local/home/lramambason/Zotero/storage/LCCGW2QV/Anders and Grevesse - 1989 - Abundances of the elements Meteoritic and solar.pdf:application/pdf}
}
