	author = {Lee, Minju M. and Nagao, Tohru and De Breuck, Carlos and Carniani, Stefano and Cresci, Giovanni and Hatsukade, Bunyo and Kawabe, Ryohei and Kohno, Kotaro and Maiolino, Roberto and Mannucci, Filippo and Marconi, Alessandro and Nakanishi, Kouichiro and Troncoso, Paulina and Umehata, Hideki},
	month = feb,
	year = {2021},
	note = {arXiv: 2102.09219},
	keywords = {Astrophysics - Astrophysics of Galaxies},
	file = {Lee et al. - 2021 - Dense and warm neutral gas in BR1202-0725 at z = 4.pdf:/local/home/lramambason/Zotero/storage/CRLIVG22/Lee et al. - 2021 - Dense and warm neutral gas in BR1202-0725 at z = 4.pdf:application/pdf}
