	journal = {arXiv:2101.00727 [astro-ph]},
	author = {Bassett, R. and Ryan-Weber, E. V. and Cooke, J. and Meštrić, U. and Kakiichi, K. and Prichard, L. and Rafelski, M.},
	month = jan,
	year = {2021},
	note = {arXiv: 2101.00727},
	keywords = {Astrophysics - Astrophysics of Galaxies},
	file = {Bassett et al. - 2021 - IGM Transmission Bias for \$z\$ \$geq\$ 2.9 Lyman Con.pdf:/local/home/lramambason/Zotero/storage/S273RN6C/Bassett et al. - 2021 - IGM Transmission Bias for \$z\$ \$geq\$ 2.9 Lyman Con.pdf:application/pdf}
