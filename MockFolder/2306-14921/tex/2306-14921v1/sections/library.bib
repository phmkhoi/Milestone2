	address = {Aachen},
	title = {Bert with {Dynamic} {Masked} {Softmax} and {Pseudo} {Labeling} for {Hierarchical} {Product} {Classification}},
	volume = {2720},
	url = {http://ceur-ws.org/Vol-2720/paper6.pdf},
	abstract = {Hierarchical product classification (HPC) aims to assign predefined product categories stored in a hierarchical structure to product instances. Categories at different levels of a product tend to have dependencies. However, most previous studies either decompose the original problem into a set of flat classification sub-problems or deal with all categories simultaneously, lacking a focus on the dependencies among different category levels. In this paper, we propose a BERT-based ensemble model to address the HPC challenge in SWC2020–MWPD Task 2. We devise a masked matrix for each category level based on the hierarchical category structure, which can dynamically filter out the child categories unrelated to the current parent category and eliminate the negative effect of category inconsistency. Further through a two-level ensemble strategy and pseudo labeling, our team Rhinobird wins first place with a weighted-average macro-F1 score of 88.62 on the testing dataset. Our source code is publicly available on Github.},
	booktitle = {{CEUR} {Workshop} {Mining} the {Web} of {HTML}-embedded {Product} {Data}},
	publisher = {RWTH},
	author = {Yang, L. and Shijia, E. and Xu, Shiyao and Xiang, Yang},
	month = nov,
	year = {2020},
}

