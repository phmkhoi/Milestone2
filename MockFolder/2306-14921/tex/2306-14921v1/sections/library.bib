@misc{reimers_curse_2021,
	title = {The {Curse} of {Dense} {Low}-{Dimensional} {Information} {Retrieval} for {Large} {Index} {Sizes}},
	url = {http://arxiv.org/abs/2012.14210},
	abstract = {Information Retrieval using dense lowdimensional representations recently became popular and showed out-performance to traditional sparse-representations like BM25. However, no previous work investigated how dense representations perform with large index sizes. We show theoretically and empirically that the performance for dense representations decreases quicker than sparse representations for increasing index sizes. In extreme cases, this can even lead to a tipping point where at a certain index size sparse representations outperform dense representations. We show that this behavior is tightly connected to the number of dimensions of the representations: The lower the dimension, the higher the chance for false positives, i.e. returning irrelevant documents.},
