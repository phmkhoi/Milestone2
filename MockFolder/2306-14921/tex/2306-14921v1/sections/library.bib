	keywords = {Extreme multi-label classification, label features, label metadata, large-scale learning, product to product recommendation},
	pages = {3721--3732},
	file = {Full Text PDF:C\:\\Users\\alebrink\\Zotero\\storage\\9TSWAXZU\\Mittal et al. - 2021 - ECLARE Extreme Classification with Label Graph Co.pdf:application/pdf},
