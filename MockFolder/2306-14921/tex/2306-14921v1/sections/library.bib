	month = jun,
	year = {2019},
	note = {arXiv: 1810.04805},
	keywords = {Computer Science - Computation and Language},
	pages = {4171--4186},
	file = {arXiv Fulltext PDF:C\:\\Users\\alebrink\\Zotero\\storage\\26EQUHEN\\Devlin et al. - 2019 - BERT Pre-training of Deep Bidirectional Transform.pdf:application/pdf;arXiv.org Snapshot:C\:\\Users\\alebrink\\Zotero\\storage\\QKN5DZFI\\1810.html:text/html},
