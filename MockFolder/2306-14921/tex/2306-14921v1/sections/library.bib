	author = {Zhao, Jing and Wang, Jingya and Sigdel, Madhav and Zhang, Bopeng and Hoang, Phuong and Liu, Mengshu and Korayem, Mohammed},
	month = jul,
	year = {2021},
	note = {arXiv: 2107.00221},
	keywords = {Computer Science - Information Retrieval},
	annote = {Comment: 8 pages},
	file = {arXiv Fulltext PDF:C\:\\Users\\alebrink\\Zotero\\storage\\RIBPHFFP\\Zhao et al. - 2021 - Embedding-based Recommender System for Job to Cand.pdf:application/pdf;arXiv.org Snapshot:C\:\\Users\\alebrink\\Zotero\\storage\\ZG9ISA7E\\2107.html:text/html},
