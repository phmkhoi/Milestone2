	year = {2019},
	keywords = {Machine learning, CNN, HAN, Linked data, LSTM, Neural networks, Product classification},
	pages = {716--732},
	file = {Springer Full Text PDF:C\:\\Users\\alebrink\\Zotero\\storage\\RI3JN86Q\\Zhang and Paramita - 2019 - Product Classification Using Microdata Annotations.pdf:application/pdf},
}

