	note = {Conference Name: 47th International Conference on Very Large Data Bases 2021
ISSN: 2150-8097
Issue: 6
Meeting Name: 47th International Conference on Very Large Data Bases 2021
Number: 6
Pages: 1033-1039
Place: Copenhagen, Denmark
Publisher: VLDB Endowment
Volume: 14},
	file = {Full Text PDF:C\:\\Users\\alebrink\\Zotero\\storage\\YZXMA7NP\\Thorne et al. - 2021 - From natural language processing to neural databas.pdf:application/pdf;Snapshot:C\:\\Users\\alebrink\\Zotero\\storage\\ME8SRDLV\\10125401.html:text/html},
