	Keywords = {ISM: individual objects: NGC 6334I, ISM: magnetic fields, masers, radio continuum: ISM, stars: formation, stars: protostars},
	Month = feb,
	Pages = {170},
	Primaryclass = {astro-ph.SR},
	Title = {{The Extraordinary Outburst in the Massive Protostellar System NGC 6334I-MM1: Emergence of Strong 6.7 GHz Methanol Masers}},
