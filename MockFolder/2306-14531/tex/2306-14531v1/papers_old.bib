	Author = {{Manthey}, E. and {H{\"u}ttemeister}, S. and {Aalto}, S. and {Horellou}, C. and {Bjerkeli}, P.},
	Date-Added = {2015-09-04 13:01:41 +0000},
	Date-Modified = {2015-09-04 13:01:41 +0000},
	Doi = {10.1051/0004-6361:200810408},
	Eprint = {0808.3883},
	Journal = {\aap},
	Keywords = {galaxies: interactions, galaxies: starburst, galaxies: individual: NGC 4194, radio lines: galaxies, radio lines: ISM},
	Month = nov,
