	Doi = {10.1093/mnras/stx3070},
	Eprint = {1711.05910},
	Journal = {\mnras},
	Keywords = {accretion, accretion discs, magnetic fields, MHD, stars: formation, stars: massive, ISM: jets and outflows},
	Month = mar,
	Pages = {391-403},
	Primaryclass = {astro-ph.SR},
	Title = {{Massive outflows driven by magnetic effects - II. Comparison with observations}},
	Volume = 475,
