@article{Rieke:1985lr,
	Abstract = {Measurements from 1 to 13 mum are reported for omicr Sco and for stars in the galactic center. The interstellar extinction law toward these sources and toward VI Cyg No. 12 is the same from 1 to 13 mum. An improved estimate of the extinction law beyond 3 mum is presented, including an improved ratio of total to selective extinction, R ≈ 3.09$\pm$0.03, and an improved ratio of total extinction to optical depth in the 10 mum silicate absorption, Av/tauSi = 16.6$\pm$2.1.},
