	Journal = {\aap},
	Keywords = {astrochemistry, line: formation, ISM: abundances, ISM: molecules, submillimeter: ISM, molecular processes},
	Month = jul,
	Pages = {A145},
	Primaryclass = {astro-ph.GA},
	Title = {{Nitrogen hydrides in interstellar gas. II. Analysis of Herschel/HIFI observations towards W49N and G10.6 - 0.4 (W31C)}},
	Volume = 543,
	Year = 2012,
	Bdsk-File-1 = {},
	Bdsk-Url-1 = {http://dx.doi.org/10.1051/0004-6361/201118686}}

