	Doi = {10.1086/173099},
	Journal = {\apj},
	Keywords = {ACTIVE GALAXIES, EMISSION SPECTRA, RADIO JETS (ASTRONOMY), SHOCK WAVES, STELLAR ACTIVITY, CENTAURUS CONSTELLATION, FORBIDDEN TRANSITIONS, H BETA LINE, OXYGEN SPECTRA},
	Month = sep,
	Pages = {510-526},
	Title = {{Shock excitation of the emission-line filaments in Centaurus A}},
	Volume = 414,
	Year = 1993,
