	Month = jun,
	Pages = {A8},
	Primaryclass = {astro-ph.SR},
	Title = {{Water in star-forming regions with Herschel (WISH). II. Evolution of 557 GHz 1$_{10}$-1$_{01}$ emission in low-mass protostars}},
	Volume = 542,
