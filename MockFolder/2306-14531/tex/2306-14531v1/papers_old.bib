@inproceedings{Walmsley:2005vn,
	Abstract = {We present the results of model calculations of the chemistry in collapsing prestellar cores. We take account of both depletion onto dust grain surfaces and grain coagulation with its concomitant reduction in grain mean surface area. We also consider the ortho/para abundance ratio of molecular hydrogen and related species as well as their deuterated counterparts. The calculations show that one has to make rather extreme assumptions concerning grain coagulation in order to meaningfully affect the depletion rate of species containing heavy elements. Moreover, one in general requires rapid depletion of CO on timescales of order of the free-fall time in order to fit current observations. We find that in situations of high heavy element depletion, the question of whether the major ion is H+ or H3+ (equivalently one of its deuterated counterparts) depends sensitively on the grain size distribution. Present observations of H2D+ suggest that grain sizes in observed prestellar cores such as L1544 remain below 0.1 micron. However, the interpretation of such observations is rendered difficult by the fact that only ortho-H2D+ is presently observed and we consider how one expects the o/p ratio for this species to behave. We also consider briefly the puzzles posed by the nitrogen chemistry in such cores. One possibility is that the observed high abundances of nitrogen-containing species in high density cores is due to a low sticking coefficient for atomic nitrogen. We note that in case the sticking coefficients for both atomic nitrogen and oxygen should be low, one would expect a high abundance for NO in regions where ammonia is abundant. In the light of these models, we discuss expectations for the NH3 deuterium fractionation and the o/p ratio.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
	Adsurl = {http://adsabs.harvard.edu/abs/2005IAUS..235P.119W},
