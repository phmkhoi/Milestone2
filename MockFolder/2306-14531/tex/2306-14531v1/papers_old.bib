	Editor = {{Pessah}, M. and {Gressel}, O.},
	Keywords = {Physics},
	Pages = {63},
	Series = {Astrophysics and Space Science Library},
	Title = {{Wind-Driven Global Evolution of Protoplanetary Disks}},
