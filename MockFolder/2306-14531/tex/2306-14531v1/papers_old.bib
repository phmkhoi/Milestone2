	Doi = {10.1093/mnras/stw989},
	Eprint = {1604.07285},
	Journal = {\mnras},
	Keywords = {techniques: interferometric, stars: formation, stars: winds, outflows, ISM: jets and outflows, submillimetre: ISM},
	Month = jul,
	Pages = {627-633},
	Title = {{The winds from HL Tau}},
	Volume = 460,
	Year = 2016,
