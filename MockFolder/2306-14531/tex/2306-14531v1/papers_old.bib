	Keywords = {Herbig-Haro objects, ISM: individual objects: HH 211, ISM: jets and outflows, ISM: molecules, shock waves},
	Month = may,
	Pages = {9},
	Title = {{The Anatomy of the Young Protostellar Outflow HH 211}},
	Volume = 751,
	Year = 2012,
