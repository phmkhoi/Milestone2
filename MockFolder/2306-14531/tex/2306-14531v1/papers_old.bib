	Eprint = {astro-ph/0505168},
	Journal = {\mnras},
	Keywords = {ISM: clouds, ISM: individual: CepA, ISM: jets and outflows, ISM: molecules, radio lines: ISM},
	Month = jul,
	Pages = {244-258},
	Title = {{Chemical differentiation along the CepA-East outflows}},
	Volume = 361,
	Year = 2005,
