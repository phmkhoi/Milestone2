	Doi = {10.1016/j.epsl.2012.01.033},
	Journal = {Earth and Planetary Science Letters},
	Month = apr,
	Pages = {61-67},
	Title = {{Formation of chondrules in magnetic winds blowing through the proto-asteroid belt}},
	Volume = 327,
	Year = 2012,
	Bdsk-File-1 = {},
