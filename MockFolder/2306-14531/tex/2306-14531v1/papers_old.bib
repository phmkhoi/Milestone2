	Doi = {10.1086/376741},
	Journal = {\aj},
	Keywords = {ISM: Herbig-Haro Objects, ISM: Individual: Name: {$\rho$} Ophiuchi, ISM: Jets and Outflows, Stars: Formation, Stars: Low-Mass, Brown Dwarfs, Stars: Pre-Main-Sequence},
	Month = aug,
	Pages = {863-886},
	Title = {{Jets and Herbig-Haro Objects in the {$\rho$} Ophiuchi Embedded Cluster}},
	Volume = 126,
	Year = 2003,
	Bdsk-File-1 = {},
