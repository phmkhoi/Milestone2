	Doi = {10.1086/426441},
	Eprint = {arXiv:astro-ph/0410044},
	Journal = {\apjs},
	Keywords = {Catalogs, Infrared: Stars, Stars: Evolution, Stars: Formation, Stars: Pre-Main-Sequence},
	Month = feb,
	Pages = {169-177},
	Title = {{Which Are the Youngest Protostars? Determining Properties of Confirmed and Candidate Class 0 Sources by Broadband Photometry}},
