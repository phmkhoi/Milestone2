	Eprint = {1603.05662},
	Journal = {\mnras},
	Keywords = {methods: analytical, methods: statistical, eclipses, planets and satellites: detection},
	Month = dec,
	Pages = {1323-1331},
	Primaryclass = {astro-ph.EP},
	Title = {{Observational biases for transiting planets}},
	Volume = 463,
