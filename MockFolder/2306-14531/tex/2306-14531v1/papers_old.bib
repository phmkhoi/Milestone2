	Keywords = {Astrophysics - Astrophysics of Galaxies, Astrophysics - Solar and Stellar Astrophysics},
	Month = sep,
	Title = {{Water in Low-Mass Star-Forming Regions with Herschel: The Link Between Water Gas and Ice in Protostellar Envelopes}},
