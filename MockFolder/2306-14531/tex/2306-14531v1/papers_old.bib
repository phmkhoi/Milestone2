	Journal = {\aap},
	Keywords = {stars: formation, stars: winds, outflows, stars: variables: T Tauri, Herbig Ae/Be, techniques: imaging spectroscopy, molecular data, infrared: stars},
	Month = apr,
	Pages = {A11},
	Primaryclass = {astro-ph.SR},
	Title = {{Origin of the wide-angle hot H$_{2}$ in DG Tauri. New insight from SINFONI spectro-imaging}},
	Volume = 564,
	Year = 2014,
	Bdsk-File-1 = {},
