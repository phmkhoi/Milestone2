	Month = nov,
	Pages = {601-617},
	Title = {{VLTI near-IR interferometric observations of Vega-like stars. Radius and age of {$\alpha$} PsA, {$\beta$} Leo, {$\beta$} Pic, {$\epsilon$} Eri and {$\tau$} Cet}},
