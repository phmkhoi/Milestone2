	Author = {{Matsakos}, T. and {Tsinganos}, K. and {Vlahakis}, N. and {Massaglia}, S. and {Mignone}, A. and {Trussoni}, E.},
	Date-Added = {2015-10-15 11:49:20 +0000},
	Date-Modified = {2015-10-15 11:49:20 +0000},
	Doi = {10.1051/0004-6361:20077907},
	Eprint = {0710.3406},
	Journal = {\aap},
	Keywords = {stars: pre-main sequence, stars: formation, ISM: jets and outflows, magnetohydrodynamics (MHD)},
	Month = jan,
	Pages = {521-533},
	Title = {{Two-component jet simulations. I. Topological stability of analytical MHD outflow solutions}},
