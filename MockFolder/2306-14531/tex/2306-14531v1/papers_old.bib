	Doi = {10.1051/0004-6361:20052792},
	Eprint = {arXiv:astro-ph/0505072},
	Journal = {\aap},
	Keywords = {ISM: molecules, circumstellar matter, stars: formation, astrochemistry, molecular processes, line: profiles},
	Month = aug,
	Pages = {195-203},
	Title = {{Line profiles of molecular ions toward the pre-stellar core LDN 1544}},
	Volume = 439,
