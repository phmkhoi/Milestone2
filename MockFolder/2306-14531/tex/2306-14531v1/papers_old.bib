	Date-Added = {2017-02-07 13:41:39 +0000},
	Date-Modified = {2017-02-07 13:41:39 +0000},
	Doi = {10.3847/0004-637X/821/1/3},
	Eid = {3},
	Eprint = {1505.03704},
	Journal = {\apj},
	Keywords = {accretion, accretion disks, dust, extinction, ISM: jets and outflows, planets and satellites: formation, protoplanetary disks, stars: pre-main sequence},
	Month = apr,
	Pages = {3},
	Primaryclass = {astro-ph.EP},
	Title = {{Dust Dynamics in Protoplanetary Disk Winds Driven by Magnetorotational Turbulence: A Mechanism for Floating Dust Grains with Characteristic Sizes}},
