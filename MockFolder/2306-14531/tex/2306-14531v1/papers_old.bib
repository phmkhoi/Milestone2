	Doi = {10.2458/azu_uapress_9780816531240-ch036},
	Eprint = {1401.8103},
	Journal = {Protostars and Planets VI},
	Pages = {835-858},
	Primaryclass = {astro-ph.GA},
	Title = {{Water: From Clouds to Planets}},
	Year = 2014,
