	Doi = {10.1086/308401},
	Eprint = {astro-ph/9909494},
	Journal = {\apj},
	Keywords = {STARS: CIRCUMSTELLAR MATTER, ISM: DUST, EXTINCTION, ISM: CLOUDS, STARS: FORMATION, STARS: PRE-MAIN-SEQUENCE, SUBMILLIMETER},
	Month = feb,
	Pages = {851-866},
	Title = {{The Structure of Protostellar Envelopes Derived from Submillimeter Continuum Images}},
	Volume = 530,
	Year = 2000,
	Bdsk-File-1 = {},
	Bdsk-Url-1 = {http://dx.doi.org/10.1086/308401},
