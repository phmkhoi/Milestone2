	Doi = {10.1086/586728},
	Eid = {594-625},
	Eprint = {0801.3525},
	Journal = {\apj},
	Keywords = {planetary systems: protoplanetary disks, stars: pre-main sequence},
	Month = jul,
	Pages = {594-625},
	Title = {{UV Excess Measures of Accretion onto Young Very Low Mass Stars and Brown Dwarfs}},
	Volume = 681,
	Year = 2008,
