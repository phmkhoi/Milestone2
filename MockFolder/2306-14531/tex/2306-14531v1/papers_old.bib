	Keywords = {circumstellar matter, ISM: jets and outflows, stars: pre-main sequence, planetary systems: protoplanetary disks, ISM: molecules},
	Month = jan,
	Pages = {147-156},
	Title = {{Rotating molecular outflows: the young T Tauri star in CB 26}},
	Volume = 494,
