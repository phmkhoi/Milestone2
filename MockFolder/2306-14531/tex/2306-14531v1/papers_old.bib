	Eprint = {arXiv:astro-ph/0609661},
	Journal = {\apjl},
	Keywords = {ISM: General, ISM: Individual: Alphanumeric: HH 154, ISM: Individual: Alphanumeric: L1551, ISM: Individual: Alphanumeric: L1551 IRS 5, ISM: Jets and Outflows},
	Month = nov,
