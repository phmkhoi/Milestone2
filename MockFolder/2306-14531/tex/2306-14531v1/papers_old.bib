	Keywords = {ABUNDANCE, HYDROCYANIC ACID, INTERSTELLAR GAS, NEBULAE, ELECTRON TRANSITIONS, INTERSTELLAR MATTER, LINE SPECTRA, NUCLEAR REACTIONS},
	Month = may,
