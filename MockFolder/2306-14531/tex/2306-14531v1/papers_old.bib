@article{Tan:2017qy,
	Abstract = {I review massive star formation in our Galaxy, focusing on initial conditions in Infrared Dark Clouds (IRDCs), including the search for massive pre-stellar cores (PSCs), and modeling of later stages of massive protostars, i.e., hot molecular cores (HMCs). I highlight how developments in astrochemistry, coupled with rapidly improving theoretical/computational and observational capabilities are helping to improve our understanding of the complex process of massive star formation.},
