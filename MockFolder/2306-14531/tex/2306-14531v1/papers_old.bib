	Keywords = {ACCRETION, ACCRETION DISKS, MAGNETOHYDRODYNAMICS (MHD), STARS: FORMATION, ISM: JETS AND OUTFLOWS, GALAXIES: NUCLEI, GALAXIES: JETS},
	Month = sep,
	Pages = {1178-1190},
	Title = {{Magnetized accretion-ejection structures. V. Effects of entropy generation inside the disc}},
	Volume = 361,
