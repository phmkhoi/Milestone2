	Author = {{Dionatos}, O. and {Nisini}, B. and {Cabrit}, S. and {Kristensen}, L. and {Pineau Des For{\^e}ts}, G.},
	Date-Added = {2013-11-04 10:05:15 +0000},
	Date-Modified = {2013-11-04 10:05:15 +0000},
	Doi = {10.1051/0004-6361/200913650},
