@article{Nutter:2005kx,
	Abstract = {We present 450- and 850-mum maps of R Coronae Australis. We compare the maps with previous surveys of the region, and shed new light on the previously unknown nature of the protostellar sources at the centre of the cloud. We clarify the nature of two millimetre sources previously discovered in lower-resolution data. We identify one new Class 0 protostar, which we label SMM 1B, and we measure the envelope masses of a number of more evolved protostars. We identify two new pre-stellar cores, which we call SMM 1A and SMM 6.},
