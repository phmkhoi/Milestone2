	Journal = {\aap},
	Keywords = {ISM: clouds, ISM: molecules, ISM: general},
	Month = feb,
	Pages = {187-195},
	Title = {{The molecular condensations ahead of Herbig-Haro objects. II. A theoretical investigation of the HH 2 condensation}},
	Volume = 399,
	Year = 2003,
