	Keywords = {astrochemistry, methods: laboratory, ISM: molecules},
	Month = mar,
	Pages = {768-779},
	Primaryclass = {astro-ph.SR},
	Title = {{Thermal desorption characteristics of CO, O$_{2}$ and CO$_{2}$ on non-porous water, crystalline water and silicate surfaces at submonolayer and multilayer coverages}},
