	Author = {{Tazzari}, M. and {Testi}, L. and {Natta}, A. and {Ansdell}, M. and {Carpenter}, J. and {Guidi}, G. and {Hogerheijde}, M. and {Manara}, C.~F. and {Miotello}, A. and {van der Marel}, N. and {van Dishoeck}, E.~F. and {Williams}, J.~P.},
	Date-Added = {2018-03-22 11:38:55 +0000},
	Date-Modified = {2018-03-22 11:38:55 +0000},
	Doi = {10.1051/0004-6361/201730890},
	Eid = {A88},
	Eprint = {1707.01499},
	Journal = {\aap},
	Keywords = {protoplanetary disks, submillimeter: general, stars: pre-main sequence},
	Month = oct,
	Pages = {A88},
	Primaryclass = {astro-ph.EP},
	Title = {{Physical properties of dusty protoplanetary disks in Lupus: evidence for viscous evolution?}},
	Volume = 606,
	Year = 2017,
	Bdsk-File-1 = {},
	Bdsk-Url-1 = {http://dx.doi.org/10.1051/0004-6361/201730890},
