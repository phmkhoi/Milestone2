	Doi = {10.1051/0004-6361/201016247},
	Eprint = {1101.2327},
	Journal = {\aap},
	Keywords = {stars: formation, ISM: molecules, ISM: jets and outflows, ISM: individual objects: Cep E},
	Month = mar,
	Pages = {L3+},
	Primaryclass = {astro-ph.GA},
	Title = {{Shocked water in the Cepheus E protostellar outflow}},
