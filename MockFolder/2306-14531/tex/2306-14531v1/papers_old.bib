	Author = {{Maury}, A.~J. and {Girart}, J.~M. and {Zhang}, Q. and {Hennebelle}, P. and {Keto}, E. and {Rao}, R. and {Lai}, S.-P. and {Ohashi}, N. and {Galametz}, M.},
	Date-Added = {2018-09-17 11:10:04 +0200},
