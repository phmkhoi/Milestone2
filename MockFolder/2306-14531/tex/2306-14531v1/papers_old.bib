	Journal = {\apj},
	Keywords = {CARBON MONOXIDE, INFRARED SOURCES (ASTRONOMY), MAGNETIC FIELD CONFIGURATIONS, OPHIUCHI CLOUDS, PROTOSTARS, REFLECTION NEBULAE, AMMONIA, STAR FORMATION, STELLAR MAGNETIC FIELDS, STELLAR MODELS},
