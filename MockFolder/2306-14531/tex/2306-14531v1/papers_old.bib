	Doi = {10.1086/376824},
	Eprint = {astro-ph/0304127},
	Journal = {\apjl},
	Keywords = {ISM: Jets and Outflows, Magnetohydrodynamics: MHD, Stars: Formation, Stars: Individual: Constellation Name: DG Tauri, Stars: Pre-Main-Sequence},
	Month = jun,
	Pages = {L107-L110},
	Title = {{Locating the Launching Region of T Tauri Winds: The Case of DG Tauri}},
	Volume = 590,
