	Eprint = {1412.6489},
	Journal = {\apj},
	Keywords = {Herbig-Haro objects, ISM: jets and outflows, magnetohydrodynamics: MHD, methods: numerical, shock waves, stars: jets},
	Month = feb,
	Pages = {41},
	Primaryclass = {astro-ph.HE},
	Title = {{Magnetohydrodynamic Effects on Pulsed Young Stellar Object Jets. I. 2.5D Simulations}},
