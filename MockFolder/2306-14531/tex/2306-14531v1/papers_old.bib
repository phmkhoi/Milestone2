	Date-Added = {2012-02-03 09:17:46 +0100},
	Date-Modified = {2012-03-12 19:41:57 +0100},
	Eprint = {1201.6395},
	Journal = {ArXiv e-prints},
	Keywords = {Astrophysics - Galaxy Astrophysics},
	Month = jan,
	Primaryclass = {astro-ph.GA},
	Title = {{Sub-arcsecond SMA observations of the prototype Class 0 object VLA1623 at 1.3 mm: A single protostar with a structured outflow cavity ?}},
