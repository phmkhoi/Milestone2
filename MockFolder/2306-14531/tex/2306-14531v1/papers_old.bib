	Doi = {10.1038/25299},
	Eprint = {astro-ph/9811318},
	Journal = {\nat},
	Month = dec,
	Pages = {650-653},
	Title = {{Coexisting conical bipolar and equatorial outflows from a high-mass protostar}},
	Volume = 396,
	Year = 1998,
	Bdsk-File-1 = {},
