	Date-Modified = {2012-10-26 16:20:44 +0200},
	Doi = {10.1086/130373},
	Journal = {\pasp},
	Keywords = {STAR CLUSTERS, STELLAR EVOLUTION, B STARS, CHRONOLOGY, NEBULAE, O STARS, OPEN CLUSTERS, STELLAR MASS, T TAURI STARS},
	Month = oct,
