	Eprint = {0704.2685},
	Journal = {\aap},
	Keywords = {stars: formation, radio lines: ISM, ISM: jets and outflows, ISM: molecules, ISM: individual objects: HH212},
	Month = jun,
	Pages = {L29-L32},
	Title = {{PdBI sub-arcsecond study of the SiO microjet in HH212. Origin and collimation of class 0 jets}},
