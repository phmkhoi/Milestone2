	Author = {{Dunham}, M.~M. and {Stutz}, A.~M. and {Allen}, L.~E. and {Evans}, II, N.~J. and {Fischer}, W.~J. and {Megeath}, S.~T. and {Myers}, P.~C. and {Offner}, S.~S.~R. and {Poteet}, C.~A. and {Tobin}, J.~J. and {Vorobyov}, E.~I.},
	Date-Added = {2014-04-10 13:39:57 +0000},
	Date-Modified = {2014-04-10 13:39:58 +0000},
