	Date-Added = {2019-04-03 13:44:27 +0200},
	Date-Modified = {2019-04-03 13:44:27 +0200},
	Doi = {10.1051/0004-6361/201322463},
	Eid = {A82},
	Eprint = {1309.6509},
	Journal = {\aap},
	Keywords = {stars: formation, stars: pre-main sequence, circumstellar matter, radiative transfer, submillimeter: stars},
	Month = nov,
	Pages = {A82},
	Primaryclass = {astro-ph.SR},
	Title = {{Interplay between chemistry and dynamics in embedded protostellar disks}},
	Volume = 559,
	Year = 2013,
