	Keywords = {hydrodynamics, ISM: clouds, radiative transfer, stars: formation, stars: low-mass, stars: protostars},
	Month = mar,
	Pages = {52},
	Primaryclass = {astro-ph.GA},
	Title = {{Resolving the Luminosity Problem in Low-mass Star Formation}},
	Volume = 747,
