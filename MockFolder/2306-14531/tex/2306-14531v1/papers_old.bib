	Keywords = {stars: formation, accretion, accretion disks, radiative transfer, line: profiles, magnetohydrodynamics (MHD), methods: numerical},
	Month = may,
	Pages = {A22},
	Primaryclass = {astro-ph.SR},
	Title = {{Testing protostellar disk formation models with ALMA observations}},
	Volume = 577,
