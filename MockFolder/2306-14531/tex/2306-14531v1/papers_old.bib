	Title = {{ALMA Observations of the Galactic Center: SiO Outflows and High-mass Star Formation near Sgr A*}},
	Volume = 767,
	Year = 2013,
	Bdsk-File-1 = {},
	Bdsk-Url-1 = {http://dx.doi.org/10.1088/2041-8205/767/2/L32},
