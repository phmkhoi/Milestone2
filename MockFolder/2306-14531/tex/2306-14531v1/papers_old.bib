@article{Guenther:1987qy,
	Abstract = {The apparent contradictions between the young age of Epsilon Eridani implied by its high chromospheric activity and rapid rotation rate and the old age implied by its lower than solar metal content are discussed in the light of the constraint imposed by recent observations of p-mode oscillations. To account for the discrepancy, it is proposed that either: Epsilon Eridani is part of an unresolved, nearly face-on binary star system; Epsilon Eridani's metal abundance has been underestimated due to the 'filling-in' of the metal lines relative to the sun's metal lines by bright plage regions on the surface of the star; or, Epsilon Eridani has a lower than solar mixing length parameter.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
