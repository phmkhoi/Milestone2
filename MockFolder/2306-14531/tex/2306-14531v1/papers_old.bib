	Doi = {10.1086/426679},
	Eprint = {arXiv:astro-ph/0406403},
	Journal = {\apj},
	Keywords = {ISM: Dust, Extinction, Infrared: ISM},
	Month = feb,
	Pages = {931-938},
	Title = {{The Wavelength Dependence of Interstellar Extinction from 1.25 to 8.0 {$\mu$}m Using GLIMPSE Data}},
