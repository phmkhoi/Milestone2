	Doi = {10.1088/0004-637X/784/1/61},
	Eid = {61},
	Eprint = {1312.0951},
	Journal = {\apj},
	Keywords = {ISM: jets and outflows, stars: formation, stars: low-mass, stars: winds, outflows, turbulence},
	Month = mar,
	Pages = {61},
	Primaryclass = {astro-ph.SR},
	Title = {{Investigations of Protostellar Outflow Launching and Gas Entrainment: Hydrodynamic Simulations and Molecular Emission}},
	Volume = 784,
