	Journal = {\araa},
	Keywords = {JET FLOW, STELLAR ENVELOPES, STELLAR EVOLUTION, STELLAR MASS EJECTION, STELLAR WINDS, ASTRONOMICAL CATALOGS, ASTROPHYSICS, HERBIG-HARO OBJECTS, MOLECULAR CLOUDS, T TAURI STARS, WATER MASERS},
	Local-Url = {file://localhost/Users/per/Documents/Papers/%7BLada%7D/1985.pdf},
