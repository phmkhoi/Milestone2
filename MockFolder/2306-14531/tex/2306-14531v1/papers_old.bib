	Doi = {10.1111/j.1745-3933.2010.00871.x},
	Eprint = {1005.1847},
	Journal = {\mnras},
	Keywords = {molecular processes, shock waves, ISM: molecules},
	Month = jul,
	Pages = {L11-L15},
	Primaryclass = {astro-ph.SR},
	Title = {{H_{2} reformation in post-shock regions}},
	Volume = 406,
