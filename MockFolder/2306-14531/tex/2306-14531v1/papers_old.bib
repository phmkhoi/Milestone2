	Journal = {\aap},
	Keywords = {HERBIG-HARO OBJECTS, HYDROGEN, INFRARED ASTRONOMY, IRON, JET FLOW, LINE SPECTRA, MOLECULAR EXCITATION, NEAR INFRARED RADIATION, SHOCK WAVES, INFRARED IMAGERY, INFRARED SPECTROSCOPY, INTERSTELLAR MATTER, MORPHOLOGY, REFLECTING TELESCOPES, SPECTROGRAPHS},
	Month = dec,
