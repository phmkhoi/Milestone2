	Eid = {56},
	Eprint = {1210.6368},
	Journal = {\aapr},
	Keywords = {Astrochemistry, ISM: clouds, Stars: formation, Protoplanetary disks, Comets: general, Meteorites, meteors, meteoroids},
	Month = oct,
	Pages = {56},
	Title = {{Our astrochemical heritage}},
	Volume = 20,
	Year = 2012,
	Bdsk-File-1 = {},
	Bdsk-Url-1 = {http://dx.doi.org/10.1007/s00159-012-0056-x},
