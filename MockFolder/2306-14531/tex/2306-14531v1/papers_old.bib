	Doi = {10.1007/BF00667818},
	Journal = {\apss},
	Keywords = {Star formation, Protostars, Circumstellar Matter, Class 0, ammonia},
	Month = feb,
	Pages = {43-46},
	Title = {{Ammonia Images near Objects with Class 0 Spectral Energy Distributions}},
	Volume = 224,
	Year = 1995,
	Bdsk-File-1 = {},
	Bdsk-Url-1 = {http://dx.doi.org/10.1007/BF00667818}}

@inproceedings{Bontemps:1997fr,
	Abstract = {Using the VLA, we have recently discovered a radio HH-jet emanating from the prototype Class 0 protostar VLA1623 in rho Ophiuchi. The jet is monopolar and consists of three regulary spaced radio knots which we tentatively interpret as obscured radio HH objects. The jet has roughly the size of the protostellar envelope (~ 3000 AU) and may thus correspond to the innermost part of the energetic outflow powered by VLA1623. The clear asymmetry and the regular knotty structure provide us with constraints to discuss the possible HH-jet models at work in the inner outflow of this very young protostar. In addition, the aligned radio knots hint at a recent outflow direction which is different from that of the larger scale CO outflow. This suggests that the outflow from VLA1623 is precessing and may explain the large scale bending of the CO outflow.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
	Adsurl = {http://adsabs.harvard.edu/abs/1997IAUS..182P..63B},
	Author = {{Bontemps}, S. and {Andre}, P.},
	Booktitle = {Herbig-Haro Flows and the Birth of Stars},
	Date-Added = {2011-04-11 12:02:13 +0200},
