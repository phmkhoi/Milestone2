@article{Guenther:1986uq,
	Abstract = {This calculated p-mode oscillation spectrum of several stellar models of eps Eridani are compared with the observational data of Noyes et al. Specifically, models with different masses, metallicities, and mixing length parameters are constructed, and for each model the low-degree p-mode oscillation spectrum is calculated and its characteristic frequency spacing is compared with the observed value of 172 mikroHz. Of all the models constructed, the model with a mass of 0.80 Msun;, Z = 0.02, mixing length parameter alpha = 1.00, an age of 11.5 Gyr, and a radius of 0.80 Rsun; best fits the observed luminosity, effective temperature, and oscillation data. The characteristic frequency spacing of the oscillation spectrum of this model is 170 mikroHz. It is concluded that the structure of this model must be very close to the actual physical structure of eps Eri.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
	Adsurl = {http://adsabs.harvard.edu/abs/1986ApJ...301..207G},
	Annote = {Additional keywords:
