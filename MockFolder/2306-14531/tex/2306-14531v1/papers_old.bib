	Doi = {10.1086/168261},
	Journal = {\apj},
	Keywords = {CARBON MONOXIDE, LINE SPECTRA, PRE-MAIN SEQUENCE STARS, ABUNDANCE, MOLECULAR EXCITATION, MOLECULAR FLOW, VELOCITY DISTRIBUTION},
	Month = jan,
	Pages = {530-541},
	Title = {{CO line formation in bipolar flows. II - Decelerated outflow case and summary of results}},
