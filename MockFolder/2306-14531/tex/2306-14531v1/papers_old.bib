	Archiveprefix = {arXiv},
	Arxivurl = {http://arxiv.org/abs/1305.2668},
	Author = {{Hara}, C. and {Shimajiri}, Y. and {Tsukagoshi}, T. and {Kurono}, Y. and {Saigo}, K. and {Nakamura}, F. and {Saito}, M. and {Wilner}, D. and {Kawabe}, R.},
	Date-Added = {2016-11-16 13:45:14 +0000},
	Date-Modified = {2016-11-16 13:45:15 +0000},
	Doi = {10.1088/0004-637X/771/2/128},
	Eid = {128},
	Eprint = {1305.2668},
	Journal = {\apj},
