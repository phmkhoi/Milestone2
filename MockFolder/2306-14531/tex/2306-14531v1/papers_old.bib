	Journal = {\aap},
	Keywords = {ISM: jets and outflow, stars: formation, ISM: individual objects: DG Tau},
	Month = mar,
	Pages = {L9-L12},
	Title = {{Predicted rotation signatures in MHD disc winds and comparison to DG Tau observations.}},
