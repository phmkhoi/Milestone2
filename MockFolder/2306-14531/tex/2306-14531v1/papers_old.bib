	Eprint = {astro-ph/0703064},
	Journal = {\aap},
	Keywords = {accretion, accretion disks, ISM: jets and outflows, galaxies: jets, magnetohydrodynamics (MHD), methods: numerical},
	Month = jul,
	Pages = {811-828},
	Title = {{MHD simulations of jet acceleration from Keplerian accretion disks. The effects of disk resistivity}},
	Volume = 469,
