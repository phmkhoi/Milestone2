@article{van-Dishoeck:1993fk,
	Abstract = {Submillimeter observations of various simple molecules in the shocked molecular gas associated with the supernova remnant IC 443 are presented. CO 3-2 line profiles along the shocked ring are used to constrain the global kinematics of the region. Searches for other molecules in the shocked gas have been performed at two positions in clump G and one position in clump B. High-frequency lines of HCO(+), HCN, HNC, CS, SO, SiO, H2CO and C2H have been detected, and significant upper limits have been obtained for various other, more complex molecules. The physical parameters in the shocked gas have been derived from an analysis of the excitation of these species. The observed abundances are substantially lower than those found in one-fluid hydrodynamic shock models with a small H/H2 ratio, but appear consistent with the limited models in which H/H2 is significant.},
