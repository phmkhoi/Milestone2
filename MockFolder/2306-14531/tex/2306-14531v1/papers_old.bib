	Doi = {10.1086/500357},
	Eprint = {astro-ph/0512351},
	Journal = {\apj},
	Keywords = {ISM: individual (LDN 1551), ISM: Jets and Outflows, Stars: Formation, Submillimeter},
	Month = jul,
	Pages = {357-368},
	Title = {{Multigenerational Star Formation in L1551}},
	Volume = 645,
	Year = 2006,
