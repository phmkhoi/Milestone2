	Journal = {\apjl},
	Keywords = {ISM: Dust, Extinction, ISM: Abundances, Ultraviolet: ISM},
	Month = jun,
	Pages = {L221-L224},
	Title = {{Interstellar Abundance Standards Revisited}},
	Volume = 554,
	Year = 2001,
