@article{Pankonin:1978lr,
	Abstract = {Recombination line observations made at 1.6 GHz, 5 GHz, and 9 GHz are used to compile data on ionized carbon and sulfur distribution in the Rho Ophiuchi Dark Cloud. The carbon was found to be near an early B star, which is probably the source of its ionization. Two components of the C II are noted: a high density compact 'core' and a lower density extended 'halo', which dominate the high and low frequency line measurements, respectively. The sulfur line is thought not to originate in the same volume as the carbon line. It is noted that Mg, Si, and Fe are depleted relative to sulfur by a factor greater than three.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
