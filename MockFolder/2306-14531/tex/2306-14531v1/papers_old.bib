	Journal = {\aap},
	Keywords = {ISM: individual objects: HH 2, ISM: abundances, ISM: clouds, ISM: molecules, radio lines: ISM, stars: formation},
	Month = jun,
	Pages = {1004-1015},
	Title = {{The molecular condensations ahead of Herbig-Haro objects. I. Multi-transition observations of HH 2}},
