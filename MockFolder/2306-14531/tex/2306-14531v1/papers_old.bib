	Date-Added = {2008-03-04 13:37:26 +0100},
	Date-Modified = {2008-03-04 14:03:06 +0100},
	Doi = {10.1086/311652},
	Eprint = {arXiv:astro-ph/9808224},
	Journal = {\apjl},
