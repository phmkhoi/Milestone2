	Author = {{Benedettini}, M. and {Busquet}, G. and {Lefloch}, B. and {Codella}, C. and {Cabrit}, S. and {Ceccarelli}, C. and {Giannini}, T. and {Nisini}, B. and {Vasta}, M. and {Cernicharo}, J. and {Lorenzani}, A. and {di Giorgio}, A.~M.},
	Date-Added = {2014-03-12 22:13:45 +0000},
	Date-Modified = {2014-03-12 22:13:46 +0000},
	Doi = {10.1051/0004-6361/201118732},
	Eid = {L3},
