	Doi = {10.1086/512230},
	Eprint = {arXiv:astro-ph/0701115},
	Journal = {\apj},
	Keywords = {Stars: Circumstellar Matter, ISM: Dust, Extinction, ISM: Jets and Outflows, ISM: Molecules, Stars: Formation, Techniques: Interferometric},
	Month = apr,
	Pages = {479-498},
	Title = {{PROSAC: A Submillimeter Array Survey of Low-Mass Protostars. I. Overview of Program: Envelopes, Disks, Outflows, and Hot Cores}},
	Volume = 659,
	Year = 2007,
