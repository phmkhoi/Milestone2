	Eprint = {0802.0201},
	Journal = {\mnras},
	Keywords = {line: formation , radiative transfer , stars: formation , stars: pre-main-sequence},
	Month = apr,
	Pages = {1931-1945},
	Title = {{3D simulations of rotationally-induced line variability from a classical T Tauri star with a misaligned magnetic dipole}},
	Volume = 385,
