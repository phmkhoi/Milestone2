	Date-Added = {2014-03-26 14:39:29 +0000},
	Date-Modified = {2014-03-26 14:39:30 +0000},
	Doi = {10.1093/mnras/stt2343},
	Eprint = {1307.1747},
	Journal = {\mnras},
	Keywords = {accretion, accretion discs, MHD, stars: formation, stars: low-mass, ISM: jets and outflows, ISM: magnetic fields},
	Month = mar,
	Pages = {2278-2306},
	Primaryclass = {astro-ph.SR},
