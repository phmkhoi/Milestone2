	Keywords = {stars: formation, stars: protostars, radio continuum: ISM},
	Month = jan,
	Pages = {A76},
	Title = {{Characterizing young protostellar disks with the CALYPSO IRAM-PdBI survey: large Class 0 disks are rare}},
	Volume = 621,
	Year = 2019,
	Bdsk-File-1 = {},
