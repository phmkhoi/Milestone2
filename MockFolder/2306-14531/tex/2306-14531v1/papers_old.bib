@inproceedings{Zhang:2017oa,
	Abstract = {Our ALMA multi-cycle multi-band observations of HH46/47 outflow show co-existence of entrainment by both wide-angle wind and jet bow-shock and this outflow is at a moment that the former has just become dominant. The estimated outflow mass and strength suggest that it has already strongly affected the core-to-star efficiency to 1/3 at this early stage. The zoom-in observation also reveals multiple wide outflowing shells with positions and shapes smoothly changing over a wide range of velocity, which may be an evidence of episodic eruption not only in jet but also in the wide-angle wind.},
