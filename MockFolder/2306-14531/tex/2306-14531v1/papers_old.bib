	Doi = {10.1086/169685},
	Journal = {\apj},
	Keywords = {INTERSTELLAR MASERS, LATE STARS, STAR FORMATION, WATER MASERS, ABUNDANCE, COMPUTATIONAL ASTROPHYSICS, EMISSION SPECTRA, MILLIMETER WAVES, RADIATION DISTRIBUTION, STELLAR ENVELOPES},
