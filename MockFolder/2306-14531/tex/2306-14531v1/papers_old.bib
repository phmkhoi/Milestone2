	Author = {{Alves}, F.~O. and {Girart}, J.~M. and {Caselli}, P. and {Franco}, G.~A.~P. and {Zhao}, B. and {Vlemmings}, W.~H.~T. and {Evans}, M.~G. and {Ricci}, L.},
	Date-Added = {2017-09-28 11:25:05 +0000},
	Date-Modified = {2017-09-28 11:25:05 +0000},
	Doi = {10.1051/0004-6361/201731077},
	Eid = {L3},
