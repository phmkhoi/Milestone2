	Author = {{Kristensen}, L.~E. and {Klaassen}, P.~D. and {Mottram}, J.~C. and {Schmalzl}, M. and {Hogerheijde}, M.~R.},
	Date-Added = {2013-05-31 08:09:26 +0000},
	Date-Modified = {2013-05-31 08:09:27 +0000},
	Doi = {10.1051/0004-6361/201220668},
	Eid = {L6},
