	Journal = {\apj},
	Keywords = {ISM: clouds, ISM: molecules, molecular processes, shock waves},
	Month = may,
	Pages = {974-984},
	Title = {{Mapping Warm Molecular Hydrogen with the Spitzer Infrared Array Camera (IRAC)}},
