	Author = {{Zhang}, Y. and {Higuchi}, A.~E. and {Sakai}, N. and {Oya}, Y. and {Lopez-Sepulcre}, A. and {Imai}, M. and {Sakai}, T. and {Watanabe}, Y. and {Ceccarelli}, C. and {Lefloch}, B. and {Yamamoto}, S.},
	Date-Added = {2018-08-14 14:02:54 +0000},
	Date-Modified = {2018-08-14 14:02:54 +0000},
	Eprint = {1808.00346},
	Journal = {ArXiv e-prints},
	Keywords = {Astrophysics - Astrophysics of Galaxies, Astrophysics - Solar and Stellar Astrophysics},
	Month = aug,
	Title = {{Rotation in the NGC 1333 IRAS 4C Outflow}},
	Year = 2018,
