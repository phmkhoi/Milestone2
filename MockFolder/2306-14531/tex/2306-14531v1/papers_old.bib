	Journal = {\apj},
	Keywords = {ISM: individual: IRAS15398 {\ndash} 3359, ISM: molecules},
	Month = may,
	Pages = {769-786},
	Title = {{Discovery of the Second Warm Carbon-Chain-Chemistry Source, IRAS15398 - 3359 in Lupus}},
	Volume = 697,
	Year = 2009,
