	Keywords = {stars: formation, accretion, accretion disks, radiative transfer, astrochemistry, methods: numerical},
	Month = jul,
	Pages = {A45},
	Primaryclass = {astro-ph.SR},
	Title = {{Evolution of CO lines in time-dependent models of protostellar disk formation}},
	Volume = 555,
	Year = 2013,
