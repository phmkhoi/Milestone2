	Date-Added = {2011-08-04 17:41:52 +0200},
	Date-Modified = {2011-10-17 08:58:35 +0200},
	Doi = {10.1051/0004-6361/201116975},
	Eprint = {1105.4884},
	Journal = {\aap},
	Keywords = {astrochemistry, stars: formation, ISM: molecules, ISM: jets and outflows, ISM: individual objects: L1448},
	Month = jul,
	Pages = {L1+},
