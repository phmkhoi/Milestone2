	Author = {{Yamaguchi}, T. and {Takano}, S. and {Watanabe}, Y. and {Sakai}, N. and {Sakai}, T. and {Liu}, S.-Y. and {Su}, Y.-N. and {Hirano}, N. and {Takakuwa}, S. and {Aikawa}, Y. and {Nomura}, H. and {Yamamoto}, S.},
