	Doi = {10.3847/2041-8213/ab0e85},
	Eid = {L4},
	Journal = {\apjl},
	Keywords = {black hole physics, galaxies: individual: M87, galaxies: jets, techniques: high angular resolution, techniques: image processing, techniques: interferometric},
	Month = apr,
	Pages = {L4},
	Title = {{First M87 Event Horizon Telescope Results. IV. Imaging the Central Supermassive Black Hole}},
	Volume = 875,
	Year = 2019,
	Bdsk-File-1 = {},
