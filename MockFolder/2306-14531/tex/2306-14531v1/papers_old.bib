	Keywords = {Early Stars, Mixing Layers (Fluids), Stellar Envelopes, Stellar Mass Ejection, Computational Astrophysics, Emission Spectra, Herbig-Haro Objects, Jet Flow},
	Month = may,
	Pages = {646-658},
	Title = {{Mixing layers in stellar outflows}},
