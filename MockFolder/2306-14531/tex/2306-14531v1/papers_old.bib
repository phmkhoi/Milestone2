	Journal = {\aap},
	Keywords = {stars: formation, stars: low-mass, ISM: jets and outflows, ISM: molecules, ISM: individual objects: L1448, ISM: individual objects: L1157},
	Month = sep,
	Pages = {A22},
	Primaryclass = {astro-ph.GA},
	Title = {{Herschel-PACS observations of shocked gas associated with the jets of L1448 and L1157}},
	Volume = 557,
	Year = 2013,
	Bdsk-File-1 = {},
