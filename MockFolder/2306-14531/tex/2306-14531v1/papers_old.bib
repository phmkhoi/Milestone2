	Eprint = {arXiv:astro-ph/9904097},
	Journal = {Protostars and Planets IV},
	Month = may,
	Pages = {867},
	Title = {{Molecular Outflows from Young Stellar Objects}},
	Year = 2000,
	Bdsk-File-1 = {}}

