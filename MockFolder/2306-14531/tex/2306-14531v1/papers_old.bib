	Doi = {10.1093/mnras/sty574},
	Eprint = {1803.00028},
	Journal = {\mnras},
	Keywords = {techniques: polarimetric, stars: formation, ISM: individual objects: B335, ISM: magnetic fields},
	Month = jun,
