	Journal = {\apj},
	Keywords = {CARBON MONOXIDE, MILLIMETER WAVES, MOLECULAR CLOUDS, PLASMA JETS, PRE-MAIN SEQUENCE STARS, RADIO SPECTRA, ASTRONOMICAL MAPS, EMISSION SPECTRA, MOLECULAR GASES, OPTICAL THICKNESS, ORION NEBULA, STELLAR WINDS},
	Month = sep,
	Pages = {176-193},
	Title = {{High-velocity molecular jets}},
