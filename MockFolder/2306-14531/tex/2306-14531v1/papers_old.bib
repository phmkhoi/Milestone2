	Doi = {10.1088/0004-637X/765/2/133},
	Eid = {133},
	Eprint = {1301.7341},
	Journal = {\apj},
	Keywords = {circumstellar matter, radiative transfer, stars: formation, stars: protostars, stars: variables: T Tauri, Herbig Ae/Be},
	Month = mar,
	Pages = {133},
	Primaryclass = {astro-ph.SR},
	Title = {{Continuum Variability of Deeply Embedded Protostars as a Probe of Envelope Structure}},
	Volume = 765,
