@article{Zanni:2004uq,
	Abstract = {We present a 2.5D magnetohydrodynamic (MHD) simulation of the acceleration of a collimated jet from a magnetized accretion disk. We employ a MHD Adaptive Mesh Refinement (AMR) code (FLASH---University of Chicago). Thanks to this tool we can follow the evolution of the system for many dynamical timescales with a high-spatial resolution. Assuming an initial condition in which a Keplerian disk, thus with no accretion motions, is threaded by a uniform poloidal magnetic field, we show how both the accretion flow and the acceleration of the outflow occur, and we present in detail which are the forces responsible for the jet launching and collimation. Our simulation also shows how the collimating forces due to the self-generated toroidal magnetic field can produce some peculiar knotty features.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
	Adsurl = {http://adsabs.harvard.edu/abs/2004Ap%26SS.293...99Z},
	Annote = {From Bo Reipurt
toroidal poloidal magnetic fields outflow},
