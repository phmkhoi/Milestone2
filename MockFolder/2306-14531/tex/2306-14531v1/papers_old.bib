	Journal = {\aap},
	Keywords = {astrochemistry, stars: formation, stars: protostars, ISM: molecules, ISM: individual objects: IRAS 16293-2422},
	Month = sep,
	Pages = {A95},
	Title = {{The ALMA-PILS survey: first detection of methyl isocyanide (CH$_{3}$NC) in a solar-type protostar}},
	Volume = 617,
	Year = 2018,
	Bdsk-File-1 = {},
