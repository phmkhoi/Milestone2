	Author = {{van der Marel}, N. and {Kristensen}, L.~E. and {Visser}, R. and {Mottram}, J.~C. and {Y{\i}ld{\i}z}, U.~A. and {van Dishoeck}, E.~F.},
	Date-Added = {2013-12-11 10:03:41 +0000},
	Date-Modified = {2013-12-11 10:03:41 +0000},
	Doi = {10.1051/0004-6361/201220717},
	Eid = {A76},
	Eprint = {1305.6453},
	Journal = {\aap},
	Keywords = {ISM: jets and outflows, ISM: molecules, stars: protostars, stars: low-mass, circumstellar matter, submillimeter: ISM},
	Month = aug,
	Pages = {A76},
	Primaryclass = {astro-ph.SR},
	Title = {{Outflow forces of low-mass embedded objects in Ophiuchus: a quantitative comparison of analysis methods}},
