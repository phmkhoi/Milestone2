	Author = {{Flagey}, N. and {Goldsmith}, P.~F. and {Lis}, D.~C. and {Gerin}, M. and {Neufeld}, D. and {Sonnentrucker}, P. and {De Luca}, M. and {Godard}, B. and {Goicoechea}, J.~R. and {Monje}, R. and {Phillips}, T.~G.},
	Date-Added = {2013-06-18 08:49:52 +0000},
	Date-Modified = {2013-06-20 08:22:42 +0000},
	Doi = {10.1088/0004-637X/762/1/11},
	Eid = {11},
	Eprint = {1211.0367},
	Journal = {\apj},
	Keywords = {astrochemistry, ISM: abundances, ISM: molecules, molecular processes, submillimeter: ISM},
	Month = jan,
	Pages = {11},
	Primaryclass = {astro-ph.GA},
	Title = {{Water Absorption in Galactic Translucent Clouds: Conditions and History of the Gas Derived from Herschel/HIFI PRISMAS Observations}},
	Volume = 762,
	Year = 2013,
	Bdsk-File-1 = {},
