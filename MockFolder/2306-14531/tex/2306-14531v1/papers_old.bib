	Author = {{Coutens}, A. and {Vastel}, C. and {Cazaux}, S. and {Bottinelli}, S. and {Caux}, E. and {Ceccarelli}, C. and {Demyk}, K. and {Taquet}, V. and {Wakelam}, V.},
	Date-Added = {2013-11-12 10:17:59 +0000},
	Date-Modified = {2013-11-12 10:17:59 +0000},
	Doi = {10.1051/0004-6361/201220967},
