	Keywords = {ISM: individual objects: Orion A, Orion B, ISM: molecules, stars: formation},
	Month = dec,
	Pages = {157-174},
	Title = {{Astrochemistry of sub-millimeter sources in Orion. Studying the variations of molecular tracers with changing physical conditions}},
	Volume = 412,
	Year = 2003,
	Bdsk-File-1 = {},
	Bdsk-Url-1 = {http://dx.doi.org/10.1051/0004-6361:20031370},
