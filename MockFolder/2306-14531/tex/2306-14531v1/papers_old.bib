	Eprint = {0812.0844},
	Journal = {\apjl},
	Keywords = {accretion, accretion disks, MHD, planetary systems: protoplanetary disks, stars: winds, outflows, turbulence, waves},
	Month = jan,
	Pages = {L49-L54},
	Title = {{Disk Winds Driven by Magnetorotational Instability and Dispersal of Protoplanetary Disks}},
	Volume = 691,
	Year = 2009,
