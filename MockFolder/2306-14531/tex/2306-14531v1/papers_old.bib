@article{Olson:1986kx,
	Abstract = {An iterative scheme has been developed for the solution of the non-LTE line radiation transfer problem. The method uses an approximate operator that is deliberately chosen to be local so that it can be easily extended to multidimensional geometry. The difference between the formal and approximate solutions is used as a driving term for the iterations. In one-dimensional, semi-infinite and free-standing slabs, the technique is found to be very fast, robust, and applicable to a large class of problems.},
	Annote = {On the "Initial Literature list" given by Ren{\'e}},
