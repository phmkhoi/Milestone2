	Keywords = {INTERSTELLAR GAS, MOLECULAR FLOW, PRE-MAIN SEQUENCE STARS, STELLAR MASS EJECTION, ASTRONOMICAL MAPS, CARBON MONOXIDE, INFRARED ASTRONOMY, LINE SPECTRA, STELLAR MASS},
