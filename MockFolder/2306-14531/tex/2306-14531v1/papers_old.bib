	Date-Modified = {2014-02-17 12:44:25 +0000},
	Month = may,
	Pages = {#315.02},
	Series = {American Astronomical Society Meeting Abstracts},
	Title = {{Deuterium Fractionation As Evolutionary Tracer Of Class 0 Protostars}},
	Volume = 214,
