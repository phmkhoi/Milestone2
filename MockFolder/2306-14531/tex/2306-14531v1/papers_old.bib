@article{de-Jong:1980fk,
	Abstract = {The gas temperature in molecular clouds was computed by solving chemical equilibrium and thermal balance equations of 175 reactions involving H, He, C, O, and C-O compounds. The gas is heated by photoelectrons from dust grains in the outer parts of the clouds and by cosmic ray ionizations of molecular H in the inner portions; the gas is cooled by fine-structure excitation, radiative decay of C(+) ions and C atoms in the outer parts of the clouds, and by rotational excitation of CO molecules followed by radiative decay in the inner parts. Plane-parallel hydrostatic models of molecular clouds which are supported by turbulent pressure were constructed; the CH, CH2, CH3, C2, and HCO molecules are formed in the outer parts of the clouds, while OH, H2O, CH4, O2, and H2CO are formed in the dense cloud cores.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
