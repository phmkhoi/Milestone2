	Eprint = {1606.06492},
	Journal = {\apjl},
	Keywords = {astrochemistry, protoplanetary disks, stars: individual: TW Hya, stars: pre-main sequence, submillimeter: planetary systems},
	Month = may,
	Pages = {L10},
	Primaryclass = {astro-ph.EP},
	Title = {{First Detection of Gas-phase Methanol in a Protoplanetary Disk}},
	Volume = 823,
	Year = 2016,
	Bdsk-File-1 = {},
	Bdsk-Url-1 = {http://dx.doi.org/10.3847/2041-8205/823/1/L10},
