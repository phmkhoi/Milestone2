	Keywords = {circumstellar matter, ISM: individual objects: Lupus 3 MMS, IRAS 15398-3559, IRAS 16253-2429, ISM: kinematics and dynamics, stars: formation},
	Month = jan,
	Pages = {178},
	Primaryclass = {astro-ph.SR},
	Title = {{Signs of Early-stage Disk Growth Revealed with ALMA}},
	Volume = 834,
	Year = 2017,
