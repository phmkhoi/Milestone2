	Journal = {\pasp},
	Keywords = {Nebulae, Star Formation, Stellar Evolution, Stellar Winds, Herbig-Haro Objects, Stellar Mass Ejection, Stellar Spectra, T Tauri Stars},
	Month = sep,
	Pages = {816-831},
	Title = {{Newborn stars and stellar winds in Barnard 228}},
	Volume = 101,
	Year = 1989,
	Bdsk-File-1 = {},
