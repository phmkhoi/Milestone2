	Journal = {\apjs},
	Keywords = {Galaxy: disk, ISM: individual objects: Carina, open clusters and associations: individual: Carina, stars: formation, stars: pre-main sequence, X-rays: stars},
	Month = may,
	Pages = {3},
	Primaryclass = {astro-ph.SR},
	Title = {{Source Contamination in X-ray Studies of Star-forming Regions: Application to the Chandra Carina Complex Project}},
	Volume = 194,
	Year = 2011,
