	Keywords = {ISM: jets and outflows, techniques: high angular resolution, binaries: general, stars: pre-main sequence, ISM: molecules, radio lines: ISM},
	Month = jan,
	Pages = {A2},
	Title = {{A rotating molecular jet in Orion}},
	Volume = 510,
	Year = 2010,
