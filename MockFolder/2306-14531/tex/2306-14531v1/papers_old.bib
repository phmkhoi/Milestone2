	Journal = {\aap},
	Keywords = {stars: formation, ISM: molecules, ISM: jets and outflows, ISM: individual objects: IRAS 16293, 2422},
	Month = jan,
	Pages = {L6},
	Primaryclass = {astro-ph.SR},
	Title = {{ALMA CO J = 6-5 observations of IRAS 16293-2422. Shocks and entrainment}},
	Volume = 549,
