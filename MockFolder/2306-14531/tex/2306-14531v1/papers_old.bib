	Journal = {\apj},
	Keywords = {accretion, accretion disks, magnetohydrodynamics: MHD, methods: numerical, planets and satellites: formation, protoplanetary disks},
	Month = aug,
	Pages = {75},
	Primaryclass = {astro-ph.EP},
	Title = {{Global Simulations of the Inner Regions of Protoplanetary Disks with Comprehensive Disk Microphysics}},
