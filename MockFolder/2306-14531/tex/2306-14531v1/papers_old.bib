	Title = {{First Detection of Water Vapor in a Pre-stellar Core}},
	Volume = 759,
	Year = 2012,
	Bdsk-File-1 = {},
	Bdsk-Url-1 = {http://dx.doi.org/10.1088/2041-8205/759/2/L37},
