@inproceedings{Kiyokane:2013aj,
	Abstract = {We observed C18O(1-0) line emission toward a low-mass prtostellar core L1527 in the Taurus Molecular Cloud at a distance of 140 pc with the Nobeyama 45 m telescope to reveal the velocity structure closely related to the evolution of low-mass star forming cores. We obtained a wide map covering 6' × 6', ˜0.2 pc × 0.2pc) with 15" spatial resolution and with a noise level of ˜0.1 K in TA* with 0.1 km/s. We found an increase of the velocity dispersion toward the molecular outflow in the 2nd moment map. This may be related to the mechanism of dispersing the parent dense core.},
