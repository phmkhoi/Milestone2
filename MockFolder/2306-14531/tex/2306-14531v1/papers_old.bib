	Doi = {10.1086/163759},
	Journal = {\apj},
	Keywords = {FLOW VELOCITY, KINETIC ENERGY, MASS DISTRIBUTION, MASS FLOW, MOLECULAR FLOW, MOMENTUM THEORY, CARBON MONOXIDE, EMISSION SPECTRA, HIGH SPEED, MOLECULAR ROTATION},
