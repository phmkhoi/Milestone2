	Keywords = {ISM: individual objects: L483, IRAS 18148-0440, ISM: molecules, stars: formation, stars: pre-main sequence, stars: winds, outflows},
	Month = aug,
	Pages = {72},
	Primaryclass = {astro-ph.SR},
