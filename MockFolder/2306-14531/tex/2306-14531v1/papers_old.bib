	Doi = {10.1086/177971},
	Journal = {\apj},
	Keywords = {ISM: JETS AND OUTFLOWS, ISM: INDIVIDUAL ALPHANUMERIC: TMC-1, ISM: INDIVIDUAL ALPHANUMERIC: TMC-1A, INFRARED: ISM: CONTINUUM, ISM: REFLECTION NEBULAE, STARS: FORMATION},
	Month = nov,
