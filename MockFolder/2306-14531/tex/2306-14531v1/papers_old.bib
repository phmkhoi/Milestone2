	Journal = {Protostars and Planets VI},
	Pages = {859-882},
	Primaryclass = {astro-ph.EP},
	Title = {{Deuterium Fractionation: The Ariadne's Thread from the Precollapse Phase to Meteorites and Comets Today}},
