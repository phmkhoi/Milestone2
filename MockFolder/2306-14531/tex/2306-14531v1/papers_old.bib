	Eprint = {1709.04987},
	Journal = {\mnras},
	Keywords = {methods: statistical, planetary systems},
	Month = jan,
	Pages = {784-795},
	Primaryclass = {astro-ph.EP},
	Title = {{Do planets remember how they formed?}},
	Volume = 473,
	Year = 2018,
