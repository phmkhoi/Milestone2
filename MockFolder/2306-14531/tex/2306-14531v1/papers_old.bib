	Date-Added = {2011-05-04 13:52:21 +0200},
	Date-Modified = {2011-05-04 13:52:22 +0200},
	Doi = {10.1051/0004-6361/201015098},
	Eprint = {1007.3408},
	Journal = {\aap},
	Keywords = {ISM: molecules, stars: formation, astrochemistry, ISM: individual objects: AFGL 2591},
	Month = oct,
	Pages = {L44+},
	Primaryclass = {astro-ph.SR},
	Title = {{Herschel/HIFI detections of hydrides towards AFGL 2591. Envelope emission versus tenuous cloud absorption}},
	Volume = 521,
	Year = 2010,
