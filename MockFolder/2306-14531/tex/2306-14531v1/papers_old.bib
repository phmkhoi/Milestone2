	Archiveprefix = {arXiv},
	Author = {{Justtanont}, K. and {Khouri}, T. and {Maercker}, M. and {Alcolea}, J. and {Decin}, L. and {Olofsson}, H. and {Sch{\"o}ier}, F.~L. and {Bujarrabal}, V. and {Marston}, A.~P. and {Teyssier}, D. and {Cernicharo}, J. and {Dominik}, C. and {de Koter}, A. and {Melnick}, G. and {Menten}, K.~M. and {Neufeld}, D. and {Planesas}, P. and {Schmidt}, M. and {Szczerba}, R. and {Waters}, R.},
	Date-Added = {2012-08-31 08:51:45 +0200},
