	Bdsk-Url-1 = {http://dx.doi.org/10.1086/164924}}

@article{Wilking:1989lr,
	Abstract = {Visible to millimeter wavelength observations of the global and individual aspects of low-mass star formation are discussed. Infrared and millimeter-wave techniques reveal large collections of dust-embedded young stellar objects associated with the densest regions of molecular clouds. Special attention is given to studies of the Taurus-Auriga and Rho Opiuchi molecular cloud complexes. Properties such as the bolometric luminosities and evolutionary states of young objects can be determined by modeling the 1-100-micron spectral energy distributions.},
