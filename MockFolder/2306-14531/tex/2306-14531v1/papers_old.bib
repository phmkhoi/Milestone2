	Author = {{Beasley}, A.~J.},
	Booktitle = {American Astronomical Society Meeting Abstracts},
	Date-Added = {2013-08-08 08:05:33 +0000},
	Date-Modified = {2013-08-08 08:05:34 +0000},
	Month = jun,
	Pages = {#205.01},
	Series = {American Astronomical Society Meeting Abstracts},
	Title = {{The Atacama Large Millimeter/submillimeter Array: A New Window on the Universe}},
	Volume = 222,
