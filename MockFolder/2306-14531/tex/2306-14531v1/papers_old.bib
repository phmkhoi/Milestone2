	Journal = {\aap},
	Keywords = {circumstellar matter, protoplanetary disks, radio lines: stars},
	Month = jul,
	Pages = {A117},
	Primaryclass = {astro-ph.SR},
	Title = {{The masses of young stars: CN as a probe of dynamical masses}},
	Volume = 567,
	Year = 2014,
	Bdsk-File-1 = {},
