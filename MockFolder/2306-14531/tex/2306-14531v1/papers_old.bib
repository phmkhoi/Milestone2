@article{Umemoto:1992yq,
	Abstract = {In the L1157 dark cloud, a well-collimated bipolar CO outflow associated with a cold IRAS source 20386 + 6751 was discovered. The gas temperature toward the blue lobe of the outflow rises to about 30 K from the temperature of the surrounding gas (not greater than 10 K); this high temperature region is very localized within the blue lobe. The HCO(+), HCN, and NH3 lines show blueshifted and broad-line profiles toward the blue CO lobe. Furthermore, their distributions are similar to that of the blue lobe. Analysis of the energy of the outflow and dense gas suggests that a strong shock caused by the outflow is responsible for the temperature enhancement. Such shock heating has rarely been observed in low-mass star-forming regions. These data show that the outflow has an influence on the thermal properties of the parent cloud at least locally through shock processes in its early evolutionary stage.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
	Adsurl = {http://adsabs.harvard.edu/abs/1992ApJ...392L..83U},
	Author = {{Umemoto}, T. and {Iwata}, T. and {Fukui}, Y. and {Mikami}, H. and {Yamamoto}, S. and {Kameya}, O. and {Hirano}, N.},
	Date-Added = {2012-09-25 13:52:29 +0200},
