@article{Tabone:2017fj,
	Abstract = {We wish to put tight constraints on the possible contribution of an MHD disk wind (DW) to the HH212 molecular jet. We use ALMA Cycle 4 to map the inner outflow at $0.13" \sim$ 60~au resolution, and compare with synthetic predictions for DW models. We identify in SO/SO$_2$ a rotating flow wider and slower than the axial SiO jet. The broad outflow cavity seen in C$^{34}$S is not carved by a fast wide-angle wind but by this slower agent. Rotation signatures may be fitted by a DW of moderate lever arm launched out to $\sim$ 40 au, with SiO tracing dust-free streamlines from 0.05-0.3 au. If indeed a DW, it could limit the core-to-star efficiency to $\leq 50\%$.},
	Adscomment = {Accepted for publication in AA letters, version uncorrected for language},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
