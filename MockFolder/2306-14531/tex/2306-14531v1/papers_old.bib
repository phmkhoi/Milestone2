	Journal = {\apss},
	Keywords = {accretion disks, jets and outflows, magnetohydrodynamics},
	Month = sep,
	Pages = {99-106},
	Title = {{On the MHD Acceleration of Astrophysical Jets}},
	Volume = 293,
