	Author = {{Zhang}, M. and {Brandner}, W. and {Wang}, H. and {Gennaro}, M. and {Bik}, A. and {Henning}, T. and {Gredel}, R. and {Smith}, M. and {Stanke}, T.},
	Date-Added = {2013-10-29 13:56:46 +0000},
