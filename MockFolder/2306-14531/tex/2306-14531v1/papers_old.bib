	Author = {{Chen}, X. and {Arce}, H.~G. and {Zhang}, Q. and {Bourke}, T.~L. and {Launhardt}, R. and {J{\o}rgensen}, J.~K. and {Lee}, C.-F. and {Foster}, J.~B. and {Dunham}, M.~M. and {Pineda}, J.~E. and {Henning}, T.},
	Date-Added = {2013-10-28 18:21:24 +0000},
