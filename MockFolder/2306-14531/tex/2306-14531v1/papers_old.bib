@article{Aarseth:1974fv,
	Abstract = {Comparison of the results of three different numerical methods for computing the evolution of a spherical star cluster from a given initial state, under the influence of internal relaxation: the N-body integration, the Monte Carlo method, and the fluid-dynamical approach. The general features of the evolution are very similar in all cases. The rates of evolution differ somewhat; for stars of equal masses, taking the N-body integrations as a reference, the Monte Carlo models evolve too fast by a factor 1.5, and the fluid-dynamical models by a factor 2 to 3.},
