	Doi = {10.1093/mnras/stz008},
	Eprint = {1901.00778},
	Journal = {\mnras},
	Keywords = {interplanetary medium, protoplanetary discs},
	Month = mar,
	Pages = {345-363},
	Primaryclass = {astro-ph.EP},
	Title = {{Physics of planet trapping with applications to HL Tau}},
	Volume = 484,
	Year = 2019,
	Bdsk-File-1 = {},
