	Doi = {10.1086/318651},
	Eprint = {arXiv:astro-ph/0008146},
	Journal = {\apj},
	Keywords = {ISM: Dust, Extinction, ISM: Clouds},
	Month = feb,
	Pages = {296-309},
	Title = {{Dust Grain-Size Distributions and Extinction in the Milky Way, Large Magellanic Cloud, and Small Magellanic Cloud}},
	Volume = 548,
	Year = 2001,
