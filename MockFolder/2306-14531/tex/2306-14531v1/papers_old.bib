	Author = {{Kawaguchi}, K. and {Muller}, S. and {Black}, J.~H. and {Amano}, T. and {Matsushima}, F. and {Fujimori}, R. and {Okabayahsi}, Y. and {Nagahiro}, H. and {Miyamoto}, Y. and {Tang}, J.},
	Date-Added = {2016-05-27 08:49:10 +0000},
	Date-Modified = {2016-05-27 08:49:10 +0000},
	Doi = {10.3847/0004-637X/822/2/115},
	Eid = {115},
	Journal = {\apj},
	Keywords = {galaxies: individual: PKS 1830{\ndash}211, ISM: individual objects: W31C, NGC 6334 I, ISM: molecules, methods: laboratory: molecular},
