@article{muller_rotational_2009,
	title = {Rotational spectra of isotopic species of methyl cyanide, {CH}3CN, in their ground vibrational states up to terahertz frequencies},
	volume = {506},
	issn = {0004-6361},
	url = {http://adsabs.harvard.edu/abs/2009A%26A...506.1487M},
	doi = {10.1051/0004-6361/200912932},
	abstract = {Context: Methyl cyanide is an important trace molecule in star-forming 
regions. It is one of the more common molecules used to derive kinetic
temperatures in such sources. Aims: As preparatory work for
Herschel, SOFIA, and in particular ALMA we want to improve the rest
frequencies of the main as well as minor isotopologs of methyl cyanide.
Methods: The laboratory rotational spectrum of methyl cyanide in
natural isotopic composition has been recorded up to 1.63 THz. Results: Transitions with good signal-to-noise ratio could be
identified for CH3CN, 13CH3CN, CH313CN,
CH3C15N, CH2DCN, and 13CH313CN in their
ground vibrational states up to about 1.2 THz. The main isotopic species
could be identified even in the highest frequency spectral recordings
around 1.6 THz. The highest J' quantum numbers included in the fit are
64 for 13CH313CN and 89 for the main isotopic
species. Greatly improved spectroscopic parameters have been obtained by
fitting the present data together with previously reported transition
frequencies. Conclusions: The present data will be helpful to
identify isotopologs of methyl cyanide in the higher frequency bands of
instruments such as the recently launched Herschel satellite, the
upcoming airplane mission SOFIA or the radio telescope array ALMA.},
	journal = {Astronomy and Astrophysics},
	author = {M\"uller, H. S. P. and Drouin, B. J. and Pearson, J. C.},
	month = nov,
	year = {2009},
	keywords = {ISM: molecules, Radio Lines: ISM, molecular data, techniques: spectroscopic, methods: laboratory},
	pages = {1487--1499},
	file = {NASA/ADS Full Text PDF:/Users/sandyzeng/Zotero/storage/GQEICEWN/Müller et al. - 2009 - Rotational spectra of isotopic species of methyl c.pdf:application/pdf}
}

@article{cazzoli_lamb-dip_2006,
	title = {The {Lamb}-dip spectrum of methylcyanide: {Precise} rotational transition frequencies and improved ground-state rotational parameters},
	volume = {240},
	issn = {0022-2852},
	shorttitle = {The {Lamb}-dip spectrum of methylcyanide},
	url = {http://adsabs.harvard.edu/abs/2006JMoSp.240..153C},
	doi = {10.1016/j.jms.2006.09.013},
	abstract = {Methylcyanide, CH 3CN, is an important interstellar species, 
and therefore the accurate knowledge of precise rest frequencies for
rotational transitions as well as ground-state rotational and hyperfine
constants is needed. In this work the hyperfine structure of the
millimeter- and submillimeter-wave spectra of CH 3CN has been
further investigated. In addition, accurate THz measurements have been
carried out for the first time. Consequently, the present investigation
allowed us to provide the most accurate ground state rotational and
hyperfine parameters known at the moment for CH 3C
14N. To resolve the hyperfine structure of the rotational
transitions observed, the Lamb-dip technique has been exploited. Both
frequency-modulated and video-type detections have been employed.},
	journal = {Journal of Molecular Spectroscopy},
	author = {Cazzoli, Gabriele and Puzzarini, Cristina},
	month = dec,
	year = {2006},
	pages = {153--163}
}

@article{taniguchi_$^13$c_2017,
	title = {\${\textasciicircum}\{13\}\${C} isotopic fractionation of {HC}\$\_\{3\}\${N} in two starless cores: {L}1521B and {L}134N ({L}183)},
	shorttitle = {\${\textasciicircum}\{13\}\${C} isotopic fractionation of {HC}\$\_\{3\}\${N} in two starless cores},
	url = {http://arxiv.org/abs/1707.08267},
	abstract = {We observed the \$J=5-4\$ rotational lines of the normal species and three \${\textasciicircum}\{13\}\$C isotopologues of HC\$\_\{3\}\$N at the 45 GHz band toward two low-mass starless cores, L1521B and L134N (L183), using the Nobeyama 45 m radio telescope in order to study the main formation pathways of HC\$\_\{3\}\$N in each core. The abundance ratios of the three \${\textasciicircum}\{13\}\$C isotopologues in L1521B are derived to be [H\${\textasciicircum}\{13\}\$CCCN]:[HC\${\textasciicircum}\{13\}\$CCN]:[HCC\${\textasciicircum}\{13\}\$CN] = 0.98 (+- 0.14) : 1.00 : 1.52 (+- 0.16) (1 sigma). The fractionation pattern is consistent with that at the cyanopolyyne peak in Taurus Molecular Cloud-1. This fractionation pattern suggests that the main formation pathway of HC\$\_\{3\}\$N is the neutral-neutral reaction between C\$\_\{2\}\$H\$\_\{2\}\$ and CN. On the other hand, their abundance ratios in L134N are found to be [H\${\textasciicircum}\{13\}\$CCCN]:[HC\${\textasciicircum}\{13\}\$CCN]:[HCC\${\textasciicircum}\{13\}\$CN]= 1.5 (+- 0.2) : 1.0 : 2.1 (+- 0.4) (1 sigma), which are different from those in L1521B. From this fractionation pattern, we propose that the reaction between HNC and CCH is a possible main formation pathway of HC\$\_\{3\}\$N in L134N. We find out that the main formation pathways of the same molecule are not common even in the similar physical conditions. We discuss the possible factors to make a difference in fractionation pattern between L134N and L1521B/TMC-1.},
	journal = {arXiv:1707.08267 [astro-ph]},
	author = {Taniguchi, Kotomi and Ozeki, Hiroyuki and Saito, Masao},
	month = jul,
	year = {2017},
	note = {arXiv: 1707.08267},
	keywords = {Astrophysics - Astrophysics of Galaxies, Astrophysics - Solar and Stellar Astrophysics},
	annote = {Comment: Accepted for publication in ApJ, 11pages, 4 figures, 2 tables},
	file = {arXiv\:1707.08267 PDF:/Users/sandyzeng/Zotero/storage/AHC58FFK/Taniguchi et al. - 2017 - \$^ 13 \$C isotopic fractionation of HC\$_ 3 \$N in tw.pdf:application/pdf;arXiv.org Snapshot:/Users/sandyzeng/Zotero/storage/HE9QFECQ/1707.html:text/html}
}

