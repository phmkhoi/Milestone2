	annote = {Comment: Accepted by PASJ (Publications of the Astronomical Society of Japan) letter, 1 Figure, 2 Tables},
	file = {arXiv\:1706.08662 PDF:/Users/sandyzeng/Zotero/storage/7QH584JE/Taniguchi and Saito - 2017 - First Detection of HC\$_ 5 \$\$^ 15 \$N in the Interst.pdf:application/pdf;arXiv.org Snapshot:/Users/sandyzeng/Zotero/storage/WXAC7IHB/1706.html:text/html}
