}

@article{armijos-abendano_3_2014,
	title = {3 mm spectral line survey of two lines of sight toward two typical cloud complexes in the {Galactic} {Center}},
	volume = {446},
	issn = {0035-8711, 1365-2966},
	url = {http://arxiv.org/abs/1410.5762},
	doi = {10.1093/mnras/stu2271},
	abstract = {We present the results of two Mopra 3-mm spectral line surveys of the Lines of Sight (LOS) toward the Galactic Center (GC) molecular complexes Sgr B2 (LOS+0.693) and Sgr A (LOS-0.11). The spectra covered the frequency ranges of {\textasciitilde}77-93 GHz and {\textasciitilde}105-113 GHz. We have detected 38 molecular species and 25 isotopologues. The isotopic ratios derived from column density ratios are consistent with the canonical values, indicating that chemical isotopic fractionation and/or selective photodissociation can be considered negligible ({\textless}10\%) for the GC physical conditions. The derived abundance and rotational temperatures are very similar for both LOSs, indicating very similar chemical and excitation conditions for the molecular gas in the GC. The excitation conditions are also very similar to those found for the nucleus of the starburst galaxy NGC 253. We report for the first time the detection of HCO and HOC+ emission in LOS+0.693. Our comparison of the abundance ratios between CS, HCO, HOC+ and HCO+ found in the two LOSs with those in typical Galactic photodissociation regions (PDRs) and starbursts galaxies does not show any clear trend to distinguish between UV and X-ray induced chemistries. We propose that the CS/HOC+ ratio could be used as a tracer of the PDR components in the molecular clouds in the nuclei of galaxies.},
	number = {4},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Armijos-Abenda\~no, J. and Mart\'in-Pintado, J. and Requena-Torres, M. A. and Mart\'in, S. and Rodr\'iguez-Franco, A.},
	month = dec,
	year = {2014},
	note = {arXiv: 1410.5762},
	keywords = {Astrophysics - Astrophysics of Galaxies},
	pages = {3842--3862},
	file = {arXiv\:1410.5762 PDF:/Users/sandyzeng/Zotero/storage/Q4RRR37Z/Armijos-Abendaño et al. - 2014 - 3 mm spectral line survey of two lines of sight to.pdf:application/pdf;arXiv.org Snapshot:/Users/sandyzeng/Zotero/storage/IM3JRKH7/1410.html:text/html}
}

@article{gibb_chemistry_2000,
	title = {Chemistry of the {Organic}-{Rich} {Hot} {Core} {G}327.3-0.6},
	volume = {545},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/2000ApJ...545..309G},
	doi = {10.1086/317805},
	abstract = {We present gas-phase abundances of species found in the organic-rich hot core G327.3-0.6. The data were taken with the Swedish-ESO Submillimetre Telescope (SEST). The 1-3 mm spectrum of this source is dominated by emission features of nitrile species and saturated organics, with abundances greater than those found in many other hot cores, including Sgr B2 and OMC-1. Population diagram analysis indicates that many species (CH3CN, C2H3CN,
C2H5CN, CH3OH, etc.) have hot
components that originate in a compact ({\textasciitilde}2") region. Gas-phase chemical models cannot reproduce the high abundances of these molecules found in hot cores, and we suggest that they originate from processing and evaporation of icy grain mantle material. In addition, we report the first detection of vibrationally excited ethyl cyanide and the first detection of methyl mercaptan (CH3SH) outside the Galactic center.},
	journal = {The Astrophysical Journal},
