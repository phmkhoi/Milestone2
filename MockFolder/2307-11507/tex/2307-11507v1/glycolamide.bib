@article{cuadrado_chemistry_2015,
	title = {The chemistry and spatial distribution of small hydrocarbons in {UV}-irradiated molecular clouds: the {Orion} {Bar} {PDR}},
	volume = {575},
	issn = {0004-6361, 1432-0746},
	shorttitle = {The chemistry and spatial distribution of small hydrocarbons in {UV}-irradiated molecular clouds},
	url = {http://arxiv.org/abs/1412.0417},
	doi = {10.1051/0004-6361/201424568},
	abstract = {We study the spatial distribution and chemistry of small hydrocarbons in the Orion Bar PDR. We used the IRAM-30m telescope to carry out a millimetre line survey towards the Orion Bar edge, complemented with {\textasciitilde}2'x2' maps of the C2H and c-C3H2 emission. We analyse the excitation of the detected hydrocarbons and constrain the physical conditions of the emitting regions with non-LTE radiative transfer models. We compare the inferred column densities with updated gas-phase photochemical models including 13CCH and C13CH isotopomer fractionation. {\textasciitilde}40\% of the lines in the survey arise from hydrocarbons (C2H, C4H, c-C3H2, c-C3H, C13CH, 13CCH, l-C3H and l-H2C3). We detect new lines from l-C3H+ and improve its rotational spectroscopic constants. Anions or deuterated hydrocarbons are not detected: [C2D]/[C2H]{\textless}0.2\%, [C2H-]/[C2H]{\textless}0.007\% and [C4H-]/[C4H]{\textless}0.05\%. Our gas-phase models can reasonably match the observed column densities of most hydrocarbons (within factors {\textless}3). Since the observed spatial distribution of the C2H and c-C3H2 emission is similar but does not follow the PAH emission, we conclude that, in high UV-flux PDRs, photodestruction of PAHs is not a necessary requirement to explain the observed abundances of the smallest hydrocarbons. Instead, gas-phase endothermic reactions (or with barriers) between C+, radicals and H2 enhance the formation of simple hydrocarbons. Observations and models suggest that the [C2H]/[c-C3H2] ratio ({\textasciitilde}32 at the PDR edge) decreases with the UV field attenuation. The observed low cyclic-to-linear C3H column density ratio ({\textless}3) is consistent with a high electron abundance (Xe) PDR environment. In fact, the poorly constrained Xe gradient influences much of the hydrocarbon chemistry in the more UV-shielded gas. We propose that reactions of C2H isotopologues with 13C+ and H atoms can explain the observed [C13CH]/[13CCH]=1.4(0.1) fractionation level.},
	journal = {Astronomy \& Astrophysics},
	author = {Cuadrado, S. and Goicoechea, J. R. and Pilleri, P. and Cernicharo, J. and Fuente, A. and Joblin, C.},
	month = mar,
	year = {2015},
	note = {arXiv: 1412.0417},
	keywords = {Astrophysics - Astrophysics of Galaxies},
	pages = {A82},
	annote = {Comment: 30 pages, 23 figures, 15 tables. Accepted for publication in A\&A (English edited, abstract abridged)},
	file = {arXiv\:1412.0417 PDF:/Users/sandyzeng/Zotero/storage/ZKWBD7MQ/Cuadrado et al. - 2015 - The chemistry and spatial distribution of small hy.pdf:application/pdf;arXiv.org Snapshot:/Users/sandyzeng/Zotero/storage/PKB5EFBN/1412.html:text/html}
}

@article{harada_chemical_2015,
	title = {Chemical {Features} in the {Circumnuclear} {Disk} of the {Galactic} {Center}},
	volume = {584},
	issn = {0004-6361, 1432-0746},
	url = {http://arxiv.org/abs/1510.02904},
	doi = {10.1051/0004-6361/201526994},
	abstract = {The circumnuclear disk (CND) of the Galactic Center is exposed to many energetic phenomena coming from the supermassive black hole Sgr A* and stellar activities. These energetic activities can affect the chemical composition in the CND by the interaction with UV-photons, cosmic-rays, X-rays, and shock waves. We aim to constrain the physical conditions present in the CND by chemical modeling of observed molecular species detected towards it. We analyzed a selected set of molecular line data taken toward a position in the southwest lobe of the CND with the IRAM 30m and APEX 12-meter telescopes and derived the column density of each molecule using a large velocity gradient (LVG) analysis. The determined chemical composition is compared with a time-dependent gas-grain chemical model based on the UCL{\textbackslash}\_CHEM code that includes the effects of shock waves with varying physical parameters. Molecules such as CO, HCN, HCO\${\textasciicircum}+\$, HNC, CS, SO, SiO, NO, CN, H\$\_2\$CO, HC\$\_3\$N, N\$\_2\$H\${\textasciicircum}+\$ and H\$\_3\$O\${\textasciicircum}+\$ are detected and their column densities are obtained. Total hydrogen densities obtained from LVG analysis range between \$2 {\textbackslash}times 10{\textasciicircum}4\$ and \$1 {\textbackslash}times 10{\textasciicircum}6{\textbackslash},\$cm\${\textasciicircum}\{-3\}\$ and most species indicate values around several \${\textbackslash}times 10{\textasciicircum}5{\textbackslash},\$cm\${\textasciicircum}\{-3\}\$, which are lower than values corresponding to the Roche limit, which shows that the CND is tidally unstable. The chemical models show good agreement with the observations in cases where the density is \${\textbackslash}sim10{\textasciicircum}4{\textbackslash},\$cm\${\textasciicircum}\{-3\}\$, the cosmic-ray ionization rate is high, \${\textgreater}10{\textasciicircum}\{-15\} {\textbackslash},\$s\${\textasciicircum}\{-1\}\$, or shocks with velocities \${\textgreater} 40{\textbackslash},\$km s\${\textasciicircum}\{-1\}\$ have occurred. Comparison of models and observations favors a scenario where the cosmic-ray ionization rate in the CND is high, but precise effects of other factors such as shocks, density structures, UV-photons and X-rays from the Sgr A* must be examined with higher spatial resolution data.},
	journal = {Astronomy \& Astrophysics},
	author = {Harada, N. and Riquelme, D. and Viti, S. and Jim\'enez-Serra, I. and Requena-Torres, M. A. and Menten, K. M. and Mart\'in, S. and Aladro, R. and Mart\'in-Pintado, J. and Hochg\"urtel, S.},
	month = dec,
	year = {2015},
	note = {arXiv: 1510.02904},
	keywords = {Astrophysics - Astrophysics of Galaxies},
	pages = {A102},
	annote = {Comment: 17 Pages, 13 figures, accepted for publication in A\&A},
	file = {arXiv\:1510.02904 PDF:/Users/sandyzeng/Zotero/storage/52P5U8E8/Harada et al. - 2015 - Chemical Features in the Circumnuclear Disk of the.pdf:application/pdf;arXiv.org Snapshot:/Users/sandyzeng/Zotero/storage/94UAURSR/1510.html:text/html}
}

@article{goto_absorption_2008,
	title = {Absorption {Line} {Survey} of {H}3+ toward the {Galactic} {Center} {Sources} {II}. {Eight} {Infrared} {Sources} within 30 pc of the {Galactic} {Center}},
	volume = {688},
	issn = {0004-637X, 1538-4357},
	url = {http://arxiv.org/abs/0807.4522},
	doi = {10.1086/591657},
	abstract = {Infrared absorption lines of H3+, including the metastable R(3,3)l line, have been observed toward eight bright infrared sources associated with hot and massive stars located in and between the Galactic Center Cluster and the Quintuplet Cluster 30 pc to the east. The absorption lines with high velocity dispersion arise in the Galaxy's Central Molecular Zone (CMZ) as well as in foreground spiral arms. The temperature and density of the gas in the CMZ, as determined from the relative strengths of the H3+ lines, are T=200-300K and n=50-200cm{\textasciicircum}-3. The detection of high column densities of H3+ toward all eight stars implies that this warm and diffuse gaseous environment is widespread in the CMZ. The products of the ionization rate and path length for these sight lines are 1000 and 10 times higher than in dense and diffuse clouds in the Galactic disk, respectively, indicating that the ionization rate, zeta, is not less than 10{\textasciicircum}-15 s{\textasciicircum}-1 and that L is at least on the order of 50 pc. The warm and diffuse gas is an important component of the CMZ, in addition to the three previously known gaseous environments: (1) cold molecular clouds observed by radio emission of CO and other molecules, (2) hot (T=10{\textasciicircum}4-10{\textasciicircum}6K) and highly ionized diffuse gas (n\_e=10-100cm{\textasciicircum}-3) seen in radio recombination lines, far infrared atomic lines, and radio-wave scattering, and (3) ultra-hot (T=10{\textasciicircum}7-10{\textasciicircum}8K) X-ray emitting plasma. Its prevalence significantly changes the understanding of the environment of the CMZ. The sight line toward GC IRS 3 is unique in showing an additional H3+ absorption component, which is interpreted as due to either a cloud associated with circumnuclear disk or the "50 km s{\textasciicircum}-1 cloud" known from radio observations. An infrared pumping scheme is examined as a mechanism to populate the (3,3) metastable level in this cloud.},
	number = {1},
	journal = {The Astrophysical Journal},
	author = {Goto, Miwa and Usuda, T. and Nagata, T. and Geballe, T. R. and McCall, B. J. and Indriolo, N. and Suto, H. and Henning, Th and Morong, C. P. and Oka, Takeshi},
	month = nov,
	year = {2008},
	note = {arXiv: 0807.4522},
	keywords = {Astrophysics},
	pages = {306--319},
	annote = {Comment: 15 pages, 5 figures, 4 tables Accepted for publication in the Astrophysical Journal},
	file = {arXiv\:0807.4522 PDF:/Users/sandyzeng/Zotero/storage/KCHZ986H/Goto et al. - 2008 - Absorption Line Survey of H3+ toward the Galactic .pdf:application/pdf;arXiv.org Snapshot:/Users/sandyzeng/Zotero/storage/TBMTJIC9/0807.html:text/html}
}

@article{sanchez-monge_physical_2017,
	title = {The physical and chemical structure of {Sagittarius} {B}2. {II}. {Continuum} millimeter emission of {SgrB}2({M}) and {SgrB}2({N}) with {ALMA}},
	url = {http://arxiv.org/abs/1704.01805},
	abstract = {The high-mass star forming sites SgrB2(M) and SgrB2(N) have been the target of numerous studies, revealing e.g. a rich chemistry. We want to characterize their physical and chemical structure using ALMA high-angular resolution observations at mm wavelengths, reaching spatial scales of about 4000 au, and covering the whole band 6 (from 211 to 275 GHz). In order to determine the continuum emission in line-rich sources, we use a new statistical method: STATCONT. We detect 27 continuum sources in SgrB2(M) and 20 in SgrB2(N). We study the continuum emission across the ALMA band 6, and compare it with previous SMA 345 GHz and VLA 40 GHz observations, to study the nature of the sources detected. The brightest sources are dominated by (partially optically thick) dust emission, while there is an important degree of contamination from ionized gas free-free emission in weaker sources. While the total mass in SgrB2(M) is distributed in many fragments, most of the mass in SgrB2(N) arises from a single object, with filamentary-like structures converging towards the center. There seems to be a lack of low-mass dense cores in both regions. We determine H2 volume densities for the cores of about 10{\textasciicircum}5-10{\textasciicircum}7 Msun pc{\textasciicircum}-3, one to two orders of magnitude higher than the stellar densities of super star clusters. In general, SgrB2(N) is chemically richer than SgrB2(M). There seems to be a correlation between the chemical richness and the mass of the fragments, with more massive clumps being more chemically rich. Both SgrB2(N) and SgrB2(M) harbour a cluster of hot molecular cores. We compare the continuum images with predictions from a detailed 3D radiative transfer model that reproduces the structure of SgrB2 from 45 pc down to 100 au. This dataset, together with ongoing projects in the range 5 to 200 GHz, better constrain the 3D structure of SgrB2, and allow us to understand its physical and chemical structure.},
	journal = {arXiv:1704.01805 [astro-ph]},
	author = {Sanchez-Monge, A. and Schilke, P. and Schmiedeke, A. and Ginsburg, A. and Cesaroni, R. and Lis, D. C. and Qin, S.-L. and Mueller, H. S. P. and Bergin, E. and Comito, C. and Moeller, Th},
	month = apr,
	year = {2017},
	note = {arXiv: 1704.01805},
	keywords = {Astrophysics - Astrophysics of Galaxies},
	annote = {Comment: Accepted for publication in Astronomy \& Astrophysics. 20 pages with 13 figures and 4 tables, plus Appendices with extra figures and tables. (Abstract modified)},
	file = {arXiv\:1704.01805 PDF:/Users/sandyzeng/Zotero/storage/WD8Z5462/Sanchez-Monge et al. - 2017 - The physical and chemical structure of Sagittarius.pdf:application/pdf;arXiv.org Snapshot:/Users/sandyzeng/Zotero/storage/3SZVIZ7W/1704.html:text/html}
}




