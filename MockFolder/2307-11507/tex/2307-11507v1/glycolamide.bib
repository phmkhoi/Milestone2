@article{hily-blant_direct_2017,
	title = {Direct evidence of multiple reservoirs of volatile nitrogen in a protosolar nebula analogue},
	url = {http://arxiv.org/abs/1706.10095},
	abstract = {Isotopic ratios are keys to understanding the origin and early evolution of the solar system in the context of Galactic nucleosynthesis. The large range of measured \${\textasciicircum}\{14\}\$N/\${\textasciicircum}\{15\}\$N isotopic ratios in the solar system reflects distinct reservoirs of nitrogen whose origins remain to be determined. We have directly measured a C\${\textasciicircum}\{14\}\$N/C\${\textasciicircum}\{15\}\$N abundance ratio of 323\${\textbackslash}pm\$30 in the disk orbiting the nearby young star TW Hya. This value, which is in good agreement with nitrogen isotopic ratios measured for prestellar cores, likely reflects the primary present-day reservoir of nitrogen in the solar neighbourhood. These results support models invoking novae as primary \${\textasciicircum}\{15\}\$N sources as well as outward migration of the Sun over its lifetime, and suggest that comets sampled a secondary, \${\textasciicircum}\{15\}\$N-rich reservoir during solar system formation.},
	journal = {arXiv:1706.10095 [astro-ph]},
	author = {Hily-Blant, Pierre and Magalhães, Victor and Kastner, Joel and Faure, Alexandre and Forveille, Thierry and Qi, Chunhua},
	month = jun,
