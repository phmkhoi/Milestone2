@article{cali_balancing_2007,
	title = {Balancing {Human} {Rights}? {Methodological} {Problems} with {Weights}, {Scales} and {Proportions}},
	volume = {29},
	issn = {0275-0392},
	shorttitle = {Balancing {Human} {Rights}?},
	url = {https://www.jstor.org/stable/20072795},
	abstract = {This article takes issue with the argument that human rights are not absolute and should be balanced in relation to competing communal aims. The balancing of qualified human rights is a key practice of the European Court of Human Rights and a great deal depends on a clear analysis of the ramifications of balancing for our understanding of human rights aims. The author does not seek to propose an alternative to balancing, but aims to show that it is not necessarily coherent with human rights principles or the kinds of functions international human rights institutions are thought to perform.},
	number = {1},
	urldate = {2021-11-27},
	journal = {Human Rights Quarterly},
	author = {Çalı, Başak},
	year = {2007},
	note = {Publisher: Johns Hopkins University Press},
	pages = {251--270},
}

