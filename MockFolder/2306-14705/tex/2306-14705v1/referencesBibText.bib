	volume = {42},
	issn = {1099-0488},
	shorttitle = {Comment on the dynamic bead size and {Kuhn} segment length in polymers},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/polb.20235},
	doi = {10.1002/polb.20235},
	abstract = {Discrepancies between the length of a traditionally defined Kuhn segment length (lk) and a bead size estimated from experimental data have been reported in a number of articles. In this work we emphasize that the traditional definition of the Kuhn segment is an oversimplification and the characteristic ratio, C∞, is not the only parameter that defines a bead size. We show that the dynamic bead size in polystyrene (PS) might be as large as ∼50 monomers, whereas the traditionally defined Kuhn segment is ∼8–10 monomers. It is shown that with 50 monomers (M ∼ 5000) as a size of the dynamic bead, one can explain many inconsistencies in the interpretation of compliance and mechanical relaxation data known for low-molecular weight PS. © 2004 Wiley Periodicals, Inc. J Polym Sci Part B: Polym Phys 42: 3505–3511, 2004},
