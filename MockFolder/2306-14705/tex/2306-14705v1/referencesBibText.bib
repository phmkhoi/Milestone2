	keywords = {Coarse-grained models, Computational methods, Soft materials, Theoretical chemistry},
	pages = {1--9},
	file = {Full Text PDF:/Users/palomagr/Zotero/storage/NN3S5QSI/Wang and Gómez-Bombarelli - 2019 - Coarse-graining auto-encoders for molecular dynami.pdf:application/pdf},
}

@article{doerr_torchmd_2021,
	title = {{TorchMD}: {A} {Deep} {Learning} {Framework} for {Molecular} {Simulations}},
