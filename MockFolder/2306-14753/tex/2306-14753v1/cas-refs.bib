@article{Almedeij2005,
abstract = {Perennial gravel streams are usually dominated by a bed material stratified in terms of grain size, with a coarse surface layer overlying a finer subsurface (Figure 1a). However, field observations from some ephemeral gravel streams in the Middle East and other locations exhibit the opposite stratification (Figure 1b). Recent studies have found that under the same range of flow strengths, such an ephemeral stream has a much higher transport efficiency of bed load sediment (the movement of particles by rolling and sliding on the bed, or by making short hops of a few grain diameters in distance), which suggests a completely different behavior from perennial streams [e.g., Laronne and Reid, 1993; Reid and Laronne, 1995].},
author = {Almedeij, Jaber and Diplas, Panayiotis},
doi = {10.1029/2005EO440002},
journal = {Eos, Trans. Am. Geophys. Union},
number = {44},
pages = {429},
title = {{Bed load sediment transport in ephemeral and perennial gravel bed streams}},
volume = {86},
year = {2005}
}
@article{Villaret2013,
abstract = {The open-source finite-element system Telemac has been applied to simulate various complex hydrodynamic and morphodynamic situations including waterways, curved channels, recirculating flows and wave-induced littoral transport. In the applications presented here, the sediment transport model is mainly restricted to the transport of non-cohesive sediments, which relies on classical semi-empirical concepts including sand grading effects, parameterization of secondary currents and wave effects. In comparison with other comprehensive modeling systems (Delft-3D, Mike-21, etc.), the main originality lies in the efficiency and flexibility of the finite elements. Thanks to the optimization of numerical schemes, parallelism, as well as tremendous progress in the performance of computers, bed evolution can be calculated on basin scale (10-100. km) and for the medium term (years to decades), without the use of hydrodynamic filtering methods. As a novelty in release 6.0, we present a method of feedback for the bed roughness, which reduces uncertainty in the prediction of both transport rates and flow velocities. {\textcopyright} 2011 Elsevier Ltd.},
author = {Villaret, Catherine and Hervouet, Jean Michel and Kopmann, Rebekka and Merkel, Uwe and Davies, Alan G.},
file = {:C$\backslash$:/Users/mohammadi/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Villaret et al. - 2013 - Morphodynamic modeling using the Telemac finite-element system.pdf:pdf},
journal = {Computers \& Geosciences},
keywords = {Bed roughness,Littoral transport,Long-term morphodynamics,Non-cohesive sediment,River flow,Secondary currents},
pages = {105--113},
publisher = {Elsevier},
title = {{Morphodynamic modeling using the Telemac finite-element system}},
volume = {53},
year = {2013}
}
