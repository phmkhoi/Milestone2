@article{Bayes,
abstract = {Nous pouvons aujourd'hui interagir avec nos ordinateurs et t{\'{e}}l{\'{e}}phones portables non seulement par clavier ou {\'{e}}cran tactile, mais {\'{e}}galement par la voix. Les syst{\`{e}}mes de reconnaissance automatique peuvent {\^{e}}tre utilis{\'{e}}s pour la prise de notes, la r{\'{e}}daction de messages {\'{e}}lectroniques, de rapports m{\'{e}}dicaux... Les transcriptions automatiques permettent leindexation automatis{\'{e}}s de donn{\'{e}}es multim{\'{e}}dia et r{\'{e}}pr{\'{e}}sentent une {\'{e}}tape-cl{\'{e}} pour la recherche d'information et l'acc{\`{e}}s au contenu. Des applications incluant la traduction orale commencent {\`{a}} {\'{e}}merger {\`{a}} grande {\'{e}}chelle. Les progr{\`{e}}s {\'{e}}poustouflants de la reconnaissance automatique de la parole durant ces derni{\`{e}}res d{\'{e}}cennies sont connus pour {\^{e}}tre largement dus {\`{a}} une approche statistique bay{\'{e}}sienne, approche qui s'appuie sur de grandes quantit{\'{e}}s de donn{\'{e}}es langagi{\`{e}}res, en modalit{\'{e}}s {\`{a}} la fois orale et {\'{e}}crite. Il est {\'{e}}galement largement admis que cette approche fait abstraction du sens et se limite au traitement des formes de surface, c'est-{\`{a}}-dire le signal acoustique pour l'oral et le flux de mots (formes graph{\'{e}}miques) pour l'{\'{e}}crit. Nous allons revenir sur l'historique du domaine de la reconnaissance automatique de la parole qui, {\`{a}} ses d{\'{e}}buts, visait de mani{\`{e}}re plus ambitieuse la compr{\'{e}}hension automatique de la parole, et donc l'acc{\`{e}}s au sens. La question du sens ou de la compr{\'{e}}hension a d{\^{u}} {\^{e}}tre abandonn{\'{e}}e pour traiter le "simple" probl{\`{e}}me de transformation du signal acoustique en flux de mots {\'{e}}crits, qui s'est r{\'{e}}v{\'{e}}l{\'{e}}, en fait, extr{\^{e}}mement complexe. Nous allons ensuite pr{\'{e}}senter les composantes essentielles d'un syst{\`{e}}me de transcription automatique en mettant en avant les connaissances et niveaux linguistiques impliqu{\'{e}}s et en nous interrogeant sur la primaut{\'{e}} suppos{\'{e}}e des formes sur le sens.},
