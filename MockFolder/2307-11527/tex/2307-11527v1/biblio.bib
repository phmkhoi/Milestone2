@article{particlesystems,
title = {Pathwise regularisation of singular interacting particle systems and their mean field limits},
journal = {Stochastic Processes and their Applications},
volume = {159},
pages = {499-540},
year = {2023},
issn = {0304-4149},
doi = {https://doi.org/10.1016/j.spa.2023.02.005},
url = {https://www.sciencedirect.com/science/article/pii/S0304414923000327},
author = {Fabian A. Harang and Avi Mayorcas},
keywords = {Regularisation by noise, Interacting particle systems, Propagation of chaos, Averaged fields},
abstract = {We investigate the regularising effect of certain perturbations by noise in singular interacting particle systems under the mean field scaling. In particular, we show that the addition of a suitably irregular path can regularise these dynamics and we recover the McKean–Vlasov limit under very broad assumptions on the interaction kernel; only requiring it to be controlled in a possibly distributional Besov space. In the particle system we include two sources of randomness, a common noise path Z which regularises the dynamics and a family of idiosyncratic noises, which we only assume to converge in mean field scaling to a representative noise in the McKean–Vlasov equation.}
}
