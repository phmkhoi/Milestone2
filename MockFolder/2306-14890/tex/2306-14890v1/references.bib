@article{atkinson_dare_2020,
	title = {Dare {Architecture} and {Technology}  {D2}.2},
	url = {https://zenodo.org/record/4733801},
	doi = {10.5281/zenodo.4733801},
	abstract = {DARE is an ambitious project that aims to provide novel approaches for creating and using data-powered methods at the frontiers of today’s research and innovation. DARE’s central goal is to support research developers – domain-expert software developers – to transparently make use of European e-infrastructures, research infrastructures and other platforms and software in order to create data- and computationally-intensive applications for their domains. DARE aims to achieve these goals by providing much needed technology and methodology aligned with EOSC developments. We present progress since D2.1 with an interim report ID2.2 and the new understanding of what is required from the DARE architecture, driven by the interplay of user requirements and technological opportunities. These are constrained and enhanced to yield future utility, extensibility and sustainability. New requirements for users to directly create and control complex computational and data challenges are pushing DARE to extend its integration, automation and optimisation. The initial progress with these is presented and evaluated. They lead to a strategy for sustainability.},
	language = {eng},
	urldate = {2021-08-20},
	author = {Atkinson, Malcolm and Klampanos, Iraklis and Andries, Valentina and Constantin, Aurora and Rosa, Filgueira and Genünd, André and Gottschämmer, Ellen and Vangelis, Karkaletsis and Koukourikos, Antonis and Amélie, Levray and Mike, Linder and Federica, Magnoni and Pagé, Christian and Andreas, Rietbrock and Alessandro, Spinuso and Chrysoula, Themeli and Xenofon, Tsilimparis and Wolf, Fabian},
