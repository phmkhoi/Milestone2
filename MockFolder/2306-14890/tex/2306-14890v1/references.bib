@inproceedings{morel_sok_2020,
	address = {New York, NY, USA},
	series = {{WPES}'20},
	title = {{SoK}: {Three} {Facets} of {Privacy} {Policies}},
	isbn = {978-1-4503-8086-7},
	shorttitle = {{SoK}},
	url = {https://doi.org/10.1145/3411497.3420216},
	doi = {10.1145/3411497.3420216},
	abstract = {Privacy policies are the main way to obtain information related to personal data collection and processing. Originally, privacy policies were presented as textual documents. However, the unsuitability of this format for the needs of today's society gave birth to other means of expression. In this paper, we systematically study the different means of expression of privacy policies. In doing so, we have explored the three main categories, which we call facets, i.e., natural language, graphical and machine-readable privacy policies. Each of these facets focuses on the particular needs of the communities they come from, ie, law experts, organizations and privacy advocates, and academics, respectively. We then analyze the benefits and limitations of each facet, and explain why solutions based on a single facet do not cover the needs of other communities. Finally, we set guidelines and discuss challenges of an approach to expressing privacy policies which brings together the benefits of each facet as an attempt to overcome their limitations.},
	urldate = {2022-12-06},
	booktitle = {Proceedings of the 19th {Workshop} on {Privacy} in the {Electronic} {Society}},
	publisher = {Association for Computing Machinery},
	author = {Morel, Victor and Pardo, Raúl},
	year = {2020},
	keywords = {enforcement, legal compliance, privacy policies, usability},
	pages = {41--56},
}

@incollection{bartsch_let_2022,
	address = {Wiesbaden},
	series = {{DuD}-{Fachbeiträge}},
	title = {Let the {Computer} {Say} {NO}! {The} {Neglected} {Potential} of {Policy} {Definition} {Languages} for {Data} {Sovereignty}},
	isbn = {978-3-658-33306-5},
	url = {https://doi.org/10.1007/978-3-658-33306-5_22},
	abstract = {During interaction with today’s internet services and platform ecosystems, consumer data is often harvested and shared without their consent; that is, consumers seized to be the sovereigns of their own data with the proliferation of the internet. Due to the rapid and abundant nature of interactions in today’s platform ecosystems, manual consent management is impractical. To support development of semi-automated solutions for reestablishing data sovereignty, we investigate the use of policy definition languages as machine-readable and enforceable mechanisms for fostering data sovereignty. We conducted a realist literature review of the capabilities of policy definition languages developed for pertinent application scenarios (e.g., for access control in cloud computing). We consolidate extant literature into a framework of the chances and challenges of leveraging policy definition languages as central building blocks for data sovereignty in platform ecosystems.},
	language = {de},
	urldate = {2022-12-06},
	booktitle = {Selbstbestimmung, {Privatheit} und {Datenschutz} : {Gestaltungsoptionen} für einen europäischen {Weg}},
	publisher = {Springer Fachmedien},
	author = {Bartsch, Jan and Dehling, Tobias and Lauf, Florian and Meister, Sven and Sunyaev, Ali},
	editor = {Friedewald, Michael and Kreutzer, Michael and Hansen, Marit},
	year = {2022},
	doi = {10.1007/978-3-658-33306-5_22},
	keywords = {Data sovereignty, Digital platforms, Platform ecosystems, Policy driven management, Policy languages},
	pages = {449--468},
}

