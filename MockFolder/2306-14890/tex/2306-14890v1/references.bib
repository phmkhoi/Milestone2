@article{pretschner_policy_2009,
	title = {Policy {Evolution} in {Distributed} {Usage} {Control}},
	volume = {244},
	doi = {10.1016/j.entcs.2009.07.042},
	abstract = {Usage control is a generalization of access control that also addresses how data is handled after it is released. Controlling the future usage of data includes controlling the future distribution of data. The evolution of policies upon re-distribution must hence be dened. Intuitively, clients should only strengthen policies associated with a data item when they re-distribute it. We provide a role-based re-distribution model for usage control that encompasses strengthening both rights and duties. By introducing orderings for events and parameter values we show how both rights and duties can be strengthened with the traditional abstraction of trace inclusion.},
	journal = {Electr. Notes Theor. Comput. Sci.},
	author = {Pretschner, Alexander and Schütz, Florian and Schaefer, Christian and Walter, Thomas},
	month = aug,
	year = {2009},
	pages = {109--123},
}

