@inproceedings{gomer_consenting_2014,
	title = {Consenting agents: semi-autonomous interactions for ubiquitous consent},
	isbn = {978-1-4503-3047-3},
	shorttitle = {Consenting agents},
	url = {https://eprints.soton.ac.uk/366977/},
	abstract = {Ubiquitous computing, given a regulatory environment that seems to favor consent as a way to empower citizens, introduces the possibility of users being asked to make consent decisions in numerous everyday scenarios such as entering a supermarket or walking down the street. In this note we outline a model of semi-autonomous consent (SAC), in which preference elicitation is decoupled from the act of consenting itself, and explain how this could protect desirable properties of informed consent without overwhelming users. We also suggest some challenges that must be overcome to make SAC a reality.},
	language = {en},
	urldate = {2018-05-31},
	author = {Gomer, Richard Charles and schraefel, m c and Gerding, Enrico},
	collaborator = {Gomer, Richard Charles and schraefel, m c and Gerding, Enrico},
