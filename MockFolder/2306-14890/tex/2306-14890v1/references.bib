	keywords = {Access Control Policies, Authorization, Collaboration, Measurement, Policy Analysis, Policy Quality, Process control, Provenance, Robot sensing systems, access control policy evolution, access control policy management systems, authorisation, collaborating entities, collaborations, groupware, information sharing, policy quality requirements, provenance techniques, provenance-based analytics services, resource allocation, resource sharing, 未讀, 相關2},
	pages = {94--101},
}

