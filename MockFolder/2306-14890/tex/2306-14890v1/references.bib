	author = {Kiss, Tamas and Kacsuk, Peter and Kovacs, Jozsef and Rakoczi, Botond and Hajnal, Akos and Farkas, Attila and Gesmier, Gregoire and Terstyanszky, Gabor},
	year = {2017},
	keywords = {Automated scalability, Cloud orchestration, Data Avenue, Policy model, Science gateway},
	pages = {937--946},
}

