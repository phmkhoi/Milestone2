@incollection{mika_querying_2014,
	address = {Cham},
	title = {Querying {Datasets} on the {Web} with {High} {Availability}},
	volume = {8796},
	isbn = {978-3-319-11963-2 978-3-319-11964-9},
	url = {http://link.springer.com/10.1007/978-3-319-11964-9_12},
	abstract = {As the Web of Data is growing at an ever increasing speed, the lack of reliable query solutions for live public data becomes apparent. sparql implementations have matured and deliver impressive performance for public sparql endpoints, yet poor availability—especially under high loads—prevents their use in real-world applications. We propose to tackle this availability problem by deﬁning triple pattern fragments, a speciﬁc kind of Linked Data Fragments that enable low-cost publication of queryable data by moving intelligence from the server to the client. This paper formalizes the Linked Data Fragments concept, introduces a client-side sparql query processing algorithm that uses a dynamic iterator pipeline, and veriﬁes servers’ availability under load. The results indicate that, at the cost of lower performance, query techniques with triple pattern fragments lead to high availability, thereby allowing for reliable applications on top of public, queryable Linked Data.},
	language = {en},
	urldate = {2022-02-07},
	booktitle = {The {Semantic} {Web} – {ISWC} 2014},
	publisher = {Springer International Publishing},
	author = {Verborgh, Ruben and Hartig, Olaf and De Meester, Ben and Haesendonck, Gerald and De Vocht, Laurens and Vander Sande, Miel and Cyganiak, Richard and Colpaert, Pieter and Mannens, Erik and Van de Walle, Rik},
	editor = {Mika, Peter and Tudorache, Tania and Bernstein, Abraham and Welty, Chris and Knoblock, Craig and Vrandečić, Denny and Groth, Paul and Noy, Natasha and Janowicz, Krzysztof and Goble, Carole},
	year = {2014},
