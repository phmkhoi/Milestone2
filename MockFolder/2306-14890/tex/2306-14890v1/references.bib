@inproceedings{schleicher_approach_2011,
	title = {An approach to combine data-related and control-flow-related compliance rules},
	doi = {10.1109/SOCA.2011.6166212},
	abstract = {Compliance of IT-enabled business processes is a research area gaining more and more attraction for enterprises today. Many enterprises are on the gap of installing workflow systems within their premises. During this process they need to make sure that several regulations, coming from governments or enterprise-internal institutions, are obeyed. We argue that the compliance regulations, enterprises are faced with today, can be built using a number of atomic compliance rules. Until now only control-flow-related atomic compliance rules have been identified in literature. In this paper we extend this list with several data-related atomic compliance rules. We further show how control-flow-related compliance rules and data-related compliance rules can be combined. A fundamental finding that we made in our work with industrial use case partners from EU projects, as well as projects with customers, is that for the specification of control-flow-related compliance rules data issues must also be considered. The main contribution of this paper is a collection of combined compliance rules implementing complex compliance requirements which consist of atomic control-flow related and data-related compliance rules.},
	booktitle = {2011 {IEEE} {International} {Conference} on {Service}-{Oriented} {Computing} and {Applications} ({SOCA})},
	author = {Schleicher, D. and Grohe, S. and Leymann, F. and Schneider, P. and Schumm, D. and Wolf, T.},
	month = dec,
	year = {2011},
	keywords = {Board of Directors, Companies, Compliance, EU projects, Humans, IT-enabled business process compliance, Process control, Process design, Writing, business data processing, business process, combined compliance rules, complex compliance requirements, compliance regulations, constraint, control-flow-related atomic compliance rules, data-related atomic compliance rules, enterprise-internal institutions, formal specification, formal verification, pattern, workflow systems installation},
	pages = {1--8},
}

@inproceedings{schleicher_compliance_2011,
	title = {Compliance {Domains}: {A} {Means} to {Model} {Data}-{Restrictions} in {Cloud} {Environments}},
	shorttitle = {Compliance {Domains}},
	doi = {10.1109/EDOC.2011.22},
	abstract = {It is crucial for enterprises to execute business operations in a compliant way. This is especially true for IT-driven business processes as enterprises may face considerable fines when violating laws and regulation in their business processes. Through the advent of cloud computing, a new dimension of compliance requirements within the research area of compliant business process design has emerged. Data-sovereignty is one of the major compliance concerns enterprises have to deal with when moving applications and data to the cloud. Enterprises are fully responsible for their data, also when the data is not present within their IT premises anymore. This lead to the policy that specific data must not leave the IT premises of the enterprise. In this paper we present an approach to support the human process designer in modelling compliant business processes. We are focusing on compliance requirements which have to be considered in the field of cloud computing. These requirements have been created to meet laws and regulations. These laws and regulations are considering data which is to other countries, for example. Looking at the characteristics of these requirements, we deal with data-centric compliance rules here.},
	booktitle = {2011 {IEEE} 15th {International} {Enterprise} {Distributed} {Object} {Computing} {Conference}},
	author = {Schleicher, D. and Fehling, C. and Grohe, S. and Leymann, F. and Nowak, A. and Schneider, P. and Schumm, D.},
