	pages = {1--17},
}

@article{sharma_tolla:_2018,
	title = {Tolla: {A} user-isolating data management system},
	abstract = {Privacy of our personal data stored in clouds is under constant threat. Data from our activities online and even offline are being stored, processed and mined to generate valuable information for commercial interests. While this is being done, the individuals have very little or no knowledge about the sub-processors accessing their data. The lack of strict regulations has allowed commercial interests to disregard the privacy of users. A growing distrust among users about storing their personal data in the cloud has created the need for privacy preserving systems. In this direction, we present Tolla, a data management system for personal data. Tolla gives user total control over their data along with granular privacy controls to enable legacy internet services.},
	language = {en},
	author = {Sharma, Aakash},
	year = {2018},
	keywords = {追蹤},
	pages = {4},
}

@article{boutilier_cp-nets:_2011,
	title = {{CP}-nets: {A} {Tool} for {Representing} and {Reasoning} with {Conditional} {Ceteris} {Paribus} {Preference} {Statements}},
	shorttitle = {{CP}-nets},
	url = {http://arxiv.org/abs/1107.0023},
	doi = {10.1613/jair.1234},
	abstract = {Information about user preferences plays a key role in automated decision making. In many domains it is desirable to assess such preferences in a qualitative rather than quantitative way. In this paper, we propose a qualitative graphical representation of preferences that reflects conditional dependence and independence of preference statements under a ceteris paribus (all else being equal) interpretation. Such a representation is often compact and arguably quite natural in many circumstances. We provide a formal semantics for this model, and describe how the structure of the network can be exploited in several inference tasks, such as determining whether one outcome dominates (is preferred to) another, ordering a set outcomes according to the preference relation, and constructing the best outcome subject to available evidence.},
	urldate = {2018-06-04},
	journal = {arXiv:1107.0023 [cs]},
	author = {Boutilier, C. and Brafman, R. I. and Domshlak, C. and Hoos, H. H. and Poole, D.},
	month = jun,
	year = {2011},
	note = {arXiv: 1107.0023},
	keywords = {Computer Science - Artificial Intelligence},
}

@article{hutton_toward_2018,
	title = {Toward {Reproducibility} in {Online} {Social} {Network} {Research}},
	volume = {6},
	doi = {10.1109/TETC.2015.2458574},
	abstract = {The challenge of conducting reproducible computational research is acknowledged across myriad disciplines from biology to computer science. In the latter, research leveraging online social networks (OSNs) must deal with a set of complex issues, such as ensuring data can be collected in an appropriate and reproducible manner. Making research reproducible is difficult, and researchers may need suitable incentives, and tools and systems, to do so. In this paper, we explore the state-of-the-art in OSN research reproducibility, and present an architecture to aid reproducibility. We characterize the reproducible OSN research using three main themes: 1) reporting of methods; 2) availability of code; and 3) sharing of research data. We survey 505 papers and assess the extent to which they achieve these reproducibility objectives. While systems-oriented papers are more likely to explain data-handling aspects of their methodology, social science papers are better at describing their participant-handling procedures. We then examine incentives to make research reproducible, by conducting a citation analysis of these papers. We find that sharing data are associated with increased citation count, while sharing method and code does not appear to be. Finally, we introduce our architecture which supports the conduct of reproducible OSN research, which we evaluate by replicating an existing research study.},
	number = {1},
	journal = {IEEE Transactions on Emerging Topics in Computing},
	author = {Hutton, L. and Henderson, T.},
	month = jan,
	year = {2018},
	keywords = {Data collection, Data sharing, Ethics, Facebook, Licenses, OSN research reproducibility, Sociology, Twitter, citation analysis, data handling, data-handling aspects, online social network research, online social networks, reproducibility, reproducibility objectives, reproducible OSN research, reproducible computational research, research data, social networking (online), survey, 追蹤},
	pages = {156--167},
}

@inproceedings{fiesler_exploring_2016,
	address = {New York, NY, USA},
	series = {{GROUP} '16},
	title = {Exploring {Ethics} and {Obligations} for {Studying} {Digital} {Communities}},
	isbn = {978-1-4503-4276-6},
	url = {http://doi.acm.org/10.1145/2957276.2996293},
	doi = {10.1145/2957276.2996293},
	abstract = {Many of the most prominent and unanswered ethical questions within HCI and social computing involve our ethical obligation to the communities that we study. Some of these questions fall under the purview of more traditional human subjects research ethics, but others hinge on when, for example, studies of public data trigger similar obligations. Basic rules to "do no harm" are complicated in digital communities by issues of consent and privacy, and ethics review boards are struggling to keep up even as research communities are similarly struggling to form appropriate norms. The goals of this workshop are to continue seeding conversations about research ethics within the SIGCHI community, to work towards norm setting, and in the meantime, to collectively help community members make good ethical decisions about research into sociotechnical systems and digital communities.},
	urldate = {2018-06-04},
	booktitle = {Proceedings of the 19th {International} {Conference} on {Supporting} {Group} {Work}},
	publisher = {ACM},
	author = {Fiesler, Casey and Wisniewski, Pamela and Pater, Jessica and Andalibi, Nazanin},
	year = {2016},
	keywords = {ethics, hci, human subjects, online communities, policy, privacy, social computing, sociotechnical systems},
	pages = {457--460},
}

@inproceedings{baarslag_automated_2017,
	address = {Richland, SC},
	series = {{AAMAS} '17},
	title = {An {Automated} {Negotiation} {Agent} for {Permission} {Management}},
	url = {http://dl.acm.org/citation.cfm?id=3091125.3091184},
	abstract = {The digital economy is based on data sharing yet citizens have little control about how their personal data is being used. While data management during web and app-based use is already a challenge, as the Internet of Things (IoT) scales up, the number of devices accessing and requiring personal data will go beyond what a person can manually assess in terms of data access requests. Therefore, new approaches are needed for managing privacy preferences at scale and providing active consent around data sharing that can improve fidelity of operation in alignment with user intent. To address this challenge, we introduce a novel agent-based approach to negotiate the permission to exchange private data between users and services. Our agent negotiates based on learned preferences from actual users. To evaluate our agent-based approach, we developed an experimental tool to run on people's own smartphones, where users were asked to share their private, real data (e.g. photos, contacts, etc) under various conditions. The agent autonomously negotiates potential agreements for the user, which they can refine by manually continuing the negotiation. The agent learns from these interactions and updates the user model in subsequent interactions. We find that the agent is able to effectively capture the preferences and negotiate on the user's behalf but, surprisingly, does not reduce user engagement with the system. Understanding how interaction interplays with agent-based automation is a key component to successful deployment of negotiating agents in real-life settings and within the IoT context in particular.},
	urldate = {2018-06-04},
	booktitle = {Proceedings of the 16th {Conference} on {Autonomous} {Agents} and {MultiAgent} {Systems}},
	publisher = {International Foundation for Autonomous Agents and Multiagent Systems},
	author = {Baarslag, Tim and Alan, Alper T. and Gomer, Richard and Alam, Muddasser and Perera, Charith and Gerding, Enrico H. and schraefel, m.c.},
	year = {2017},
	keywords = {automated negotiation, mobile apps, negotiation agent, negotiation cost, partial offers, permissions, preference learning, privacy},
	pages = {380--390},
}

