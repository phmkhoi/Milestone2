@article{mycroft_spanning_2019,
  series   = {The proceedings of {Lagos} 2019, the tenth {Latin} and {American} {Algorithms}, {Graphs} and {Optimization} {Symposium} ({LAGOS} 2019)},
  title    = {Spanning Trees of Dense  Directed Graphs},
  volume   = {346},
  issn     = {1571-0661},
  url      = {https://www.sciencedirect.com/science/article/pii/S1571066119301070},
  doi      = {10.1016/j.entcs.2019.08.056},
  abstract = {In the nineties, Komlós, Sárközy and Szemerédi confirmed a conjecture of Bollobás, showing that for every positive α, Δ and sufficiently large n, every graph with minimum degree (1/2 + α)n contains every tree of order n and maximum degree at most Δ. We obtain a directed graph analogue of their result, where the minimum degree is replaced by minimum semidegree (which is the minimum of all in- and out-degrees over all vertices) and the maximum degree is replaced by the maximum degree of the underlying graph (i.e., the maximum degree of the graph we obtain by ignoring the orientation of edges). In fact, we prove a stronger result, which states a sufficient condition for a tree of order n to be contained in every directed graph of order n and minimum semidegree (1/2 + α)n. This result implies that for all positive real α and sufficiently large n every directed graph of order n with minimum semidegree (1/2+α)n contains almost every spanning oriented tree T of order n.},
  language = {en},
  urldate  = {2023-02-27},
  journal  = {Electronic Notes in Theoretical Computer Science},
  author   = {Mycroft, Richard and Naia, Tássio},
  month    = aug,
  year     = {2019},
  keywords = {directed graphs, graph theory, spanning trees},
  pages    = {645--654},
  file     = {ScienceDirect Full Text PDF:/home/patryk/Zotero/storage/XH5HD5V2/Mycroft i Naia - 2019 - Spanning Trees of Dense Directed Graphs.pdf:application/pdf;ScienceDirect Snapshot:/home/patryk/Zotero/storage/RJYLGSWC/S1571066119301070.html:text/html}
}

@misc{kathapurkar_spanning_2022,
  title     = {Spanning trees in dense directed graphs},
  url       = {http://arxiv.org/abs/2102.03144},
  doi       = {10.48550/arXiv.2102.03144},
  abstract  = {In 2001, Koml{\textbackslash}'os, S{\textbackslash}'ark{\textbackslash}"ozy and Szemer{\textbackslash}'edi proved that, for each \${\textbackslash}alpha{\textgreater}0\$, there is some \$c{\textgreater}0\$ and \$n\_0\$ such that, if \$n{\textbackslash}geq n\_0\$, then every \$n\$-vertex graph with minimum degree at least \$(1/2+{\textbackslash}alpha)n\$ contains a copy of every \$n\$-vertex tree with maximum degree at most \$cn/{\textbackslash}log n\$. We prove the corresponding result for directed graphs. That is, for each \${\textbackslash}alpha{\textgreater}0\$, there is some \$c{\textgreater}0\$ and \$n\_0\$ such that, if \$n{\textbackslash}geq n\_0\$, then every \$n\$-vertex directed graph with minimum semi-degree at least \$(1/2+{\textbackslash}alpha)n\$ contains a copy of every \$n\$-vertex oriented tree whose underlying maximum degree is at most \$cn/{\textbackslash}log n\$. As with Koml{\textbackslash}'os, S{\textbackslash}'ark{\textbackslash}"ozy and Szemer{\textbackslash}'edi's theorem, this is tight up to the value of \$c\$. Our result improves a recent result of Mycroft and Naia, which requires the oriented trees to have underlying maximum degree at most \${\textbackslash}Delta\$, for any constant \${\textbackslash}Delta{\textbackslash}in {\textbackslash}mathbb\{N\}\$ and sufficiently large \$n\$. In contrast to these results, our methods do not use Szemer{\textbackslash}'edi's regularity lemma.},
  urldate   = {2023-02-27},
  publisher = {arXiv},
  author    = {Kathapurkar, Amarja and Montgomery, Richard},
  month     = feb,
  year      = {2022},
  note      = {arXiv:2102.03144 [math]},
  keywords  = {Mathematics - Combinatorics, 05C20, 05C05, 05C35},
  file      = {arXiv Fulltext PDF:/home/patryk/Zotero/storage/76SCBZAI/Kathapurkar i Montgomery - 2022 - Spanning trees in dense directed graphs.pdf:application/pdf;arXiv.org Snapshot:/home/patryk/Zotero/storage/ZM2V8HLH/2102.html:text/html}
}

