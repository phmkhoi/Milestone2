  title     = {The {Regularity} {Lemma} and {Its} {Applications} in {Graph} {Theory}},
  volume    = {2292},
  isbn      = {978-3-540-43328-6 978-3-540-45878-4},
  url       = {http://link.springer.com/10.1007/3-540-45878-6_3},
  abstract  = {Szemer´edi’s Regularity Lemma is an important tool in discrete mathematics. It says that, in some sense, all graphs can be approximated by random-looking graphs. Therefore the lemma helps in proving theorems for arbitrary graphs whenever the corresponding result is easy for random graphs. In the last few years more and more new results were obtained by using the Regularity Lemma, and also some new variants and generalizations appeared. Koml´os and Simonovits have written a survey on the topic [96]. The present survey is, in a sense, a continuation of the earlier survey. Here we describe some sample applications and generalizations. To keep the paper self-contained we decided to repeat (sometimes in a shortened form) parts of the ﬁrst survey, but the emphasis is on new results.},
  language  = {en},
  urldate   = {2023-02-27},
  booktitle = {Theoretical {Aspects} of {Computer} {Science}},
  publisher = {Springer Berlin Heidelberg},
  author    = {Komlós, János and Shokoufandeh, Ali and Simonovits, Miklós and Szemerédi, Endre},
  editor    = {Goos, Gerhard and Hartmanis, Juris and van Leeuwen, Jan and Khosrovshahi, Gholamreza B. and Shokoufandeh, Ali and Shokrollahi, Amin},
  year      = {2002},
  doi       = {10.1007/3-540-45878-6_3},
  note      = {Series Title: Lecture Notes in Computer Science},
  pages     = {84--112},
  file      = {Komlós et al. - 2002 - The Regularity Lemma and Its Applications in Graph.pdf:/home/patryk/Zotero/storage/SJ85JQ9G/Komlós et al. - 2002 - The Regularity Lemma and Its Applications in Graph.pdf:application/pdf}
}

