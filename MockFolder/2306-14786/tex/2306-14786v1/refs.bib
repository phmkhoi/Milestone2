@inproceedings{sharmaCERTIFAICommonFramework2020,
  title = {{{CERTIFAI}}: {{A Common Framework}} to {{Provide Explanations}} and {{Analyse}} the {{Fairness}} and {{Robustness}} of {{Black-box Models}}},
  shorttitle = {{{CERTIFAI}}},
