@article{12643998,
	Abstract = {To date, coalescent analysis of the Plasmodium falciparum genome sequence has failed to provide a unifying theory regarding the parasite's evolution. While a better understanding of the evolution of the malaria genome will undoubtedly clarify the current controversy, the importance of the parasite's interplay with both the human host and mosquito vector cannot be underestimated. Changes in the population biology or ecology of either one of these species have consequences for malaria transmission and this was never more apparent than in the environmental changes brought about by the advent of agriculture.},
