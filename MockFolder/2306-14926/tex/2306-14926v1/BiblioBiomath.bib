@article{1015.92042,
	Abstract = {{Summary: Experimental studies have shown that parasites can reduce
    host density and even drive host populations to extinction. Conventional
    mathematical models for parasite-host interactions, while can
    address the host density reduction scenario, fail to explain
    such deterministic extinction phenomena. In order to understand
    the parasite induced host extinction, {\it D. Ebert} et al. [Am.
    Natur. 156, 459-477 (2000)] formulated a plausible but ad hoc
    epidemiological microparasite model and its stochastic variation.
    The deterministic model, resembling a simple SI type model, predicts
    the existence of a globally attractive positive steady state.
    The simulation of the stochastic model indicates that extinction
    of the host is a likely outcome in some parameter regions. A
    careful examination of the ad hoc model suggests an alternative
    and plausible model assumption. \par
With this modification,
    we show that the revised parasite-host model can exhibit the
    observed parasite induced host extinction. This finding strengthens
    and complements those of Ebert et al., since all continuous models
    are likely to break down when all population densities are small.
    This extinction dynamics resembles that of ratio-dependent predator-prey
    models. We report here a complete global study of the revised
    parasite-host model. Biological implications and limitations
    of our findings are also presented.}},
	Author = {Hwang, Tzy-Wei and Kuang, Yang},
	Classmath = {{*92D40 Ecology 34C60 Applications of qualitative theory of ODE 92D30 Epidemiology}},
	Date-Modified = {2008-05-25 23:15:51 +0200},
