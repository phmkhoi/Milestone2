@article{0729.34032,
	Abstract = {{The hypercycle system is described by the system of differential
    equations $\dot x\sb i=x\sb i[F\sb i(x\sb i,x\sb{i-1})-\sum x\sb
    jF\sb j(x\sb j,x\sb{j-1})],$ where $1\le i\le n$, $F\sb i$ are
    continuously differentiable functions. This system is a simple
    model of the time evolution of the concentrations of a set of
    polynucleotides, $M\sb 1,M\sb 2,...,M\sb n$, in a flow reactor
    in which $M\sb 1$ catalyzes the replication of $M\sb 2$, $M\sb
    2$ that of $M\sb 3$, and so on, finally, $M\sb n$ catalyzes the
    replication of $M\sb 1$. The hypercycle was proposed by {\it
    Eigen} [Naturwissenschaften 58, 465-523 (1971)]. In this paper
    the hypercycle system is investigated. Under general conditions
    the authors prove that the omega limit set of any orbit is either
    an equilibrium or a periodic orbit. The existence of an orbitally
    asymptotically stable periodic orbit is shown for a broad class
    of such systems.}},
	Author = {Hofbauer, J. and Mallet-Paret, J. and Smith, H.L.},
	Classmath = {{*34D20 Lyapunov stability of ODE 34D35 Stability of manifolds of solutions of ODE 92D20 Protein sequences, DNA sequences 34C25 Periodic solutions of ODE}},
	Journal = {J. Dyn. Differ. Equations},
	Keywords = {{hypercycle system; concentrations of a set of polynucleotides; omega limit set; orbitally asymptotically stable periodic orbit}},
	Language = {English},
	Number = {3},
	Pages = {423-436},
	Reviewer = {{Chen Lan Sun (Beijing)}},
	Title = {{Stable periodic solutions for the hypercycle system.}},
	Volume = {3},
	Year = {1991}}

