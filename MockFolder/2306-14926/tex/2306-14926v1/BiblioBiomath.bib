@article{0893.34047,
	Abstract = {The author discusses general reduction theorems which, to study
    the stability problem for a nonlinear system on a metric space
    $X$ endowed with an invariant subspace $Y$, use the stability
    of the subsystems itself without insisting on its being reflected
    in the spectrum of the linear part. This general reduction problem
    was essentially solved for the case of dynamical systems in a
    locally compact metric space by the author. Further these results
    were extended to semidynamical systems in arbitrary metric spaces
    (not assuming local compactness).\par
The author proves new
    reduction theorems dropping the assumption of compactness of
    the invariant subset $M$ of $Y$. He introduces a concept of attraction
    of a family of sets $U$ to another family of sets $V$, a standard
    case being the one where $U$ and $V$ are the collections of all
    bounded subsets of $X$ and $Y$, respectively.\par
The principal
    result states that if a collection $U$ is attracted to a collection
    $V$ of subsets of $Y,V$ is attracted to $M$, and $Y$ is (in a
    certain sense) locally stable at $M$, then $M$ is asymptotically
    stable with respect to the collection $U$.\par
Some applications
    of this theorem are discusse.},
	Author = {Seibert, P.},
	Journal = {Nonlinear Anal. , Theory Methods Appl.},
	Keywords = {Lyapunov stability; reduction of stability of closed invariant sets; dynamical systems; semidynamical systems},
	Number = {7},
	Pages = {4675-4681},
	Title = {Reduction theorems for stability of systems in general spaces.},
	Volume = {30},
