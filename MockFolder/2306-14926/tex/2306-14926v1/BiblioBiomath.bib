	Keywords = {Agriculture; Animals; *Anthropology, Physical; Cholera/transmission; *Disease Transmission; Dracunculiasis/transmission; Ecology; Evolution; Filariasis/transmission; Humans; Insect Vectors; *Tropical Climate; Zoonoses},
