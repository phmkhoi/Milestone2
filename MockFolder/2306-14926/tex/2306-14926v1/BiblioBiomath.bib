@article{0853.54038,
	Abstract = {{The authors deal with dynamical and semi-dynamical systems on
    metric spaces. Assume that two invariant subsets $M$, $Y$ are
    given, with $M$ compact and $M\subset Y$. The reduction problem
    consists in the following. If $M$ is stable (or asymptotically
    stable) for the restriction of the dynamical system to $Y$, under
    what additional assumptions is it possible to deduce that $M$
    is stable (or asymptotically stable) for the whole system? \par
The
    authors prove several theorems about this problem, and compare
    their results to early achievements in the existing literature.
    In particular, the role of uniformity in the behaviour of the
    dynamical system is emphasized. As examples, systems in triangular
    form and systems with delays are discussed.}},
	Author = {Seibert, P. and Florio, J.S.},
