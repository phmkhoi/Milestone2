	Language = {English},
	Local-Url = {file://localhost/articles/EpidemioMath/Modeles/HwaKua03.pdf},
	Number = {1},
	Pages = {17-30},
	Title = {{Deterministic extinction effect of parasites on host populations.}},
	Volume = {46},
	Year = {2003},
	Bdsk-File-1 = {}}

