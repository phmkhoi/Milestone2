@article{1035.34045,
	Abstract = {{Summary: Exploiting the fact that standard models of within-host
    viral infections of target cell populations by HIV, developed
    by {\it A. S. Perelson} and {\it P. W. Nelson} [SIAM Rev. 41,
    3-44 (1999; Zbl pre01308680)] and {\it M. A. Nowak} and {\it
    R. M. May} [Virus dynamics. Mathematical principles of immunology
    and virology. Oxford: Oxford University Press (2000; Zbl pre02038872)],
    give rise to competitive three-dimensional dynamical systems,
    we provide a global analysis of their dynamics. If the basic
    reproduction number $R_{0}<1$, the virus is cleared and the
    disease dies out; if $R_{0}>1$, then the virus persists in
    the host, solutions approaching either a chronic disease steady
    state or a periodic orbit. The latter can be ruled out in some
    cases but not in general.}},
