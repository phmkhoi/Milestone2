@article{1017.92032,
	Abstract = {{Summary: This paper describes a method for estimating the seasonal variation of infection rate (or contact rate) and the trajectories of the number of susceptible, infectious and removed individuals in a deterministic SIRS model. The key idea of the proposed method is that the number of periodically varying infectives at time $t$ can be represented as a sum of functions of the form $b_1/(1+b_2 (t-kT-b_3)^2)$, $k=\cdots, -1,0,1,\dots$, where $b_1$, $b_2$ and $b_3$ are parameters to be estimated from the incidence data, and $T$ is the period. Given the infective trajectory, the other trajectories and the contact rate can be estimated via the model definition.\par The method is illustrated using cholera incidence data from three developing countries. Finally, an analysis of the sensitivity of parameter estimation for validating the obtained results using numerical analysis techniques is made.}},
	Author = {Pourabbas, E. and d'Onofrio, A. and Rafanelli, M.},
	Classmath = {{*92D30 Epidemiology}},
	Date-Added = {2007-05-30 16:43:19 +0200},
	Date-Modified = {2007-05-30 16:50:12 +0200},
	Journal = {Appl. Math. Comput.},
	Keywords = {{SIRS model; seasonal variation of contact rate; witch of Agnesi; cholera incidence; numerical computation; ordinary differential equations}},
	Language = {English},
	Local-Url = {file://localhost/articles/EpidemioMath/Cholera/PouDono01.pdf},
	Number = {2-3},
	Pages = {161-174},
	Title = {{A method to estimate the incidence of communicable diseases under seasonal fluctuations with application to cholera.}},
	Volume = {118},
	Year = {2001},
	Bdsk-File-1 = {}}

@inproceedings{0533.92023,
	Abstract = {{[For the entire collection see Zbl 0511.00014.] \par In Anlehnung an den {\"U}bertragungsmechanismus der Gonnorrh{\"o}e wird ein kontinuierliches mathematisches Modell einer Epidemie untersucht, bei dem die betrachtete Population in bez{\"u}glich der Epidemieausbreitung verschieden reagierende Subpopulationen zerf{\"a}llt (wobei auch sich die Waage haltende Immigration und Emigration zugelassen sind) und wobei in jeder Subpopulation zu den Klassen der empf{\"a}nglichen, infizierten und immunen noch eine Klasse der inkubierten Individuen hinzugenommen wird. Es wird sowohl wechselseitige Infektion zwischen den Subpopulationen als auch Infektion innerhalb der Subpopulation zugelassen. \par Das System der Modellgleichungen wird auf elegante Weise in ein Integralgleichungssystem transformiert, dessen n{\"a}here Untersuchung zeigt, da{\ss} mit $t\to \infty$ in allen Subpopulationen die Epidemie entweder erlischt oder - bei Erf{\"u}llung einer gewissen Schwellenbedingung - gegen einen station{\"a}ren Zustand konvergiert.}},
	Author = {Thieme, Horst R.},
	Booktitle = {Equadiff 82, Proc. int. Conf., W{\"u}rzburg 1982,},
	Classmath = {{*92D25 Population dynamics}},
	Date-Added = {2007-05-30 16:40:51 +0200},
	Date-Modified = {2008-05-06 20:28:20 +0200},
	Keywords = {{global asymptotic stability; epidemic models; gonorrhea; short periods of incubation and immunity; immigration; emigration; system of integral equations; renewal theorems; seasonal variations; spatial spread; travelling wave solutions}},
	Language = {English},
	Local-Url = {/articles/EpidemioMath/Modeles/Thi83.pdf},
	Number = {1017},
	Pages = {608-615},
	Publisher = {Springer-Verlag},
	Reviewer = {{W.N{\"o}bauer}},
