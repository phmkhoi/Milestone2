@article{1056.92052,
	Abstract = {{Summary: Two models for tuberculosis (TB) that include treatment
    of latent and infective individuals are considered. The first
    model assumes constant recruitment with a fixed fraction entering
    each class, having the consequences that TB never dies out and
    that the usual threshold condition does not apply. The unique
    endemic equilibrium is locally asymptotically stable for all
    parameter values and is shown to be globally asymptotically stable
    under certain parameter restrictions. The second model has a
    general recruitment function, but all recruitment is into the
    susceptible class.\par
Three threshold parameters determine
    the existence and local stability of equilibria. The disease-free
    equilibrium is globally asymptotically stable when the basic
    reproduction number is less than or equal to one. The endemic
    equilibrium, when it exists, is shown to be globally asymptotically
    stable under certain parameter restrictions. Global stability
    results for the endemic equilibria are proved using the geometric
    approach of {\it M. Y. Li} and {\it J. S. Muldowney} [J. Differ.
    Equations 124, 425-448 (1996; Zbl 0847.34059)].}},
	Author = {McCluskey, C.C. and van den Driessche, P.},
	Classmath = {{*92D30 Epidemiology 34D23 Global stability 34C60 Applications of qualitative theory of ODE}},
	Date-Modified = {2013-01-01 12:35:33 +0100},
	Journal = {J. Dyn. Differ. Equations},
	Keywords = {{Epidemic model; tuberculosis; global stability; compound matrices}},
	Language = {English},
	Local-Url = {file://localhost/articles/EpidemioMath/Tuberculose/clusVdd04.pdf},
	Number = {1},
	Pages = {139-166},
	Title = {{Global analysis of two tuberculosis models.}},
	Volume = {16},
	Year = {2004},
