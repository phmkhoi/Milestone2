@article {Puebla2021.04.06.438551,
	author = {Puebla, Guillermo and Bowers, Jeffrey S.},
	title = {Can Deep Convolutional Neural Networks Learn Same-Different Relations?},
	elocation-id = {2021.04.06.438551},
	year = {2021},
	doi = {10.1101/2021.04.06.438551},
	publisher = {Cold Spring Harbor Laboratory},
	abstract = {Same-different visual reasoning is a basic skill central to abstract combinatorial thought. This fact has lead neural networks researchers to test same-different classification on deep convolutional neural networks (DCNNs), which has resulted in a controversy regarding whether this skill is within the capacity of these models. However, most tests of same-different classification rely on testing on images that come from the same pixel-level distribution as the testing images, yielding the results inconclusive. In this study we tested relational same-different reasoning DCNNs. In a series of simulations we show that DCNNs are capable of visual same-different classification, but only when the test images are similar to the training images at the pixel-level. In contrast, even when there are only subtle differences between the testing and training images, the performance of DCNNs could drop to chance levels. This is true even when DCNNs{\textquoteright} training regime included a wide distribution of images or when they were trained in a multi-task setup in which training included an additional relational task with test images from the same pixel-level distribution.Competing Interest StatementThe authors have declared no competing interest.},
	URL = {https://www.biorxiv.org/content/early/2021/05/12/2021.04.06.438551},
	eprint = {https://www.biorxiv.org/content/early/2021/05/12/2021.04.06.438551.full.pdf},
	journal = {bioRxiv}
}

