	isbn = {0921-4526},
	journal = {Phys. B: Condens. Matter},
	keywords = {Magnetic order; Monte carlo; Computer modeling},
	pages = {680--681},
	title = {{A new protocol for the determination of magnetic structures using simulated annealing and representational analysis (SARAh)}},
	url = {https://www.sciencedirect.com/science/article/pii/S0921452699017226},
	volume = {276-278},
	year = {2000},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0921452699017226},
	bdsk-url-2 = {https://doi.org/10.1016/S0921-4526(99)01722-6}}

