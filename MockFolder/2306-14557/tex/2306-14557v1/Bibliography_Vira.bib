@article{jain1976,
	title = {Stability of stagnant viscous films on a solid surface},
	journal = {Journal of Colloid and Interface Science},
	volume = {54},
	number = {1},
	pages = {108-116},
	year = {1976},
	issn = {0021-9797},
	doi = {https://doi.org/10.1016/0021-9797(76)90290-3},
	url = {https://www.sciencedirect.com/science/article/pii/0021979776902903},
	author = {Rakesh K Jain and Eli Ruckenstein},
	abstract = {A unified theoretical framework is developed to study the stability of stagnant films having a wide range of thicknesses and located on a solid surface immersed in a viscous fluid. The stability of films having thicknesses smaller than the distance over which the London dispersion forces are effective is determined by an “effective” surface tension σeff (the sum of the surface tension and a term due to the difference between the forces acting upon an element of volume at the liquid-fluid interface of the thin film and of the corresponding bulk liquid). The films are unstable and will rupture when σeff < 0. The time for rupture is evaluated as a function of the surface viscosity, the surface elasticity, and the viscosity ratio. The derived equations are also valid for large film thicknesses. In the latter cases, the effective surface tension is equal to the surface tension and the films are always stable.}
}

