@Article{Haegeman2014,
  author   = {Haegeman, Jutho and Mariën, Michaël and Osborne, Tobias J. and Verstraete, Frank},
  journal  = {Journal of Mathematical Physics},
  title    = {{Geometry of matrix product states: Metric, parallel transport, and curvature}},
  year     = {2014},
  issn     = {0022-2488},
  month    = {02},
  note     = {021902},
  number   = {2},
  volume   = {55},
  abstract = {{We study the geometric properties of the manifold of states described as (uniform) matrix product states. Due to the parameter redundancy in the matrix product state representation, matrix product states have the mathematical structure of a (principal) fiber bundle. The total space or bundle space corresponds to the parameter space, i.e., the space of tensors associated to every physical site. The base manifold is embedded in Hilbert space and can be given the structure of a Kähler manifold by inducing the Hilbert space metric. Our main interest is in the states living in the tangent space to the base manifold, which have recently been shown to be interesting in relation to time dependence and elementary excitations. By lifting these tangent vectors to the (tangent space) of the bundle space using a well-chosen prescription (a principal bundle connection), we can define and efficiently compute an inverse metric, and introduce differential geometric concepts such as parallel transport (related to the Levi-Civita connection) and the Riemann curvature tensor.}},
  doi      = {10.1063/1.4862851},
  eprint   = {https://pubs.aip.org/aip/jmp/article-pdf/doi/10.1063/1.4862851/15641654/021902\_1\_online.pdf},
  groups   = {MPS tangent space},
  url      = {https://doi.org/10.1063/1.4862851},
}

@Article{Hubig2018,
  author    = {Hubig, C. and Haegeman, J. and Schollwöck, U.},
  journal   = {Physical Review B},
  title     = {Error estimates for extrapolations with matrix-product states},
  year      = {2018},
  month     = jan,
  number    = {4},
  pages     = {045125},
  volume    = {97},
  abstract  = {We introduce an error measure for matrix-product states without requiring the relatively costly two-site density-matrix renormalization group (2DMRG). This error measure is based on an approximation of the full variance ⟨ψ∣∣∣(ˆH−E)2∣∣∣ψ⟩. When applied to a series of matrix-product states at different bond dimensions obtained from a single-site density-matrix renormalization group (1DMRG) calculation, it allows for the extrapolation of observables towards the zero-error case representing the exact ground state of the system. The calculation of the error measure is split into a sequential part of cost equivalent to two calculations of ⟨ψ∣∣ˆH∣∣ψ⟩ and a trivially parallelized part scaling like a single operator application in 2DMRG. The reliability of this error measure is demonstrated by four examples: the L=30,S=1/2 Heisenberg chain, the L=50 Hubbard chain, an electronic model with long-range Coulomb-like interactions, and the Hubbard model on a cylinder with a size of 10×4. Extrapolation in this error measure is shown to be on par with extrapolation in the 2DMRG truncation error or the full variance ⟨ψ∣∣∣(ˆH−E)2∣∣∣ψ⟩ at a fraction of the computational effort.},
  doi       = {10.1103/PhysRevB.97.045125},
  file      = {Full Text PDF:https\://journals.aps.org/prb/pdf/10.1103/PhysRevB.97.045125:application/pdf},
  groups    = {Energy variance, MPS tangent space},
  publisher = {American Physical Society},
  url       = {https://link.aps.org/doi/10.1103/PhysRevB.97.045125},
  urldate   = {2023-04-23},
}

@Article{Gleis2022,
  author    = {Gleis, Andreas and Li, Jheng-Wei and von Delft, Jan},
  journal   = {Physical Review B},
  title     = {Projector formalism for kept and discarded spaces of matrix product states},
  year      = {2022},
  month     = nov,
  number    = {19},
  pages     = {195138},
  volume    = {106},
  abstract  = {Any matrix product state {\textbar}Ψ⟩ has a set of associated kept and discarded spaces, needed for the description of {\textbar}Ψ⟩, and changes thereof, respectively. These induce a partition of the full Hilbert space of the system into mutually orthogonal spaces of irreducible n-site variations of {\textbar}Ψ⟩. Here, we introduce a convenient projector formalism and diagrammatic notation to characterize these n-site spaces explicitly. This greatly facilitates the formulation of MPS algorithms that explicitly or implicitly employ discarded spaces. As an illustration, we derive an explicit expression for the n-site energy variance and evaluate it numerically for a model with long-range hopping. We also describe an efficient algorithm for computing low-lying n-site excitations above a finite MPS ground state.},
  doi       = {10.1103/PhysRevB.106.195138},
  file      = {Full Text PDF:https\://journals.aps.org/prb/pdf/10.1103/PhysRevB.106.195138:application/pdf},
  groups    = {Energy variance, MPS tangent space},
  publisher = {American Physical Society},
  url       = {https://link.aps.org/doi/10.1103/PhysRevB.106.195138},
  urldate   = {2023-04-23},
}

@Article{Shi2006,
