@article{MKIDSPT,
	title        = {The 10 Meter South Pole Telescope},
	author       = {J. E. Carlstrom and P. A. R. Ade and K. A. Aird and B. A. Benson and L. E. Bleem and S. Busetti and C. L. Chang and E. Chauvin and H.-M. Cho and T. M. Crawford and A. T. Crites and M. A. Dobbs and N. W. Halverson and S. Heimsath and W. L. Holzapfel and J. D. Hrubes and M. Joy and R. Keisler and T. M. Lanting and A. T. Lee and E. M. Leitch and J. Leong and W. Lu and M. Lueker and D. Luong-Van and J. J. McMahon and J. Mehl and S. S. Meyer and J. J. Mohr and T. E. Montroy and S. Padin and T. Plagge and C. Pryke and J. E. Ruhl and K. K. Schaffer and D. Schwan and E. Shirokoff and H. G. Spieler and Z. Staniszewski and A. A. Stark and C. Tucker and K. Vanderlinde and J. D. Vieira and R. Williamson},
	year         = 2011,
	journal      = {Publications of the Astronomical Society of the Pacific},
	publisher    = {[University of Chicago Press, Astronomical Society of the Pacific]},
	volume       = 123,
	number       = 903,
	pages        = {568--581},
	issn         = {00046280, 15383873},
	url          = {http://www.jstor.org/stable/10.1086/659879},
	abstract     = {ABSTRACT.The South Pole Telescope (SPT) is a 10Â m diameter, wide-field, offset Gregorian telescope with a 966Â pixel, multicolor, millimeter-wave, bolometer camera. It is located at the Amundsen-Scott South Pole station in Antarctica. The design of the SPT emphasizes careful control of spillover and scattering, to minimize noise and false signals due to ground pickup. The key initial project is a large-area survey at wavelengths of 3, 2, and 1.3Â mm, to detect clusters of galaxies via the Sunyaev-Zelâdovich effect and to measure the small-scale angular power spectrum of the cosmic microwave background (CMB). The data will be used to characterize the primordial matter power spectrum and to place constraints on the equation of state of dark energy. A second-generation camera will measure the polarization of the CMB, potentially leading to constraints on the neutrino mass and the energy scale of inflation.}
}
