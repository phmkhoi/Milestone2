@article{GARCIA201769,
	title        = {High-resolution three-dimensional imaging of a depleted CMOS sensor using an edge Transient Current Technique based on the Two Photon Absorption process (TPA-eTCT)},
	author       = {Marcos Fern{\'a}ndez Garc{\'\i}a and Javier Gonz{\'a}lez S{\'a}nchez and Richard Jaramillo Echeverr{\'\i}a and Michael Moll and Ra{\'u}l Montero Santos and David Moya and Rogelio Palomo Pinto and Iv{\'a}n Vila},
	year         = 2017,
	journal      = {Nuclear Instruments and Methods in Physics Research Section A: Accelerators, Spectrometers, Detectors and Associated Equipment},
	volume       = 845,
	pages        = {69--71},
	doi          = {https://doi.org/10.1016/j.nima.2016.05.070},
	issn         = {0168-9002},
	url          = {http://www.sciencedirect.com/science/article/pii/S0168900216304569},
	note         = {Proceedings of the Vienna Conference on Instrumentation 2016},
	abstract     = {For the first time, the deep n-well (DNW) depletion space of a High Voltage CMOS sensor has been characterized using a Transient Current Technique based on the simultaneous absorption of two photons. This novel approach has allowed to resolve the DNW implant boundaries and therefore to accurately determine the real depleted volume and the effective doping concentration of the substrate. The unprecedented spatial resolution of this new method comes from the fact that measurable free carrier generation in two photon mode only occurs in a micrometric scale voxel around the focus of the beam. Real three-dimensional spatial resolution is achieved by scanning the beam focus within the sample.},
	keywords     = {Particle tracking pixel detectors, Two Photon Absorption, Transient Current Technique, High-voltage CMOS technology},
	bdsk-url-1   = {http://www.sciencedirect.com/science/article/pii/S0168900216304569},
	bdsk-url-2   = {https://doi.org/10.1016/j.nima.2016.05.070}
}
