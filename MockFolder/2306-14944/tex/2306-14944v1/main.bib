@article{CHEREPY2015126,
	title        = {Bismuth- and lithium-loaded plastic scintillators for gamma and neutron detection},
	author       = {Nerine J. Cherepy and Robert D. Sanner and Patrick R. Beck and Erik L. Swanberg and Thomas M. Tillotson and Stephen A. Payne and Charles R. Hurlbut},
	year         = 2015,
	journal      = {Nuclear Instruments and Methods in Physics Research Section A: Accelerators, Spectrometers, Detectors and Associated Equipment},
	volume       = 778,
	pages        = {126--132},
	doi          = {10.1016/j.nima.2015.01.008},
	issn         = {0168-9002},
	url          = {http://www.sciencedirect.com/science/article/pii/S0168900215000261},
	keywords     = {Plastic scintillator, Gamma plastic, Neutron plastic, Neutron capture scintillator, Phoswich, Pulse-shape discrimination},
	abstract     = {Transparent plastic scintillators based on polyvinyltoluene (PVT) have been fabricated with high loading of bismuth carboxylates for gamma spectroscopy, and with lithium carboxylates for neutron detection. When activated with a combination of standard fluors, 2,5-diphenyloxazole (PPO) and tetraphenylbutadiene (TPB), gamma light yields with 15wt% bismuth tripivalate of 5000Ph/MeV are measured. A PVT plastic formulation including 30wt% lithium pivalate and 30wt% PPO offers both pulse shape discrimination, and a neutron capture peak at ~400keVee. In another configuration, a bismuth-loaded PVT plastic is coated with ZnS(6Li) paint, permitting simultaneous gamma and neutron detection via pulse shape discrimination with a figure-of-merit of 3.8, while offering gamma spectroscopy with energy resolution of R(662keV)=15%.}
}
