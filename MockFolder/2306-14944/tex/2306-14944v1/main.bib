@article{Ramanathan2020,
	title        = {{Ionization yield in silicon for eV-scale electron-recoil processes}},
	author       = {Ramanathan, Karthik and Kurinsky, Noah},
	year         = 2020,
	month        = {sep},
	journal      = {Physical Review D},
	volume       = 102,
	number       = 6,
	pages        = {063026},
	doi          = {10.1103/PhysRevD.102.063026},
	issn         = {2470-0010},
	url          = {http://arxiv.org/abs/2004.10709 http://dx.doi.org/10.1103/PhysRevD.102.063026 https://link.aps.org/doi/10.1103/PhysRevD.102.063026},
	abstract     = {The development of single charge resolving, macroscopic silicon detectors has opened a window into rare processes at the O(eV) scale. In order to reconstruct the energy of a given event, or model the charge signal obtained for a given amount of energy absorbed by the electrons in a detector, an accurate charge yield model is needed. In this paper we review existing measurements of charge yield in Silicon, focusing in particular on the region below 1 keV. We highlight a calibration gap between 12-50 eV (referred to as the "UV-gap") and employ a phenomenological model of impact ionization to explore the likely charge yield in this energy regime. Finally, we explore the impact of variations in this model on a test case, that of dark matter scattering off electrons, to illustrate the scientific impact of uncertainties in charge yield.},
	archiveprefix = {arXiv},
	arxivid      = {2004.10709},
	eprint       = {2004.10709},
	file         = {:Users/cdreyer/Library/Application Support/Mendeley Desktop/Downloaded/Ramanathan, Kurinsky - Unknown - Ionization Yield in Silicon for eV-Scale Electron-Recoil Processes.pdf:pdf},
	mendeley-groups = {DarkMatter}
}
