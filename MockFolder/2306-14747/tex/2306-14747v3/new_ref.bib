@Article{28sym11020249,
AUTHOR = {Mata-Pacheco, Daniel and Ares de Parga, Gonzalo and Angulo-Brown, Fernando},
TITLE = {Ultrarelativistic Gas with Zero Chemical Potential},
JOURNAL = {Symmetry},
VOLUME = {11},
YEAR = {2019},
NUMBER = {2},
ARTICLE-NUMBER = {249},
URL = {https://www.mdpi.com/2073-8994/11/2/249},
ISSN = {2073-8994},
ABSTRACT = {In this work, we propose a set of conditions such that an ultrarelativistic classical gas can present a photon-like behavior. This is achieved by assigning a zero chemical potential to the ultrarelativistic ideal gas. The resulting behavior is similar to that of a Wien photon gas. It is found to be possible only for gases made of very lightweight particles such as neutrinos, as long as we treat them as classical particles, and it depends on the spin degeneracy factor. This procedure allows establishing an analogy between an evaporating gas and the cavity radiation.},
DOI = {10.3390/sym11020249}
}

