@article{Halverson1962,
   abstract = {A model for potassium superoxide in which the oxygen atoms execute circular motions about the c-axis in a tetragonal lattice. provides a satisfactory basis for interpretation of the available X-ray data. This phenomenon is a close analog of the Renner effect in molecules. The large thermal parameters for other atomic positions also attest to appreciable coupling between electronic and nuclear motions. While the X-ray data are not sufficient to determine the 0; internuclear distance unambiguously, they are compatible with a value in the range 1.32-1.35 A.},
   author = {F Halverson},
   journal = {J. Phys. Chem. Solids},
   pages = {207-214},
   title = {{COMMENTS ON POTASSIUM SUPEROXIDE STRUCTURE}},
   volume = {23},
   year = {1962},
}

