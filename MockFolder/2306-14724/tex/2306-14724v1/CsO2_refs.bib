@article{Zumsteg1974,
   abstract = {The phase transitions of Alkali-Hyperoxide crystals (NaO2, K02, Rb02, and Cs02) grown in liquid ammonia have been investigated by means of the following measurements: a) magnetic susceptibility, b) differential magnetic susceptibility as magnetic field, e) magnetization curve in static and pulsed fields, d) specific heat. The anomalies of the specific heat could be correlated with the magnetic properties and structural changes. Several new phase transitions were found. The magnetic behaviour of NaO~ indicates magnetic order (of as yet unknown nature) at low temperatures. The magnetic and calorie behaviour of K02 at low temperatures is compatible with a N6el point at 7 K. A metamagnetic transition can be induced at temperatures below 12 K with fields of about 70 kOe. This transition is connected with structural changes. Rbs02 and C02 are probably antiferromagnetie with N~el temperatures of 15 K and 9.6 K, respectively. Die Phasenumwandlungen yon im flfissigen Ammoniak gezfiehteten Alkali-ttyperoxid-Kristallen (Na02, K02, Rb02 und Cs02) wurden mit Hilfe der folgenden Messungen unter-sueht: a) magnetische Suszeptibilit~t, b) differentielle magnetische Suszeptibilit~t als Funktion des Magnetfeldes, e) Magnetisierung in statischen und gepulsten Feldern, d) spezifische W~rme. Die Anomalien der spezifischen W/s kormten mit den magnetischen Eigensehaften und strukturellen ~_nderungen korreliert werdcn. Mein'ere neue Phasenumwandlungen wurden gefunden. Das magnetische Verhalten yon NaO2 weist auf einen geordneten Zustand bei tiefen Temperaturen hin; doch ist dessen Natur noeh nicht abgekl/~rt. Das kalorische und magne-tische Verhalten yon K02 bei tiefen Temperaturen ist kompatibel mit antiferromagnetischer Ordnung unterhalb 7 K. Eine metamagnetisehe Umwandlung kann induziert werden unter-halb 12 K mit Feldst~rken yon ca. 70 kOe. Sie ist mit einer Struktnr~inderung verknfipft. RbOu und CsO2 sind sehr wahrscheinlich antiferromagnetisch mit Ndel-Temperaturen yon 15 K bzw. 9,6 K.},
   author = {A Zumsteg and M Ziegler and M B\"{o}sch},
   journal = {Phys. Cond. Matter},
   pages = {267-291},
   publisher = {Springer-Verlag},
   title = {{Magnetische und kalorisehe Eigenschaften yon Alkali-Hyperoxid-Kristallen Magnetic and Caloric Properties o/ Alkali-Hyperoxide Crystals}},
   volume = {17},
   year = {1974},
}

