	volume = {4},
	issn = {1083-6489, 1083-6489},
	url = {https://projecteuclid.org/journals/electronic-journal-of-probability/volume-4/issue-none/Improved-Inclusion-Exclusion-Identities-and-Inequalities-Based-on-a-Particular/10.1214/EJP.v4-42.full},
