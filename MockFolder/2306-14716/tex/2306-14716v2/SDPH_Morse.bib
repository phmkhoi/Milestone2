@article{blaszczyszyn_limit_2019,
	title = {Limit theory for geometric statistics of point processes having fast decay of correlations},
	volume = {47},
	issn = {0091-1798, 2168-894X},
	url = {https://projecteuclid.org/journals/annals-of-probability/volume-47/issue-2/Limit-theory-for-geometric-statistics-of-point-processes-having-fast/10.1214/18-AOP1273.full},
	doi = {10.1214/18-AOP1273},
	abstract = {Let \${\textbackslash}mathcal\{P\}\$ be a simple, stationary point process on \${\textbackslash}mathbb\{R\}{\textasciicircum}\{d\}\$ having fast decay of correlations, that is, its correlation functions factorize up to an additive error decaying faster than any power of the separation distance. Let \${\textbackslash}mathcal\{P\}\_\{n\}:={\textbackslash}mathcal\{P\}{\textbackslash}cap W\_\{n\}\$ be its restriction to windows \$W\_\{n\}:=[-\{{\textbackslash}frac\{1\}\{2\}\}n{\textasciicircum}\{1/d\},\{{\textbackslash}frac\{1\}\{2\}\}n{\textasciicircum}\{1/d\}]{\textasciicircum}\{d\}{\textbackslash}subset{\textbackslash}mathbb\{R\}{\textasciicircum}\{d\}\$. We consider the statistic \$H\_\{n\}{\textasciicircum}\{{\textbackslash}xi\}:={\textbackslash}sum\_\{x{\textbackslash}in{\textbackslash}mathcal\{P\}\_\{n\}\}{\textbackslash}xi(x,{\textbackslash}mathcal\{P\}\_\{n\})\$ where \${\textbackslash}xi(x,{\textbackslash}mathcal\{P\}\_\{n\})\$ denotes a score function representing the interaction of \$x\$ with respect to \${\textbackslash}mathcal\{P\}\_\{n\}\$. When \${\textbackslash}xi\$ depends on local data in the sense that its radius of stabilization has an exponential tail, we establish expectation asymptotics, variance asymptotics and central limit theorems for \$H\_\{n\}{\textasciicircum}\{{\textbackslash}xi\}\$ and, more generally, for statistics of the re-scaled, possibly signed, \${\textbackslash}xi\$-weighted point measures \${\textbackslash}mu\_\{n\}{\textasciicircum}\{{\textbackslash}xi\}:={\textbackslash}sum\_\{x{\textbackslash}in{\textbackslash}mathcal\{P\}\_\{n\}\}{\textbackslash}xi(x,{\textbackslash}mathcal\{P\}\_\{n\}){\textbackslash}delta\_\{n{\textasciicircum}\{-1/d\}x\}\$, as \$W\_\{n\}{\textbackslash}uparrow{\textbackslash}mathbb\{R\}{\textasciicircum}\{d\}\$. This gives the limit theory for nonlinear geometric statistics (such as clique counts, the number of Morse critical points, intrinsic volumes of the Boolean model and total edge length of the \$k\$-nearest neighbors graph) of \${\textbackslash}alpha\$-determinantal point processes (for \$-1/{\textbackslash}alpha{\textbackslash}in{\textbackslash}mathbb\{N\}\$) having fast decreasing kernels, including the \${\textbackslash}beta\$-Ginibre ensembles, extending the Gaussian fluctuation results of Soshnikov [Ann. Probab. 30 (2002) 171–187] to nonlinear statistics. It also gives the limit theory for geometric \$U\$-statistics of \${\textbackslash}alpha\$-permanental point processes (for \$1/{\textbackslash}alpha{\textbackslash}in{\textbackslash}mathbb\{N\}\$) as well as the zero set of Gaussian entire functions, extending the central limit theorems of Nazarov and Sodin [Comm. Math. Phys. 310 (2012) 75–98] and Shirai and Takahashi [J. Funct. Anal. 205 (2003) 414–463], which are also confined to linear statistics. The proof of the central limit theorem relies on a factorial moment expansion originating in [Stochastic Process. Appl. 56 (1995) 321–335; Statist. Probab. Lett. 36 (1997) 299–306] to show the fast decay of the correlations of \${\textbackslash}xi\$-weighted point measures. The latter property is shown to imply a condition equivalent to Brillinger mixing, and consequently yields the asymptotic normality of \${\textbackslash}mu\_\{n\}{\textasciicircum}\{{\textbackslash}xi\}\$ via an extension of the cumulant method.},
	number = {2},
	urldate = {2023-02-22},
	journal = {The Annals of Probability},
	author = {Błaszczyszyn, B. and Yogeshwaran, D. and Yukich, J. E.},
	month = mar,
	year = {2019},
	note = {Publisher: Institute of Mathematical Statistics},
	keywords = {60D05, \$U\$-statistics, 05C80, 52A22, 60F05, 60G55, Brillinger mixing, central limit theorem, Cumulants, determinantal point process, difference operators, Gaussian entire functions, Gibbs’ point process, permanental point process, Point processes having fast decay of correlations, stabilization},
	pages = {835--895},
	file = {Full Text PDF:C\:\\Users\\songa\\Zotero\\storage\\5GIM9NLP\\Błaszczyszyn et al. - 2019 - Limit theory for geometric statistics of point pro.pdf:application/pdf},
}

