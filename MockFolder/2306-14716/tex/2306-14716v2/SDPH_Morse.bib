@article{naiman_abstract_1997,
	title = {Abstract tubes, improved inclusion-exclusion identities and inequalities and importance sampling},
	volume = {25},
	issn = {0090-5364, 2168-8966},
	url = {https://projecteuclid.org/journals/annals-of-statistics/volume-25/issue-5/Abstract-tubes-improved-inclusion-exclusion-identities-and-inequalities-and-importance/10.1214/aos/1069362380.full},
	doi = {10.1214/aos/1069362380},
	abstract = {Numerous statistical applications require the evaluation of the probability content of a convex polyhedron. We demonstrate for a given polyhedron in \$R{\textasciicircum}d\$ that there is a depth d inclusion-exclusion identity for its indicator function, which is a linear combination of indicator functions of intersections of at most d half-spaces. Terms in the identity are determined by the incidence of the facets of the polyhedron, which can be found using linear programming. This identity can be truncated at any depth to give a lower or upper bound. In addition, the resulting inequalities lead to importance sampling schemes for evaluating the probability content, and these methods tend to be more efficient than the naive hit-or-miss Monte Carlo method. These results arise in a more general setting which we introduce. An abstract tube consists of a pair \$({\textbackslash}mathsf\{A\}, {\textbackslash}mathsf\{S\})\$ where \${\textbackslash}mathsf\{A\} = \{A\_1, {\textbackslash}dots, A\_n\}\$ is a collection of sets, \${\textbackslash}mathsf\{S\}\$ is a simplicial complex, and where each subcomplex \${\textbackslash}mathsf\{S\}(x) = \{F {\textbackslash}epsilon {\textbackslash}mathsf\{S\}: x {\textbackslash}epsilon {\textbackslash}bigcap\_\{i {\textbackslash}epsilon F\} A\_i\}\$ is contractible whenever \$x {\textbackslash}epsilon {\textbackslash}bigcup\_\{i=1\}{\textasciicircum}n A\_i\$. The notion presented here is stronger than the one introduced earlier by Naiman and Wynn. Several examples are given and key consequences are demonstrated. In particular, arrangements of points and half-spaces in \$R{\textasciicircum}d\$ give rise to abstract tubes via Voronoi decompositions and their associated Delauney dual complexes. Every abstract tube is shown to give rise to an inclusion-exclusion identity for \$I\_\{{\textbackslash}bigcup\_\{i=1\}{\textasciicircum}n A\_i\}\$, and upper and lower bounds are obtained by truncating the identity at an even or an odd depth. This property is analogous to the truncation inequality property of the classical inclusion-exclusion identity, which may be viewed as a special case. The notion of an abstract subtube is introduced, and it is shown that if \$({\textbackslash}mathsf\{A\}, {\textbackslash}mathsf\{S\}\_1)\$ is a subtube of \$({\textbackslash}mathsf\{A\}, {\textbackslash}mathsf\{S\}\_2)\$ then the truncation inequality gotten from the depth m truncation for \$({\textbackslash}mathsf\{A\}, {\textbackslash}mathsf\{S\}\_1)\$ is at least as sharp as the corresponding inequality from \$({\textbackslash}mathsf\{A\}, {\textbackslash}mathsf\{S\}\_2)\$. As a consequence, the generalized inclusion-exclusion inequalities are always at least as sharp as their classical counterparts.},
	number = {5},
	urldate = {2022-08-22},
	journal = {The Annals of Statistics},
	author = {Naiman, Daniel Q. and Wynn, Henry P.},
	month = oct,
	year = {1997},
	note = {Publisher: Institute of Mathematical Statistics},
