@article{DambrineKateb,
	abstract = {We consider a two-phase problem in thermal conductivity: inclusions filled with a material of conductivity σ1 are layered in a body of conductivity σ2. We address the shape sensitivity of the first eigenvalue associated with Dirichlet boundary conditions when both the boundaries of the inclusions and the body can be modified. We prove a differentiability result and provide the expressions of the first and second order derivatives. We apply the results to the optimal design of an insulated body. We prove the stability of the optimal design thanks to a second order analysis. We also continue the study of an extremal eigenvalue problem for a two-phase conductor in a ball initiated by Conca et al. (Appl. Math. Optim. 60(2):173--184, 2009) and pursued in Conca et al. (CANUM 2008, ESAIM Proc., vol. 27, pp.  311--321, EDP Sci., Les Ulis, 2009).},
	author = {Dambrine, M. and Kateb, D.},
	date = {2011/02/01},
	date-added = {2021-12-06 15:03:46 +0100},
	date-modified = {2021-12-06 15:03:51 +0100},
	doi = {10.1007/s00245-010-9111-z},
	id = {Dambrine2011},
	isbn = {1432-0606},
	journal = {Applied Mathematics \& Optimization},
	number = {1},
	pages = {45--74},
	title = {On the Shape Sensitivity of the First Dirichlet Eigenvalue for Two-Phase Problems},
	url = {https://doi.org/10.1007/s00245-010-9111-z},
	volume = {63},
	year = {2011},
	bdsk-url-1 = {https://doi.org/10.1007/s00245-010-9111-z}}

