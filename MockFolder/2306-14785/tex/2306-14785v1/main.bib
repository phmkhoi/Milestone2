@book{christensenCompetingLuck2016,
  title = {Competing {{Against Luck}}},
  author = {Christensen, Clayton M. and Hall, Taddy and Dillon, Karen and Duncan, David S.},
  year = {2016},
  month = oct,
  publisher = {{Harper Business}},
  abstract = {The foremost authority on innovation and growth presents a path-breaking book every company needs to transform innovation from a game of chance to one in which they develop products and services that customers want to buy and are willing to purchase at a premium price. {$<$}br/{$>$} How do companies know how to grow? How can they create products that they are sure customers want to buy? Can innovation be more than a game of hit and miss? Harvard Business School professor Clayton Christensen has the answer. A generation ago, Christensen revolutionized business with his groundbreaking theory of disruptive innovation. Now, he goes further, offering powerful new insights. {$<$}br/{$>$} After years of research, Christensen and his co-authors have come to one critical conclusion: our long held maxim\textemdash that understanding the customer is the crux of innovation\textemdash is wrong. Customers don't buy products or services; they "hire" them to do a job. Understanding customers does not drive innovation success, he argues. Understanding customer jobs does. The "Jobs-to-Be-Done" approach can be seen in some of the world's most respected companies and fast-growing startups, including Amazon, Intuit, Uber, Airbnb, and Chobani yogurt, to name just a few. But this book is not about celebrating these successes\textemdash it's about predicting new ones. {$<$}br/{$>$} The authors contend that by understanding what causes customers to "hire" a product or service, any business can improve its innovation track record, creating products that customers not only want to hire, but that they'll pay premium prices to bring into their lives. Jobs theory offers new hope for growth to companies frustrated by their hit and miss efforts. {$<$}br/{$>$} This book carefully lays down the authors' provocative framework, providing a comprehensive explanation of the theory and why it is predictive, how to use it in the real world and, most importantly, how not to squander the insights it provides.},
  langid = {american},
  file = {C\:\\Users\\dalyg\\Zotero\\storage\\UGJGYEGX\\item.html}
}

@article{christensenCustomerPowerStrategic1996,
  title = {Customer {{Power}}, {{Strategic Investment}}, and the {{Failure}} of {{Leading Firms}}},
  author = {Christensen, Clayton M. and Bower, Joseph L.},
  year = {1996},
  journal = {Strategic Management Journal},
  volume = {17},
  number = {3},
  pages = {197--218},
  publisher = {{Wiley}},
  issn = {0143-2095},
  abstract = {Why might firms be regarded as astutely managed at one point, yet subsequently lose their positions of industry leadership when faced with technological change? We present a model, grounded in a study of the world disk drive industry, that charts the process through which the demands of a firm's customers shape the allocation of resources in technological innovation-a model that links theories of resource dependence and resource allocation. We show that established firms led the industry in developing technologies of every sort-even radical ones-whenever the technologies addressed existing customers' needs. The same firms failed to develop simpler technologies that initially were only useful in emerging markets, because impetus coalesces behind, and resources are allocated to, programs targeting powerful customers. Projects targeted at technologies for which no customers yet exist languish for lack of impetus and resources. Because the rate of technical progress can exceed the performance demanded in a market, technologies which initially can only be used in emerging markets later can invade mainstream ones, carrying entrant firms to victory over established companies.},
  file = {C\:\\Users\\dalyg\\Zotero\\storage\\D2ZQVK7F\\Christensen and Bower - 1996 - Customer Power, Strategic Investment, and the Fail.pdf}
}

