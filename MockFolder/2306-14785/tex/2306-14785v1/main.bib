@article{kimFastAnalysisFilm2017,
  title = {Fast {{Analysis}} of {{Film Thickness}} in {{Spectroscopic Reflectometry}} Using {{Direct Phase Extraction}}},
  author = {Kim, Kwangrak and Kwon, Soonyang and Pahk, Heui Jae and Pahk, Heui Jae},
  year = {2017},
