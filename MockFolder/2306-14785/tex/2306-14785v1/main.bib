@article{lewisDeeplearningenabledBayesianInference2021,
  title = {Deep-Learning-Enabled {{Bayesian}} Inference of Fuel Magnetization in Magnetized Liner Inertial Fusion},
  author = {Lewis, William E. and Knapp, Patrick F. and Slutz, Stephen A. and Schmit, Paul F. and Chandler, Gordon A. and Gomez, Matthew R. and {Harvey-Thompson}, Adam J. and Mangan, Michael A. and Ampleford, David J. and Beckwith, Kristian},
  year = {2021},
  month = sep,
  journal = {Physics of Plasmas},
  volume = {28},
  number = {9},
  pages = {092701},
  publisher = {{American Institute of Physics}},
  issn = {1070-664X},
  doi = {10.1063/5.0056749},
  abstract = {Fuel magnetization in magneto-inertial fusion (MIF) experiments improves charged burn product confinement, reducing requirements on fuel areal density and pressure to achieve self-heating. By elongating the path length of 1.01\,MeV tritons produced in a pure deuterium fusion plasma, magnetization enhances the probability for deuterium\textendash tritium reactions producing  11.8-17.1 11.8-17.1 \,MeV neutrons. Nuclear diagnostics thus enable a sensitive probe of magnetization. Characterization of magnetization, including uncertainty quantification, is crucial for understanding the physics governing target performance in MIF platforms, such as magnetized liner inertial fusion (MagLIF) experiments conducted at Sandia National Laboratories, Z-facility. We demonstrate a deep-learned surrogate of a physics-based model of nuclear measurements. A single model evaluation is reduced from  {$\mathscr{O}$}(10\textendash 100) O(10\textendash 100)  CPU hours on a high-performance computing cluster down to  {$\mathscr{O}$}(10) O(10)  ms on a laptop. This enables a Bayesian inference of magnetization, rigorously accounting for uncertainties from surrogate modeling and noisy nuclear measurements. The approach is validated by testing on synthetic data and comparing with a previous study. We analyze a series of MagLIF experiments systematically varying preheat, resulting in the first ever systematic experimental study of magnetic confinement properties of the fuel plasma as a function of fundamental inputs on any neutron-producing MIF platform. We demonstrate that magnetization decreases from  {$\mathsl{B}\mathsl{R}\sim$}0.5 BR{$\sim$}0.5  to  {$\mathsl{B}\mathsl{R}\sim$}0.2 BR{$\sim$}0.2  MG cm as laser preheat energy deposited increases from  {$\mathsl{E}$} preheat {$\sim$}460 Epreheat{$\sim$}460  J to  {$\mathsl{E}$} preheat {$\sim$}1.4 Epreheat{$\sim$}1.4 \,kJ. This trend is consistent with 2D LASNEX simulations showing Nernst advection of the magnetic field out of the hot fuel and diffusion into the target liner.},
  file = {C\:\\Users\\dalyg\\Zotero\\storage\\WBCK2D5U\\Lewis et al. - 2021 - Deep-learning-enabled Bayesian inference of fuel m.pdf}
}

@article{lillicrapContinuousControlDeep2015,
