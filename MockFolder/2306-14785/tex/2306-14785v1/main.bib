@article{hangCascadedRecurrentNeural2019,
  title = {Cascaded {{Recurrent Neural Networks}} for {{Hyperspectral Image Classification}}},
  author = {Hang, R. and Liu, Q. and Hong, D. and Ghamisi, P.},
  year = {2019},
  journal = {IEEE Transactions on Geoscience and Remote Sensing},
  pages = {1--11},
  issn = {0196-2892},
  doi = {10.1109/TGRS.2019.2899129},
  abstract = {By considering the spectral signature as a sequence, recurrent neural networks (RNNs) have been successfully used to learn discriminative features from hyperspectral images (HSIs) recently. However, most of these models only input the whole spectral bands into RNNs directly, which may not fully explore the specific properties of HSIs. In this paper, we propose a cascaded RNN model using gated recurrent units to explore the redundant and complementary information of HSIs. It mainly consists of two RNN layers. The first RNN layer is used to eliminate redundant information between adjacent spectral bands, while the second RNN layer aims to learn the complementary information from nonadjacent spectral bands. To improve the discriminative ability of the learned features, we design two strategies for the proposed model. Besides, considering the rich spatial information contained in HSIs, we further extend the proposed model to its spectral-spatial counterpart by incorporating some convolutional layers. To test the effectiveness of our proposed models, we conduct experiments on two widely used HSIs. The experimental results show that our proposed models can achieve better results than the compared models.},
  keywords = {Deep learning,Feature extraction,Gated recurrent unit (GRU),hyperspectral image (HSI) classification,Hyperspectral imaging,Logic gates,recurrent neural network (RNN),Recurrent neural networks,spectral feature,spectral-spatial feature.,Training},
  file = {C\:\\Users\\dalyg\\Zotero\\storage\\L56LE323\\Hang et al. - 2019 - Cascaded Recurrent Neural Networks for Hyperspectr.pdf;C\:\\Users\\dalyg\\Zotero\\storage\\DCH2XWHS\\8662780.html}
}

