@article{kimProductivityOrientedWaferMap2019,
  title = {A {{Productivity-Oriented Wafer Map Optimization Using Yield Model Based}} on {{Machine Learning}}},
  author = {Kim, J. and Jang, S. and Kim, T. and Lee, H. and Lee, J.},
  year = {2019},
  month = feb,
  journal = {IEEE Transactions on Semiconductor Manufacturing},
  volume = {32},
  number = {1},
  pages = {39--47},
  issn = {0894-6507},
  doi = {10.1109/TSM.2018.2870253},
  abstract = {In order to maintain a competitive edge in the face of increasing global competition in the semiconductor memory market, device makers in the IC memory industry need to continuously improve their productivity by implementing novel manufacturing strategies that are applicable to the rapid market changes characteristic of the industry. Conventional wafer productivity strategies typically only focus on maximizing gross die out, a strategy which does not address wafer productivity for profitability, i.e., return on investment (ROI), with respect to current market situations, since ROI is significantly influenced not only by the number of gross die out, but also by other factors both within the manufacturing line, for example by the number of photolithography shots per wafer, and also by external factors, most importantly the market price of the memory devices being produced. In this paper, we propose a novel productivity model based on ROI and use the ROI-based model to evaluate wafer maps and thereby to determine optimal chip sizes for maximizing fab productivity. To evaluate wafer productivity accurately, we predicted yields from various wafer map configurations using deep neural networks, and, to search for productivity-maximal wafer maps in extremely large search spaces, we adopted differential evolution as the optimization technique. Comparison results have demonstrated that our proposed method effectively improved wafer productivity by up to 7.96\%, in contrast with the old method. By incorporating these market-oriented indicators into standard yield models, we offer a new way for memory device manufacturers to maximize productivity and maintain competitive advantage for their semiconductor fabrication lines.},
  keywords = {cost-benefit analysis,deep neural networks,differential evolution,evolutionary computation,fab productivity,Fabrication,IC memory industry,integrated circuit manufacture,investment,learning (artificial intelligence),Lithography,machine learning,market price,memory device manufacturers,neural nets,optimisation,Optimization,photolithography,pricing,production engineering computing,productivity,Productivity,productivity-oriented wafer map optimization,profitability,profitability enhancements,ROI-based model,semiconductor device manufacture,Semiconductor device modeling,semiconductor industry,semiconductor memory market,Throughput,wafer manufacturing strategy,Wafer map optimization,wafer productivity,wafer productivity strategies,yield model,yield modeling},
  file = {C\:\\Users\\dalyg\\Zotero\\storage\\FLAS4B4K\\Kim et al. - 2019 - A Productivity-Oriented Wafer Map Optimization Usi.pdf;C\:\\Users\\dalyg\\Zotero\\storage\\IJ8CSPXK\\8464294.html}
