  author = {Rodimkov, Yury and Bhadoria, Shikha and Volokitin, Valentin and Efimenko, Evgeny and Polovinkin, Alexey and Blackburn, Thomas and Marklund, Mattias and Gonoskov, Arkady and Meyerov, Iosif},
