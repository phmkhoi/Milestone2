@article{mevawallaNeuralNetworkModeling2011,
  title = {Neural {{Network Modeling}} for {{Advanced Process Control Using Production Data}}},
  author = {Mevawalla, Z. N. and May, G. S. and Kiehlbauch, M. W.},
