  title = {Extreme Learning Machines for Virtual Metrology and Etch Rate Prediction},
  booktitle = {2015 26th {{Irish Signals}} and {{Systems Conference}} ({{ISSC}})},
  author = {Puggini, L. and McLoone, S.},
  year = {2015},
  month = jun,
  pages = {1--6},
  doi = {10.1109/ISSC.2015.7163771},
  abstract = {Virtual metrology (VM) aims to predict metrology values using sensor data from production equipment and physical metrology values of preceding samples. VM is a promising technology for the semiconductor manufacturing industry as it can reduce the frequency of in-line metrology operations and provide supportive information for other operations such as fault detection, predictive maintenance and run-to-run control. Methods with minimal user intervention are required to perform VM in a real-time industrial process. In this paper we propose extreme learning machines (ELM) as a competitive alternative to popular methods like lasso and ridge regression for developing VM models. In addition, we propose a new way to choose the hidden layer weights of ELMs that leads to an improvement in its prediction performance.},
