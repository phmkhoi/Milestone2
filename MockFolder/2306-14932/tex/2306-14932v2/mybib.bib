@article{maiExploitingConstantTrace2022,
  title    = {Exploiting {{Constant Trace Property}} in {{Large-scale Polynomial Optimization}}},
  author   = {Mai, Ngoc Hoang Anh and Lasserre, J. B. and Magron, Victor and Wang, Jie},
  year     = {2022},
  month    = dec,
  journal  = {ACM Transactions on Mathematical Software},
  volume   = {48},
  number   = {4},
  pages    = {40:1--40:39},
  urldate  = {2023-04-26},
  abstract = {We prove that every semidefinite moment relaxation of a polynomial optimization problem (POP) with a ball constraint can be reformulated as a semidefinite program involving a matrix with constant trace property (CTP). As a result, such moment relaxations can be solved efficiently by first-order methods that exploit CTP, e.g., the conditional gradient-based augmented Lagrangian method. We also extend this CTP-exploiting framework to large-scale POPs with different sparsity structures. The efficiency and scalability of our framework are illustrated on some moment relaxations for various randomly generated POPs, especially second-order moment relaxations for quadratically constrained quadratic programs.},
  keywords = {conditional gradient-based augmented Lagrangian,constant trace property,moment-SOS hierarchy,Polynomial optimization}
}

@article{wakiSumsSquaresSemidefinite2006,
  title     = {Sums of {{Squares}} and {{Semidefinite Program Relaxations}} for {{Polynomial Optimization Problems}} with {{Structured Sparsity}}},
  author    = {Waki, Hayato and Kim, Sunyoung and Kojima, Masakazu and Muramatsu, Masakazu},
  year      = {2006},
  month     = jan,
  journal   = {SIAM Journal on Optimization},
  volume    = {17},
  number    = {1},
  pages     = {218--242},
  publisher = {{Society for Industrial and Applied Mathematics}},
  doi       = {10.1137/050623802},
  urldate   = {2023-04-25},
  abstract  = {Sequences of generalized Lagrangian duals and their sums of squares (SOS) of polynomials relaxations for a polynomial optimization problem (POP) are introduced. The sparsity of polynomials in the POP is used to reduce the sizes of the Lagrangian duals and their SOS relaxations. It is proved that the optimal values of the Lagrangian duals in the sequence converge to the optimal value of the POP using a method from the penalty function approach. The sequence of SOS relaxations is transformed into a sequence of semidefinite programing (SDP) relaxations of the POP, which correspond to duals of modification and generalization of SDP relaxations given by Lasserre for the POP.}
}

@article{wangTSSOSMomentSOSHierarchy2021,
  title      = {{{TSSOS}}: {{A Moment-SOS Hierarchy That Exploits Term Sparsity}}},
  shorttitle = {{{TSSOS}}},
  author     = {Wang, Jie and Magron, Victor and Lasserre, Jean-Bernard},
  year       = {2021},
  month      = jan,
  journal    = {SIAM Journal on Optimization},
  volume     = {31},
  number     = {1},
  pages      = {30--58},
  publisher  = {{Society for Industrial and Applied Mathematics}},
  doi        = {10.1137/19M1307871},
  urldate    = {2023-04-14},
  abstract   = {Consider a finite system of nonstrict real polynomial inequalities and suppose its solution set \$S\textbackslash subseteq\textbackslash mathbb R\^n\$ is convex, has nonempty interior, and is compact. Suppose that the system satisfies the Archimedean condition, which is slightly stronger than the compactness of \$S\$. Suppose that each defining polynomial satisfies a second order strict quasiconcavity condition where it vanishes on \$S\$ (which is very natural because of the convexity of \$S\$) or its Hessian has a certain matrix sums of squares certificate for negative-semidefiniteness on \$S\$ (fulfilled trivially by linear polynomials). Then we show that the system possesses an exact Lasserre relaxation. In their seminal work of 2009, Helton and Nie showed under the same conditions that \$S\$ is the projection of a spectrahedron, i.e., it has a semidefinite representation. The semidefinite representation used by Helton and Nie arises from glueing together Lasserre relaxations of many small pieces obtained in a nonconstructive way. By refining and varying their approach, we show that we can simply take a Lasserre relaxation of the original system itself. Such a result was provided by Helton and Nie with much more machinery only under very technical conditions and after changing the description of \$S\$.}
}

@article{wangChordalTSSOSMomentSOSHierarchy2021,
  title      = {Chordal-{{TSSOS}}: {{A Moment-SOS Hierarchy That Exploits Term Sparsity}} with {{Chordal Extension}}},
  shorttitle = {Chordal-{{TSSOS}}},
  author     = {Wang, Jie and Magron, Victor and Lasserre, Jean-Bernard},
  year       = {2021},
  month      = jan,
  journal    = {SIAM Journal on Optimization},
  volume     = {31},
  number     = {1},
  pages      = {114--141},
  publisher  = {{Society for Industrial and Applied Mathematics}},
  doi        = {10.1137/20M1323564},
  urldate    = {2023-04-14},
  abstract   = {Given a compact semialgebraic set \$\textbackslash mathbf\{S\} \textbackslash subset \textbackslash mathbb\{R\}\^n\$ and a polynomial map \$\textbackslash mathbf\{f\} : \textbackslash mathbb\{R\}\^n \textbackslash to \textbackslash mathbb\{R\}\^m\$, we consider the problem of approximating the image set \$\textbackslash mathbf\{F\}=\textbackslash mathbf\{f\}(\textbackslash mathbf\{S\}) \textbackslash subset \textbackslash mathbb\{R\}\^m\$. This includes in particular the projection of \$\textbackslash mathbf\{S\}\$ on \$\textbackslash mathbb\{R\}\^m\$ for \$n \textbackslash geq m\$. Assuming that \$\textbackslash mathbf\{F\} \textbackslash subset \textbackslash mathbf\{B\}\$, with \$\textbackslash mathbf\{B\} \textbackslash subset \textbackslash mathbb\{R\}\^m\$ being a ``simple'' set (e.g., a box or a ball), we provide two methods to compute certified outer approximations of \$\textbackslash mathbf\{F\}\$. Method 1 exploits the fact that  \$\textbackslash mathbf\{F\}\$ can be defined with an existential quantifier, while Method 2 computes approximations of the support of image measures. The two methods output a sequence of superlevel sets defined with a single polynomial that yield explicit outer approximations of \$\textbackslash mathbf\{F\}\$. Finding the coefficients of this polynomial boils down to computing an optimal solution of a convex semidefinite program. We provide guarantees of strong convergence to \$\textbackslash mathbf\{F\}\$ in \$L\_1\$ norm on \$\textbackslash mathbf\{B\}\$, when the degree of the polynomial approximation tends to infinity. Several examples of applications are provided, together with numerical experiments.}
}

@article{wangExploitingSparsityComplex2022,
  title    = {Exploiting {{Sparsity}} in {{Complex Polynomial Optimization}}},
  author   = {Wang, Jie and Magron, Victor},
  year     = {2022},
  month    = jan,
  journal  = {Journal of Optimization Theory and Applications},
  volume   = {192},
  number   = {1},
  pages    = {335--359},
  urldate  = {2023-04-14},
  abstract = {In this paper, we study the sparsity-adapted complex moment-Hermitian sum of squares (moment-HSOS) hierarchy for complex polynomial optimization problems, where the sparsity includes correlative sparsity and term sparsity. We compare the strengths of the sparsity-adapted complex moment-HSOS hierarchy with the sparsity-adapted real moment-SOS hierarchy on either randomly generated complex polynomial optimization problems or the AC optimal power flow problem. The results of numerical experiments show that the sparsity-adapted complex moment-HSOS hierarchy provides a trade-off between the computational cost and the quality of obtained bounds for large-scale complex polynomial optimization problems.},
  langid   = {english},
  keywords = {12D15,14P10,90C22,90C23,90C26,Complex moment-HSOS hierarchy,Complex polynomial optimization,Correlative sparsity,Optimal power flow,Term sparsity}
}

@article{joszLasserreHierarchyLarge2018a,
  title    = {Lasserre {{Hierarchy}} for {{Large Scale Polynomial Optimization}} in {{Real}} and {{Complex Variables}}},
  author   = {Josz, C{\'e}dric and Molzahn, Daniel K.},
  year     = {2018},
  month    = jan,
  journal  = {SIAM Journal on Optimization},
  volume   = {28},
  number   = {2},
  pages    = {1017--1048},
  urldate  = {2023-03-09},
  abstract = {We propose general notions to deal with large scale polynomial optimization problems and demonstrate their efficiency on a key industrial problem of the 21st century, namely the optimal power flow problem. These notions enable us to find global minimizers on instances with up to 4,500 variables and 14,500 constraints. First, we generalize the Lasserre hierarchy from real to complex numbers in order to enhance its tractability when dealing with complex polynomial optimization. Complex numbers are typically used to represent oscillatory phenomena, which are omnipresent in physical systems. Using the notion of hyponormality in operator theory, we provide a finite convergence criterion which generalizes the Curto\textendash Fialkow conditions of the real Lasserre hierarchy. Second, we introduce the multi-ordered Lasserre hierarchy in order to exploit sparsity in polynomial optimization problems (in real or complex variables) while preserving global convergence. It is based on two ideas: (1) to use a different relaxation order for each constraint, and (2) to iteratively seek a closest measure to the truncated moment data until a measure matches the truncated data. Third and last, we exhibit a block diagonal structure of the Lasserre hierarchy in the presence of commonly encountered symmetries. To the best of our knowledge, the Lasserre hierarchy was previously limited to small scale problems, while we solve a large scale industrial problem with thousands of variables and constraints to global optimality.},
  langid   = {english}
}


