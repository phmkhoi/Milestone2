@article{devroyeSubGaussianMeanEstimators2016,
  title      = {Sub-{{Gaussian Mean Estimators}}},
  author     = {Devroye, Luc and Lerasle, Matthieu and Lugosi, Gabor and Oliveira, Roberto I.},
  year       = {2016},
